// Fluent 2 tokens (neutral palette, type ramp, spacing). Light and dark
// follow the Windows app theme through Palette.color-scheme.
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Fonts are picked at startup (Windows 11 vs 10) by the Rust side.
    in property <string> text-font: "Segoe UI";
    in property <string> icon-font: "Segoe MDL2 Assets";

    // Surfaces
    out property <color> layer: dark ? #202020 : #f3f3f3;          // window / nav pane
    out property <color> card: dark ? #2b2b2b : #ffffff;           // list + reader
    out property <color> stroke: dark ? #3b3b3b : #e5e5e5;
    out property <color> stroke-strong: dark ? #4a4a4a : #d1d1d1;
    out property <color> hover: dark ? #ffffff0f : #0000000a;
    out property <color> pressed: dark ? #ffffff0a : #00000006;
    out property <color> selected: dark ? #ffffff14 : #0000000f;
    out property <color> row-selected: dark ? #2f3b4a : #e3eefb;
    out property <color> scrim: #00000066;

    // Text
    out property <color> text: dark ? #ffffff : #242424;
    out property <color> text-2: dark ? #c8c8c8 : #424242;
    out property <color> text-3: dark ? #9e9e9e : #707070;
    out property <color> text-disabled: dark ? #6e6e6e : #bdbdbd;

    // Brand / status
    // System accent (Windows settings), as Fluent apps do.
    out property <color> accent: Palette.accent-background;
    out property <color> on-accent: Palette.accent-foreground;
    out property <color> accent-text: Palette.accent-background;
    out property <color> danger: dark ? #dc626d : #c50f1f;
    out property <color> danger-bg: dark ? #3f1011 : #fdf3f4;
    out property <color> info-bg: dark ? #333333 : #ffffff;

    // Type ramp (Fluent 2)
    out property <length> caption: 12px;
    out property <length> body: 14px;
    out property <length> subtitle: 16px;
    out property <length> title: 20px;

    // Spacing (4px grid) and radii
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s6: 24px;
    out property <length> radius: 4px;
    out property <length> radius-lg: 8px;
}

// Segoe Fluent Icons / Segoe MDL2 Assets code points (shared by both fonts).
export global Icons {
    out property <string> mail: "\u{E715}";
    out property <string> read: "\u{E8C3}";
    out property <string> compose: "\u{E70F}";
    out property <string> send: "\u{E724}";
    out property <string> drafts: "\u{E70B}";
    out property <string> archive: "\u{E7B8}";
    out property <string> delete: "\u{E74D}";
    out property <string> junk: "\u{E8C9}";
    out property <string> folder: "\u{E8B7}";
    out property <string> inboxes: "\u{E8F1}";
    out property <string> refresh: "\u{E72C}";
    out property <string> search: "\u{E721}";
    out property <string> reply: "\u{E97A}";
    out property <string> reply-all: "\u{E8C2}";
    out property <string> forward: "\u{E72A}";
    out property <string> attach: "\u{E723}";
    out property <string> flag: "\u{E7C1}";
    out property <string> flag-filled: "\u{EB4B}";
    out property <string> settings: "\u{E713}";
    out property <string> add: "\u{E710}";
    out property <string> dismiss: "\u{E711}";
    out property <string> chevron-down: "\u{E70D}";
    out property <string> chevron-right: "\u{E76C}";
    out property <string> save: "\u{E74E}";
    out property <string> move: "\u{E8DE}";
    out property <string> person: "\u{E77B}";
    out property <string> error: "\u{E783}";
    out property <string> info: "\u{E946}";
}
