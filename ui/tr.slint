    // ---- Settings > Rules (src/app/rules.rs): a rule's summary, one
    // sentence per condition (field 0 From, 1 To or Cc, 2 Subject, 3 Has
    // attachment; op 0 contains, 1 does not contain, 2 is, 3 starts with,
    // 4 ends with) and per action, joined by middle dots.
    pure public function rule-cond(field: int, op: int, value: string) -> string {
        if field == 3 { return @tr("Has an attachment"); }
        if field == 0 && op == 0 { return @tr("From contains {0}", value); }
        if field == 0 && op == 1 { return @tr("From does not contain {0}", value); }
        if field == 0 && op == 2 { return @tr("From is {0}", value); }
        if field == 0 && op == 3 { return @tr("From starts with {0}", value); }
        if field == 0 { return @tr("From ends with {0}", value); }
        if field == 1 && op == 0 { return @tr("To or Cc contains {0}", value); }
        if field == 1 && op == 1 { return @tr("To or Cc does not contain {0}", value); }
        if field == 1 && op == 2 { return @tr("To or Cc is {0}", value); }
        if field == 1 && op == 3 { return @tr("To or Cc starts with {0}", value); }
        if field == 1 { return @tr("To or Cc ends with {0}", value); }
        if op == 0 { return @tr("Subject contains {0}", value); }
        if op == 1 { return @tr("Subject does not contain {0}", value); }
        if op == 2 { return @tr("Subject is {0}", value); }
        if op == 3 { return @tr("Subject starts with {0}", value); }
        return @tr("Subject ends with {0}", value);
    }
    pure public function rule-any() -> string { return @tr("Any of these"); }
    pure public function rule-move(folder: string) -> string { return @tr("Move to {0}", folder); }
    pure public function rule-delete() -> string { return @tr("Delete"); }
    pure public function rule-read() -> string { return @tr("Mark as read"); }
    pure public function rule-flag() -> string { return @tr("Mark as important"); }
    pure public function rule-stop() -> string { return @tr("Stop processing more rules"); }
    pure public function rule-new-name() -> string { return @tr("New rule"); }
    pure public function rule-err-name() -> string { return @tr("Give the rule a name."); }
    pure public function rule-err-value() -> string { return @tr("Each condition needs a value."); }
    pure public function rule-err-action() -> string { return @tr("Choose at least one action."); }
    pure public function rule-err-conds() -> string { return @tr("Add a condition."); }
    // The activity of automatic runs: what was done to which message.
    pure public function rule-log-title(rule: string, when: string) -> string { return @tr("{0}, {1}", rule, when); }
    pure public function rule-log-move(subject: string, from: string, folder: string) -> string {
        return @tr("Moved \u{201c}{0}\u{201d} from {1} to {2}.", subject, from, folder);
    }
    pure public function rule-log-delete(subject: string, from: string) -> string {
        return @tr("Deleted \u{201c}{0}\u{201d} from {1}.", subject, from);
    }
    pure public function rule-log-read(subject: string, from: string) -> string {
        return @tr("Marked \u{201c}{0}\u{201d} from {1} as read.", subject, from);
    }
    pure public function rule-log-flag(subject: string, from: string) -> string {
        return @tr("Marked \u{201c}{0}\u{201d} from {1} as important.", subject, from);
    }
    pure public function rule-log-failed(subject: string, from: string) -> string {
        return @tr("Couldn\u{2019}t act on \u{201c}{0}\u{201d} from {1}. It stayed in the Inbox.", subject, from);
    }
    pure public function q-rule-delete-title(name: string) -> string { return @tr("Delete rule \u{201c}{0}\u{201d}?", name); }
    pure public function q-rule-delete-text() -> string { return @tr("Mail it already moved stays where it is."); }
    pure public function rule-sieve-copied() -> string { return @tr("Copied as a Sieve script. Paste it into your provider\u{2019}s mail filters."); }

    // ---- Titles of the file dialogs
    pure public function dlg-save-attachment() -> string { return @tr("Save attachment"); }
    pure public function dlg-save-invitation() -> string { return @tr("Save invitation"); }
    pure public function dlg-save-message() -> string { return @tr("Save message"); }
    pure public function dlg-attach-files() -> string { return @tr("Attach files"); }
}
