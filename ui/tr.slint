// Text the Rust side shows, kept in the one catalog the .slint files use
// (translations/pt-PT/LC_MESSAGES/komorebi.po): Rust calls these through
// `ui.global::<Tr>()` (src/tr.rs), so every sentence is whole, with its numbers
// and names as placeholders (never glued from pieces; word order and plurals
// differ). Which function a typed value (an error, a validation failure)
// means is decided in src/app/text.rs. Numbers and dates arrive already
// formatted (src/format.rs).
export global Tr {
    // ---- The window and its start
    // The window title: the unread count of the inboxes, if any.
    pure public function window-title(unread: int) -> string {
        return unread > 0 ? @tr("window title" => "Inbox ({0}) - Komorebi", unread) : "Komorebi";
    }
    pure public function start-failed(detail: string) -> string { return @tr("Komorebi couldn't start.\n\n{0}", detail); }
    // ---- Notifications, the tray and the last sync
    pure public function updated-at(time: string) -> string { return @tr("Updated {0}", time); }
    pure public function tray-open() -> string { return @tr("tray menu" => "Open Komorebi"); }
    pure public function tray-check() -> string { return @tr("tray menu" => "Check mail"); }
    pure public function tray-pause() -> string { return @tr("tray menu" => "Pause notifications"); }
    pure public function tray-quit() -> string { return @tr("tray menu" => "Quit"); }
    pure public function tray-tooltip(unread: int) -> string {
        return unread > 0 ? @tr("Komorebi: {n} unread message" | "Komorebi: {n} unread messages" % unread) : "Komorebi";
    }
    pure public function toast-new-mail() -> string { return @tr("New mail"); }
    pure public function toast-new-mail-body() -> string { return @tr("Open Komorebi to read it."); }
    pure public function toast-burst(n: int) -> string { return @tr("{n} new message" | "{n} new messages" % n); }
    pure public function toast-burst-body() -> string { return @tr("Open Komorebi to read them."); }
    pure public function crash-notice() -> string { return @tr("Komorebi closed unexpectedly last time; see crash.log"); }
    pure public function cache-damaged(name: string) -> string {
        return @tr("The mail cache was damaged, so Komorebi started a new one; the old file is kept as {0}. Add your accounts again in Settings.", name);
    }
    pure public function wipe-files-left(list: string) -> string {
        return @tr("The passwords were deleted, but these files are still in use and were not removed. Delete them by hand:\n\n{0}", list);
    }

    // ---- Failures of the servers (mail::errors::Say)
    pure public function say-offline() -> string { return @tr("Can't reach the server. Komorebi tries again by itself; check your internet connection."); }
    pure public function say-auth() -> string { return @tr("The server rejected the sign-in. Update the password in Settings, or press Refresh to retry."); }
    pure public function say-tls() -> string { return @tr("Couldn't make a secure connection to the server. Check the server name in Settings; its certificate may not be trusted."); }
    pure public function say-too-large() -> string { return @tr("The server says this message is too large. Remove an attachment or share it another way."); }
    pure public function say-quota() -> string { return @tr("The mailbox is full on the server. Delete or archive some mail, then try again."); }
    pure public function say-busy() -> string { return @tr("The server is busy or has too many connections open. Komorebi tries again shortly; close other mail apps if this keeps happening."); }
    pure public function say-not-found(host: string) -> string { return @tr("Couldn't find {0}. Check the spelling of the server name and your internet connection.", host); }
    pure public function say-no-answer(host: string, port: string) -> string {
        return @tr("{0} didn't answer on port {1}. SSL/TLS usually uses 993 (IMAP) or 465 (SMTP); STARTTLS uses 143 or 587 (some servers use 25, 2525 or 1143).", host, port);
    }
    pure public function say-lost(host: string) -> string { return @tr("The connection to {0} was lost. Try again, and if it keeps happening, check the server.", host); }
    pure public function say-rejected(host: string, login: string) -> string {
        return @tr("{0} rejected the password for {1}. If sign-in uses two steps, create an app password. If the login isn't your email address, set the username.", host, login);
    }
    // A preset's rejected password (the add form): the app-password advice
    // only, then, for an address on another domain, the other preset.
    pure public function say-rejected-preset(host: string, login: string) -> string {
        return @tr("{0} rejected the password for {1}. If sign-in uses two steps, create an app password.", host, login);
    }
    pure public function say-other-preset(provider: string) -> string { return @tr("Is your mail at {0}? Change Provider.", provider); }
    pure public function say-secure-failed(host: string) -> string {
        return @tr("The secure connection to {0} failed. Its certificate isn't trusted or doesn't match the server name. Check the name, or if you run this server yourself, review its certificate.", host);
    }
    pure public function say-no-connection(host: string, port: string) -> string { return @tr("{0} didn't accept the connection on port {1}. Check the server name and port.", host, port); }
    pure public function say-no-secure(host: string) -> string { return @tr("Couldn't set up a secure connection to {0}. Check the port and the security setting.", host); }
    pure public function say-no-sign-in(host: string, login: string) -> string { return @tr("{0} wouldn't let {1} sign in. Check the username, the password and the server's settings.", host, login); }
    pure public function say-no-folders(host: string) -> string { return @tr("Signed in, but {0} didn't list its folders. Try again, or check the server.", host); }
    pure public function say-no-starttls(host: string) -> string {
        return @tr("{0} doesn't offer STARTTLS, so Komorebi won't sign in (your password would travel unencrypted). Ask the administrator to enable it, or use the SSL/TLS port.", host);
    }
    pure public function say-plain-answer() -> string { return @tr("This port answered without encryption. Komorebi only connects securely; choose STARTTLS or the SSL/TLS port."); }
    pure public function say-no-auth(host: string) -> string { return @tr("{0} doesn't offer sign-in. Komorebi can't send through servers without sign-in yet.", host); }
    pure public function say-bad-greeting(host: string) -> string {
        return @tr("{0} didn't greet Komorebi like an IMAP server (it said goodbye, or signed in by itself). Check the server name, the port and the security setting.", host);
    }
    pure public function say-no-login(host: string) -> string {
        return @tr("{0} doesn't allow signing in with a password over this connection (LOGINDISABLED). Ask the administrator to allow it on secure connections.", host);
    }
    pure public function say-utf8-only(host: string) -> string {
        return @tr("{0} only works in UTF-8 mode (UTF8=ONLY), which Komorebi doesn't support yet. Ask the administrator to also allow the standard mode.", host);
    }
    pure public function say-cert-changed(host: string) -> string {
        return @tr("The certificate of {0} changed. If you didn't expect that, don't sign in: review the new certificate and compare its fingerprint before you trust it.", host);
    }
    // The status line's short form of it (its card in Settings says it all).
    pure public function say-cert-changed-short(host: string) -> string {
        return @tr("The certificate of {0} changed. Review it before you connect again.", host);
    }
    pure public function say-sender-refused(host: string, from: string) -> string {
        return @tr("{0} refused to send as {1}. Check that this account may send from that address, or set the SMTP username.", host, from);
    }
    pure public function say-sign-in-latched() -> string { return @tr("Sign-in rejected. Update the password in Settings, or press Refresh to retry."); }
    pure public function say-unconfirmed(detail: string) -> string {
        return @tr("{0}. The message may or may not have been sent; check Sent before you retry it from the Outbox.", detail);
    }
    pure public function say-too-large-send(detail: string) -> string { return @tr("The server says this message is too large ({0})", detail); }

    // ---- Caveats of actions that worked (mail::Notice)
    pure public function notice-left-flagged() -> string { return @tr("Removed here; the server keeps it flagged as deleted."); }
    pure public function notice-move-gone() -> string { return @tr("Already gone from the server, so there was nothing to move."); }
    pure public function notice-no-drafts-folder() -> string { return @tr("There is no Drafts folder on the server, so drafts are only saved on this PC."); }
    pure public function notice-no-sent-folder() -> string {
        return @tr("This account has no Sent folder on the server, so sent mail isn't saved there. You can choose one in Settings: Accounts, Edit.");
    }
    pure public function notice-no-draft-uid() -> string {
        return @tr("A draft saved to the server couldn't be found there, so drafts are only saved on this PC.");
    }
    pure public function notice-drafts-not-saved(detail: string) -> string { return @tr("Couldn't save drafts to the server ({0}); they are kept on this PC.", detail); }
    // A line about one account: its address, then what to say about it.
    pure public function account-line(email: string, text: string) -> string { return @tr("{0}: {1}", email, text); }

    // ---- Errors with a lead-in; the detail is the failure's own words
    // A failure of the local cache or the system, in its own words.
    pure public function error-detail(detail: string) -> string { return @tr("Something went wrong. {0}", detail); }
    pure public function not-saved(detail: string) -> string { return @tr("Not saved. {0}", detail); }
    pure public function not-removed(detail: string) -> string { return @tr("Not removed. {0}", detail); }
    pure public function not-reset(detail: string) -> string { return @tr("Not reset. {0}", detail); }
    pure public function stopped-no-files(detail: string) -> string { return @tr("Stopped, no files removed. {0}", detail); }
    pure public function could-not-save(detail: string) -> string { return @tr("Couldn't save: {0}", detail); }
    pure public function could-not-save-file(name: string, detail: string) -> string { return @tr("Couldn't save {0}: {1}", name, detail); }
    pure public function could-not-open-file(name: string, detail: string) -> string { return @tr("Couldn't open {0}: {1}", name, detail); }
    pure public function could-not-attach(detail: string) -> string { return @tr("Couldn't attach the files: {0}", detail); }
    pure public function could-not-open-draft(detail: string) -> string { return @tr("Couldn't open the draft: {0}", detail); }
    pure public function could-not-save-draft(detail: string) -> string { return @tr("Couldn't save the draft: {0}", detail); }
    pure public function could-not-send(detail: string) -> string { return @tr("Couldn't send: {0}", detail); }
    pure public function could-not-send-back-in-drafts(detail: string) -> string { return @tr("Couldn't send: {0}. It is back in Drafts.", detail); }
    pure public function could-not-undo(detail: string) -> string { return @tr("Couldn't undo: {0}", detail); }
    pure public function could-not-send-reply(detail: string) -> string { return @tr("Couldn't send the reply: {0}", detail); }
    pure public function could-not-download-status(detail: string) -> string { return @tr("Couldn't download this message: {0}", detail); }
    pure public function could-not-download-body(detail: string) -> string { return @tr("Couldn't download this message.\n\n{0}", detail); }
    pure public function saved-to(path: string) -> string { return @tr("Saved {0}", path); }
    pure public function no-app-opens(name: string) -> string { return @tr("No app on this computer opens {0}.", name); }
    pure public function file-can-run(name: string) -> string { return @tr("{0} can run programs, so Komorebi doesn't open it. Save it to check it first.", name); }

    // ---- The send (mail::Outcome)
    pure public function sent() -> string { return @tr("status" => "Sent"); }
    pure public function sent-not-saved(detail: string) -> string { return @tr("Message sent, but {0}", detail); }
    pure public function not-sent-yet(detail: string) -> string { return @tr("Not sent yet: {0}. It stays in the Outbox and is tried again shortly.", detail); }
    pure public function not-sent(detail: string) -> string { return @tr("Not sent: {0}. It is in the Outbox.", detail); }
    pure public function message-discarded() -> string { return @tr("Message discarded."); }
    pure public function rebuild-failed() -> string {
        return @tr("A message sent as Komorebi closed couldn't be prepared again; it is back in Drafts.");
    }
    pure public function sending-in(secs: int) -> string { return @tr("Sending in {0} s", secs); }
    // The undo-send offer at the bottom of the list, with the subject
    // (shortened) of the message being sent.
    pure public function sending-subject-in(subject: string, secs: int) -> string { return @tr("Sending \u{201c}{0}\u{201d} in {1} s", subject, secs); }
    pure public function sending() -> string { return @tr("Sending\u{a0}…"); }
    // The Outbox row and the open Outbox message: where the message is.
    pure public function outbox-pending() -> string { return @tr("Sending in a few seconds"); }
    pure public function outbox-waiting() -> string { return @tr("Waiting to send"); }
    // A send refused for now: the sentence for its kind, then when the next
    // try is.
    pure public function outbox-retry(sentence: string, time: string) -> string { return @tr("{0} Trying again at {1}.", sentence, time); }
    // Why a send didn't go through, by the SMTP class of the server's reply
    // (the reply itself is behind Details).
    pure public function send-no-such(address: string) -> string { return @tr("{0} doesn't exist. Check the address and send again.", address); }
    pure public function send-no-such-any() -> string { return @tr("One of the addresses doesn't exist. Check the addresses and send again."); }
    pure public function send-bad-address() -> string { return @tr("The server says an address isn't written correctly. Check the addresses and send again."); }
    pure public function send-mailbox-full() -> string { return @tr("The recipient's mailbox is full. Try again later, or reach them another way."); }
    pure public function send-too-large() -> string { return @tr("The message is too large for the server. Remove an attachment, then send again."); }
    pure public function send-sender-refused() -> string { return @tr("The server won't send from this address. Check the account's address and SMTP username in Settings."); }
    pure public function send-policy() -> string { return @tr("The server refused the message under its rules, for example as spam. Change the message, or ask your provider."); }
    pure public function send-sign-in() -> string { return @tr("The server rejected the sign-in. Update the password in Settings, then send again."); }
    pure public function send-certificate() -> string { return @tr("Couldn't make a secure connection to the server. Check the account in Settings, then send again."); }
    pure public function send-busy() -> string { return @tr("The server couldn't take the message right now."); }
    pure public function send-busy-gave-up() -> string { return @tr("The server couldn't take the message, and Komorebi stopped trying. Select Retry to send it again."); }
    pure public function send-unreachable() -> string { return @tr("Couldn't reach the server."); }
    pure public function send-unreachable-gave-up() -> string { return @tr("Couldn't reach the server, and Komorebi stopped trying. Check your internet connection, then select Retry."); }
    pure public function send-other() -> string { return @tr("The server refused the message. Details says why."); }
    pure public function send-unconfirmed() -> string { return @tr("The connection broke while sending, so it may have gone out. Check Sent before you send it again."); }
    pure public function undo-too-late() -> string { return @tr("Too late to undo: the message is being sent."); }
    pure public function reply-in-outbox() -> string { return @tr("Your reply is in the Outbox; only the organizer gets it."); }
    pure public function answer-kept() -> string { return @tr("Answer kept on this computer; no reply was sent."); }
    pure public function invite-in-calendar() -> string { return @tr("In your calendar on this PC."); }
    // The Calendar page's agenda: the range shown ("Oct 15, 2026 to Nov 13, 2026"),
    // a day header for today and tomorrow ("Today, Thu, Oct 15") and an all-day event's time.
    pure public function cal-range(from: string, to: string) -> string { return @tr("{0} to {1}", from, to); }
    pure public function cal-today(day: string) -> string { return @tr("Today, {}", day); }
    pure public function cal-tomorrow(day: string) -> string { return @tr("Tomorrow, {}", day); }
    pure public function cal-all-day() -> string { return @tr("All day"); }
    pure public function cal-now() -> string { return @tr("event" => "Now"); }
    pure public function cal-in-min(n: int) -> string { return @tr("In {n} minute" | "In {n} minutes" % n); }
    pure public function cal-remind-at(time: string) -> string { return @tr("Starts at {0}.", time); }
    pure public function cal-remind-at-place(time: string, place: string) -> string { return @tr("Starts at {0}, {1}.", time, place); }
    pure public function cal-dav-offline() -> string { return @tr("Calendar sync is off while Komorebi is offline."); }
    pure public function cal-dav-auth() -> string { return @tr("The calendar server refused the user name or password."); }
    pure public function cal-dav-not-found() -> string { return @tr("No calendar was found at this address."); }
    pure public function cal-dav-tls() -> string { return @tr("The calendar server's certificate couldn't be checked."); }
    pure public function cal-dav-failed(detail: string) -> string { return @tr("Calendar sync failed ({0}).", detail); }
    pure public function cal-dav-none-found() -> string { return @tr("No calendars with events were found at this address."); }
    pure public function cal-dav-count(n: int) -> string { return @tr("{n} event from this account on this computer." | "{n} events from this account on this computer." % n); }
    pure public function cal-dav-check-host(url: string) -> string { return @tr("Found a calendar server at {0}. Check that it belongs to your mail provider, then press Find calendars again to sign in there.", url); }
    pure public function cal-dav-working() -> string { return @tr("Working with the calendar server..."); }
    // ---- The event editor and the calendar views
    pure public function cal-local-name() -> string { return @tr("On this PC"); }
    pure public function cal-named(name: string, account: string) -> string { return @tr("{0} ({1})", name, account); }
    pure public function cal-rep-none() -> string { return @tr("Does not repeat"); }
    pure public function cal-rep-daily() -> string { return @tr("Every day"); }
    pure public function cal-rep-weekly(day: string) -> string { return @tr("Every week on {0}", day); }
    pure public function cal-rep-monthly(n: int) -> string { return @tr("Every month on day {0}", n); }
    pure public function cal-rep-nth(n: int, day: string) -> string {
        return n == 1 ? @tr("Every month on the first {0}", day)
            : n == 2 ? @tr("Every month on the second {0}", day)
            : n == 3 ? @tr("Every month on the third {0}", day)
            : n == 4 ? @tr("Every month on the fourth {0}", day)
            : @tr("Every month on the last {0}", day);
    }
    pure public function cal-rep-yearly(date: string) -> string { return @tr("Every year on {0}", date); }
    pure public function cal-date-hint(day-first: bool) -> string { return day-first ? @tr("dd/mm/yyyy") : @tr("yyyy-mm-dd"); }
    pure public function cal-ed-bad-date(hint: string) -> string { return @tr("Type the dates as {0}.", hint); }
    pure public function cal-ed-bad-time() -> string { return @tr("Type the times as 09:30."); }
    pure public function cal-ed-end-before() -> string { return @tr("The event ends before it starts."); }
    pure public function cal-ed-gap() -> string { return @tr("That time doesn't exist here: the clocks change then."); }
    pure public function cal-ed-read-only() -> string { return @tr("This calendar is read only. Choose another one."); }
    pure public function cal-ed-failed(detail: string) -> string { return @tr("The event couldn't be saved ({0}).", detail); }

    // ---- Status line actions
    pure public function action-undo() -> string { return @tr("Undo"); }
    pure public function action-retry() -> string { return @tr("Retry"); }
    pure public function action-update-password() -> string { return @tr("Update password"); }
    pure public function action-review-certificate() -> string { return @tr("Review certificate"); }
    pure public function action-try-now() -> string { return @tr("Try now"); }
    // An account's caution badge in the folder pane and rail (its server
    // was out of reach at the last sync).
    pure public function nav-unreachable(host: string) -> string { return @tr("Can't reach {0}", host); }
    // The What's new bar (src/app/tips.rs), Informational, after an update.
    pure public function whats-new-bar(version: string) -> string { return @tr("Komorebi was updated to {0}.", version); }
    pure public function action-whats-new() -> string { return @tr("What's new"); }

    // ---- The account form and the accounts' lines
    pure public function err-email() -> string { return @tr("Enter your full email address."); }
    pure public function err-email-first() -> string { return @tr("Enter your full email address first."); }
    pure public function err-account-exists() -> string { return @tr("This account is already added."); }
    pure public function err-account-removed() -> string { return @tr("This account was removed."); }
    pure public function err-password-to-test() -> string { return @tr("Enter the password to test."); }
    pure public function err-offline-check() -> string { return @tr("Offline: a password or server change can't be checked."); }
    pure public function err-offline-cert() -> string { return @tr("Offline: a certificate can't be reviewed."); }
    pure public function err-offline-find() -> string { return @tr("Offline: settings can't be looked up."); }
    pure public function err-saved-password() -> string { return @tr("Komorebi couldn't read the saved password. Type the password to test."); }
    pure public function err-provider() -> string { return @tr("Choose your provider."); }
    pure public function err-server-names() -> string { return @tr("Enter the IMAP and SMTP server names."); }
    pure public function err-server-name-only() -> string { return @tr("Enter the server name only, such as mail.example.com."); }
    pure public function err-zone-id() -> string { return @tr("Zone identifiers such as %eth0 aren't supported. Remove the part after the % sign."); }
    pure public function err-ascii-name() -> string { return @tr("Use the ASCII (xn--) form of the server name, such as xn--mail-example.com."); }
    pure public function err-port(proto: string) -> string { return @tr("Enter a valid {0} port.", proto); }
    pure public function err-username(proto: string) -> string { return @tr("Enter a valid {0} username.", proto); }
    pure public function check-passed() -> string { return @tr("Every step passed. Nothing was saved; use Add account or Save to keep these settings."); }
    pure public function account-saved(email: string) -> string { return @tr("Saved {0}.", email); }
    pure public function account-off() -> string { return @tr("Off: no connections; its downloaded mail stays"); }
    pure public function account-downloading(done: string, total: string) -> string { return @tr("Downloading {0} of {1}\u{a0}…", done, total); }
    pure public function account-sign-in-rejected() -> string { return @tr("Sign-in rejected"); }
    pure public function account-secure-failed() -> string { return @tr("Secure connection failed"); }
    pure public function account-syncing() -> string { return @tr("Syncing\u{a0}…"); }
    pure public function account-checked(time: string) -> string { return @tr("Up to date, checked {0}", time); }
    pure public function account-up-to-date() -> string { return @tr("Up to date"); }
    pure public function account-unreachable(host: string) -> string { return @tr("Can't reach {0}", host); }
    pure public function account-sync-failed(detail: string) -> string { return @tr("Last sync failed: {0}", detail); }
    pure public function status-downloading(email: string, done: string, total: string, folder: string) -> string {
        return @tr("{0}: downloading {1} of {2} in {3}\u{a0}…", email, done, total, folder);
    }
    pure public function redownloading(email: string) -> string { return @tr("Downloading the mail of {0} again\u{a0}…", email); }
    pure public function redownload-later(email: string) -> string { return @tr("The mail of {0} downloads again at its next sync.", email); }

    // ---- Folders and the list
    pure public function all-inboxes() -> string { return @tr("All inboxes"); }
    pure public function drafts() -> string { return @tr("Drafts"); }
    pure public function outbox() -> string { return @tr("Outbox"); }
    pure public function all-folders() -> string { return @tr("All folders"); }
    // The title bar's search: its placeholder names the view, its scope
    // control has scope words (never a view name), and the list says what
    // a search found where.
    pure public function search-in(view: string) -> string { return @tr("Search {0}", view); }
    pure public function scope-this-folder() -> string { return @tr("This folder"); }
    pure public function scope-these-inboxes() -> string { return @tr("These inboxes"); }
    pure public function search-results() -> string { return @tr("Search results"); }
    pure public function results-in(n: int, view: string) -> string { return @tr("{n} result in {0}" | "{n} results in {0}" % n, view); }
    pure public function results-all(n: int) -> string { return @tr("{n} result in all folders" | "{n} results in all folders" % n); }
    pure public function show-in-folder() -> string { return @tr("Show in folder"); }
    // An all-folders search's row tag: the account and the folder.
    pure public function account-folder(account: string, folder: string) -> string { return @tr("tag" => "{0} · {1}", account, folder); }
    // The folder pane's row menu, and the list's "..." menu.
    pure public function menu-mark-all-read() -> string { return @tr("Mark all as read"); }
    pure public function menu-collapse-all() -> string { return @tr("Collapse all"); }
    pure public function menu-collapse-all-folders() -> string { return @tr("Collapse all folders"); }
    // The row menu and the reader's More menu: the message in a tab or a
    // window of its own.
    pure public function menu-open-tab() -> string { return @tr("Open in new tab"); }
    pure public function menu-open-window() -> string { return @tr("Open in new window"); }
    // The folder pane's own menu: fold it to the rail, or open it again.
    pure public function menu-hide-folders() -> string { return @tr("Hide folders"); }
    pure public function menu-show-folders() -> string { return @tr("Show folders"); }
    pure public function menu-refresh() -> string { return @tr("Refresh"); }
    pure public function menu-account-settings() -> string { return @tr("Account settings"); }
    // The account page's "…" menu (as `menu:account` prints it).
    pure public function menu-move-up() -> string { return @tr("Move up"); }
    pure public function menu-move-down() -> string { return @tr("Move down"); }
    pure public function menu-select-messages() -> string { return @tr("Select messages"); }
    // The row menu and the reader's More menu (each item's accelerator text
    // follows after a tab; key names stay as Windows writes them, but
    // Backspace, which Portuguese Windows calls Retrocesso).
    pure public function menu-reply() -> string { return @tr("Reply"); }
