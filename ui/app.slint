import { LineEdit, TextEdit, ComboBox, CheckBox, ListView, ScrollView, AboutSlint, Spinner, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { NavItem, MailRow, AttachmentRow, AccountRow, FolderOption, Icon, IconButton, AccentButton, NavRow, MailItem, Chip, FieldLabel } from "widgets.slint";

export { Theme, Palette }

export struct AccountForm {
    provider: int,      // index into the provider list; past the presets = manual
    name: string,
    email: string,
    password: string,
    imap-host: string,
    imap-port: string,
    smtp-host: string,
    smtp-port: string,
    smtp-starttls: bool,
    save-sent: bool,
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.stroke;
    clip: true;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.stroke;
}

component Heading inherits Text {
    font-size: Theme.subtitle;
    font-weight: 600;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

component BodyText inherits Text {
    font-size: Theme.body;
    color: Theme.text;
    wrap: word-wrap;
}

// ---------------------------------------------------------------- settings

component SettingsDialog inherits Rectangle {
    in property <[AccountRow]> accounts;
    in property <bool> busy;
    in property <string> error;
    // The form lives only while the dialog is open, so a typed password is
    // gone as soon as it closes.
    property <int> provider: 0;      // 0 Purelymail, 1 Postale.io, 2 Other
    property <string> name;
    property <string> email;
    property <string> password;
    property <string> imap-host;
    property <string> imap-port: "993";
    property <string> smtp-host;
    property <string> smtp-port: "465";
    property <int> smtp-security: 0; // 0 SSL/TLS, 1 STARTTLS
    property <bool> save-sent: true;
    callback close;
    callback add-account(AccountForm);
    callback remove-account(int);

    background: Theme.scrim;
    TouchArea { }  // swallow clicks behind the dialog

    Card {
        width: min(560px, root.width - 32px);
        height: min(720px, root.height - 32px);
        background: Theme.card;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;

        VerticalLayout {
            padding: Theme.s6;
            spacing: Theme.s4;
            HorizontalLayout {
                Text {
                    text: "Settings";
                    font-size: Theme.title;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.dismiss;
                    tooltip: "Close";
                    width: 32px;
                    clicked => { root.close(); }
                }
            }

            ScrollView {
                vertical-stretch: 1;
        VerticalLayout {
                    spacing: Theme.s3;
                    padding-right: Theme.s3;

                    Heading { text: "Accounts"; }
                    if accounts.length == 0: Text {
                        text: "No accounts yet.";
                        font-size: Theme.body;
                        color: Theme.text-3;
                    }
                    for a in accounts: Rectangle {
                        height: 52px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        HorizontalLayout {
                            padding-left: Theme.s3;
                            padding-right: Theme.s2;
                            spacing: Theme.s3;
                            Icon { text: Icons.person; width: 20px; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: a.email; font-size: Theme.body; color: Theme.text; overflow: elide; }
                                Text { text: a.detail; font-size: Theme.caption; color: Theme.text-3; overflow: elide; }
                            }
                            IconButton {
                                icon: Icons.delete;
                                label: "Remove";
                                y: 10px;
                                clicked => { root.remove-account(a.id); }
                            }
                        }
                    }

                    Divider { }
                    Heading { text: "Add an account"; }
                    GridLayout {
                        spacing: Theme.s2;
                        Row {
                            FieldLabel { text: "Provider"; width: 96px; }
                            ComboBox {
                                model: ["Purelymail", "Postale.io", "Other (manual)"];
                                current-index <=> root.provider;
                                selected(v) => {
                                    if root.provider == 0 { root.smtp-port = "465"; root.imap-port = "993"; }
                                }
                            }
                        }
                        Row {
                            FieldLabel { text: "Name"; width: 96px; }
                            LineEdit { text <=> root.name; placeholder-text: "Shown to recipients"; }
                        }
                        Row {
                            FieldLabel { text: "Email"; width: 96px; }
                            LineEdit { text <=> root.email; placeholder-text: "you@yourdomain.com";  }
                        }
                        Row {
                            FieldLabel { text: "Password"; width: 96px; }
                            LineEdit { text <=> root.password; input-type: InputType.password; placeholder-text: "Password or app password"; }
                        }
                    }
                    if root.provider == 2: GridLayout {
                        spacing: Theme.s2;
                        Row {
                            FieldLabel { text: "IMAP"; width: 96px; }
                            LineEdit { text <=> root.imap-host; placeholder-text: "imap.example.com"; }
                            LineEdit { text <=> root.imap-port; width: 72px; input-type: InputType.number; }
                        }
                        Row {
                            FieldLabel { text: "SMTP"; width: 96px; }
                            LineEdit { text <=> root.smtp-host; placeholder-text: "smtp.example.com"; }
                            LineEdit { text <=> root.smtp-port; width: 72px; input-type: InputType.number; }
                        }
                        Row {
                            FieldLabel { text: "SMTP security"; width: 96px; }
                            ComboBox {
                                colspan: 2;
                                model: ["SSL/TLS (port 465)", "STARTTLS (port 587)"];
                                current-index <=> root.smtp-security;
                                selected(v) => { root.smtp-port = root.smtp-security == 0 ? "465" : "587"; }
                            }
                        }
                    }
                    CheckBox {
                        text: "Save a copy of sent mail in the Sent folder";
                        checked <=> root.save-sent;
                    }
                    if root.error != "": Rectangle {
                        background: Theme.danger-bg;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding: Theme.s2;
                            spacing: Theme.s2;
                            Icon { text: Icons.error; color: Theme.danger; width: 20px; }
                            BodyText { text: root.error; color: Theme.danger; horizontal-stretch: 1; }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.s2;
                        if root.busy: Spinner { indeterminate: true; width: 24px; height: 24px; }
                        AccentButton {
                            label: root.busy ? "Signing in…" : "Add account";
                            enabled: !root.busy && root.email != "" && root.password != "";
                            clicked => {
                                root.add-account({
                                    provider: root.provider,
                                    name: root.name,
                                    email: root.email,
                                    password: root.password,
                                    imap-host: root.imap-host,
                                    imap-port: root.imap-port,
                                    smtp-host: root.smtp-host,
                                    smtp-port: root.smtp-port,
                                    smtp-starttls: root.smtp-security == 1,
                                    save-sent: root.save-sent,
                                });
                            }
                        }
                    }

                    Divider { }
                    Heading { text: "About"; }
                    BodyText {
                        text: "Komorebi is a free, open-source email client. No telemetry, no ads, no remote content. Passwords are kept in Windows Credential Manager.";
                        color: Theme.text-2;
                    }
                    AboutSlint { height: 160px; }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ window

export component AppWindow inherits Window {
    title: "Komorebi";
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1280px;
    preferred-height: 820px;
    background: Theme.layer;
    default-font-family: Theme.text-font;
    // Navigation
    in property <[NavItem]> nav-items;
    in property <int> selected-folder: 0;     // folder id; 0 = all inboxes
    in property <bool> has-accounts: true;
    callback nav-clicked(NavItem);

    // Message list
    in property <string> list-title: "All inboxes";
    in property <[MailRow]> rows;
    in property <int> selected-id: -1;
    in property <int> selected-index: -1;
    in property <bool> syncing;
    in-out property <string> search-text;
    callback message-selected(int);
    callback select-offset(int);
    callback refresh();
    callback search-edited(string);

    // Reader
    in property <bool> has-message;
    in property <bool> loading;
    in property <string> r-subject;
    in property <string> r-from-name;
    in property <string> r-from-addr;
    in property <string> r-initials;
    in property <color> r-avatar: #0f6cbd;
    in property <string> r-date;
    in property <string> r-to;
    in property <string> r-cc;
    in property <string> r-body;
    in property <bool> r-flagged;
    in property <bool> r-unread;
    in property <[AttachmentRow]> r-attachments;
    in property <[FolderOption]> move-targets;
    callback reply();
    callback reply-all();
    callback forward();
    callback archive();
    callback delete();
    callback toggle-read();
    callback toggle-flag();
    callback move-to(int);
    callback save-attachment(int);

    // Composer
    in-out property <bool> composing;
    in property <string> c-title: "New message";
    in property <[string]> c-from-options;
    in-out property <int> c-from-index;
    in-out property <string> c-to;
    in-out property <string> c-cc;
    in-out property <string> c-bcc;
    in-out property <string> c-subject;
    in-out property <string> c-body;
    in-out property <bool> c-show-cc;
    in property <[AttachmentRow]> c-attachments;
    in property <bool> c-sending;
    callback compose();
    callback send();
    callback discard();
    callback attach();
    callback remove-attachment(int);

    // Settings
    in-out property <bool> show-settings;
    in property <[AccountRow]> accounts;
    in property <bool> a-busy;
    in-out property <string> a-error;
    callback add-account(AccountForm);
    callback remove-account(int);
    callback settings-closed();

    // Status toast
    in property <string> status;
    in property <bool> status-error;
    callback dismiss-status();

    // Set from a change handler (not a binding) because labels shown in
    // wide mode feed back into the window's layout constraints.
    property <bool> compact: false;
    property <bool> reading: !root.composing && !root.show-settings;
    changed width => { root.compact = root.width < 1040px; }
    init => { root.compact = root.width < 1040px; }

    public function focus-list() {
        keys.focus();
    }

    function ensure-visible(index: int) {
        if index < 0 { return; }
        if index * 76px + list.content-y < 0 {
            list.content-y = -index * 76px;
        } else if (index + 1) * 76px + list.content-y > list.visible-height {
            list.content-y = list.visible-height - (index + 1) * 76px;
        }
    }

    changed selected-index => { ensure-visible(selected-index); }
    // A sign-in that failed after the dialog closed must not greet the next open.
    changed show-settings => { if root.show-settings { root.a-error = ""; } }

    keys := FocusScope {
        // Keys reach these only when the focused widget doesn't use them
        // (text fields keep their own arrows, Delete and so on).
        KeyBinding { keys: @keys(F5); activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + "n"); enabled: !root.show-settings; activated => { root.compose(); } }
        KeyBinding { keys: @keys(Control + "f"); enabled: !root.show-settings; activated => { search.focus(); } }
        // These act on the selected message; a draft must never be replaced
        // by a stray Ctrl+R.
        KeyBinding { keys: @keys(Control + "r"); enabled: root.reading; activated => { root.reply(); } }
        KeyBinding { keys: @keys(Control + Shift + "r"); enabled: root.reading; activated => { root.reply-all(); } }
        KeyBinding { keys: @keys(Control + "q"); enabled: root.reading; activated => { root.toggle-read(); } }
        KeyBinding { keys: @keys(Delete); enabled: root.reading; activated => { root.delete(); } }
        KeyBinding { keys: @keys(Shift? + DownArrow); enabled: root.reading; activated => { root.select-offset(1); } }
        KeyBinding { keys: @keys(Shift? + UpArrow); enabled: root.reading; activated => { root.select-offset(-1); } }

        HorizontalLayout {
            padding: Theme.s2;
            padding-left: 0;
            spacing: Theme.s2;

            // ---- navigation pane
            VerticalLayout {
                width: root.compact ? 56px : 248px;
                padding-left: Theme.s2;
                padding-top: Theme.s1;
                spacing: Theme.s2;
                AccentButton {
                    icon: Icons.compose;
                    label: root.compact ? "" : "New mail";
                    enabled: root.has-accounts;
                    clicked => { root.compose(); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: nav-col.preferred-height;
                    nav-col := VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        for item in root.nav-items: NavRow {
                            item: item;
                            compact: root.compact;
                            selected: (item.kind == 0 && root.selected-folder == 0) || (item.kind == 2 && item.id == root.selected-folder);
                            clicked => { root.nav-clicked(item); keys.focus(); }
                        }
                    }
                }
                IconButton {
                    icon: Icons.settings;
                    label: root.compact ? "" : "Settings";
                    tooltip: "Settings";
                    alignment: root.compact ? center : start;
                    clicked => { root.show-settings = true; }
                }
            }

            // ---- message list
            Card {
                width: root.compact ? 300px : 380px;
        VerticalLayout {
                    HorizontalLayout {
                        height: 52px;
                        padding-left: Theme.s4;
                        padding-right: Theme.s2;
                        spacing: Theme.s1;
                        Heading { text: root.list-title; horizontal-stretch: 1; }
                        if root.syncing: Spinner { indeterminate: true; width: 20px; height: 20px; y: 16px; }
                        IconButton {
                            icon: Icons.refresh;
                            tooltip: "Refresh (F5)";
                            width: 32px;
                            y: 10px;
                            enabled: !root.syncing;
                            clicked => { root.refresh(); }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        padding-bottom: Theme.s2;
                        search := LineEdit {
                            placeholder-text: "Search (Ctrl+F)";
                            text <=> root.search-text;
                            edited(t) => { root.search-edited(t); }
                        }
                    }
                    Divider { }
                    list := ListView {
                        vertical-stretch: 1;
                        for row[i] in root.rows: MailItem {
                            mail: row;
                            selected: row.id == root.selected-id;
                            clicked => {
                                keys.focus();
                                root.message-selected(row.id);
                            }
                        }
                    }
                    if root.rows.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.search-text != "" ? "No matches" : root.syncing ? "Loading…" : "Nothing here";
                            font-size: Theme.body;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // ---- reader / composer
            Card {
                horizontal-stretch: 1;

                if root.composing: VerticalLayout {
                    padding: Theme.s4;
                    spacing: Theme.s2;
                    HorizontalLayout {
                        spacing: Theme.s2;
                        Heading { text: root.c-title; horizontal-stretch: 1; }
                        IconButton { icon: Icons.attach; label: root.compact ? "" : "Attach"; tooltip: "Attach"; enabled: !root.c-sending; clicked => { root.attach(); } }
                        IconButton { icon: Icons.delete; label: root.compact ? "" : "Discard"; tooltip: "Discard"; enabled: !root.c-sending; clicked => { root.discard(); } }
                        AccentButton {
                            icon: Icons.send;
                            label: root.c-sending ? "Sending…" : "Send";
                            enabled: !root.c-sending;
                            clicked => { root.send(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        FieldLabel { text: "From"; }
                        ComboBox { model: root.c-from-options; current-index <=> root.c-from-index; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        FieldLabel { text: "To"; }
                        LineEdit { text <=> root.c-to; horizontal-stretch: 1; }
                        if !root.c-show-cc: IconButton { label: "Cc/Bcc"; icon: Icons.add; clicked => { root.c-show-cc = true; } }
                    }
                    if root.c-show-cc: HorizontalLayout {
                        spacing: Theme.s2;
                        FieldLabel { text: "Cc"; }
                        LineEdit { text <=> root.c-cc; }
                    }
                    if root.c-show-cc: HorizontalLayout {
                        spacing: Theme.s2;
                        FieldLabel { text: "Bcc"; }
                        LineEdit { text <=> root.c-bcc; }
                    }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        FieldLabel { text: "Subject"; }
                        LineEdit { text <=> root.c-subject; }
                    }
                    for a in root.c-attachments: Chip {
                        name: a.name;
                        size: a.size;
                        action-icon: Icons.dismiss;
                        action-label: "Remove " + a.name;
                        action => { root.remove-attachment(a.index); }
                    }
                    TextEdit {
                        text <=> root.c-body;
                        wrap: word-wrap;
                        font-size: Theme.body;
                        vertical-stretch: 1;
                    }
                }

                if !root.composing && !root.has-message: VerticalLayout {
                    alignment: center;
                    spacing: Theme.s2;
                    Icon { text: Icons.read; font-size: 40px; color: Theme.text-disabled; }
                    Text {
                        text: "Select a message to read";
                        font-size: Theme.body;
                        color: Theme.text-3;
                        horizontal-alignment: center;
                    }
                }

                if !root.composing && root.has-message: VerticalLayout {
                    // Command bar
                    HorizontalLayout {
                        height: 48px;
                        padding-left: Theme.s2;
                        padding-right: Theme.s2;
                        spacing: 2px;
                        alignment: start;
                        IconButton { icon: Icons.reply; label: root.compact ? "" : "Reply"; tooltip: "Reply"; y: 8px; clicked => { root.reply(); } }
                        IconButton { icon: Icons.reply-all; label: root.compact ? "" : "Reply all"; tooltip: "Reply all"; y: 8px; clicked => { root.reply-all(); } }
                        IconButton { icon: Icons.forward; label: root.compact ? "" : "Forward"; tooltip: "Forward"; y: 8px; clicked => { root.forward(); } }
                        Rectangle { width: 1px; height: 20px; y: 14px; background: Theme.stroke-strong; }
                        IconButton { icon: Icons.archive; label: root.compact ? "" : "Archive"; tooltip: "Archive"; y: 8px; clicked => { root.archive(); } }
                        IconButton { icon: Icons.delete; label: root.compact ? "" : "Delete"; tooltip: "Delete"; y: 8px; clicked => { root.delete(); } }
                        move-btn := IconButton {
                            icon: Icons.move;
                            label: root.compact ? "" : "Move";
                            tooltip: "Move";
                            y: 8px;
                            enabled: root.move-targets.length > 0;
                            clicked => { move-popup.show(); }
                        }
                        IconButton {
                            icon: root.r-unread ? Icons.read : Icons.mail;
                            tooltip: root.r-unread ? "Mark as read" : "Mark as unread";
                            width: 32px;
                            y: 8px;
                            clicked => { root.toggle-read(); }
                        }
                        IconButton {
                            icon: root.r-flagged ? Icons.flag-filled : Icons.flag;
                            icon-color: root.r-flagged ? Theme.danger : Theme.text-2;
                            tooltip: root.r-flagged ? "Remove flag" : "Flag";
                            width: 32px;
                            y: 8px;
                            clicked => { root.toggle-flag(); }
                        }
                    }
                    move-popup := PopupWindow {
                        x: move-btn.x;
                        y: 44px;
                        width: 240px;
                        Rectangle {
                            background: Theme.card;
                            border-radius: Theme.radius-lg;
                            border-width: 1px;
                            border-color: Theme.stroke-strong;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: #00000033;
                            VerticalLayout {
                                padding: Theme.s1;
                                for f in root.move-targets: Rectangle {
                                    height: 32px;
                                    border-radius: Theme.radius;
                                    background: fta.has-hover ? Theme.hover : transparent;
                                    fta := TouchArea { clicked => { root.move-to(f.id); } }
                                    HorizontalLayout {
                                        padding-left: Theme.s2;
                                        spacing: Theme.s2;
                                        Icon { text: Icons.folder; width: 20px; }
                                        Text { text: f.label; font-family: Theme.text-font; font-size: Theme.body; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                    Divider { }
                    ScrollView {
                        vertical-stretch: 1;
                        content-height: body-col.preferred-height;
                        body-col := VerticalLayout {
                            width: parent.visible-width;
                            padding: Theme.s6;
                            padding-top: Theme.s4;
                            spacing: Theme.s4;
                            Text {
                                text: root.r-subject == "" ? "(no subject)" : root.r-subject;
                                font-size: Theme.title;
                                font-weight: 600;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: root.r-avatar;
                                    Text { text: root.r-initials; color: white; font-size: Theme.body; font-weight: 600; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            text: root.r-from-name;
                                            font-size: Theme.body;
                                            font-weight: 600;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "<" + root.r-from-addr + ">";
                                            font-size: Theme.caption + 1px;
                                            color: Theme.text-3;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.r-date;
                                            font-size: Theme.caption;
                                            color: Theme.text-3;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "To: " + root.r-to + (root.r-cc != "" ? "   Cc: " + root.r-cc : "");
                                        font-size: Theme.caption;
                                        color: Theme.text-3;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            for a in root.r-attachments: Chip {
                                name: a.name;
                                size: a.size;
                                action-icon: Icons.save;
                                action-label: "Save " + a.name;
                                action => { root.save-attachment(a.index); }
                            }
                            if root.loading: HorizontalLayout {
                                spacing: Theme.s2;
                                Spinner { indeterminate: true; width: 20px; height: 20px; }
                                Text { text: "Downloading message…"; font-size: Theme.body; color: Theme.text-3; vertical-alignment: center; }
                            }
                            TextInput {
                                text: root.r-body;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: Theme.body;
                                color: Theme.text;
                                selection-background-color: Theme.accent.with-alpha(0.35);
                                selection-foreground-color: Theme.text;
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- first-run welcome (covers list + reader)
    if !root.has-accounts: Card {
        x: root.compact ? 64px : 256px;
        y: Theme.s2;
        width: root.width - self.x - Theme.s2;
        height: root.height - 2 * Theme.s2;
        VerticalLayout {
            alignment: center;
            spacing: Theme.s4;
            padding: Theme.s6;
            Icon { text: Icons.mail; font-size: 48px; color: Theme.accent-text; }
            Text {
                text: "Welcome to Komorebi";
                font-size: Theme.title + 4px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Add your Purelymail, Postale.io or other IMAP account to get started.";
                font-size: Theme.body;
                color: Theme.text-2;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                AccentButton {
                    icon: Icons.add;
                    label: "Add account";
                    clicked => { root.show-settings = true; }
                }
            }
        }
    }


    // ---- status toast
    if root.status != "": Rectangle {
        x: root.compact ? 72px : 264px;
        y: root.height - self.height - 20px;
        width: min(480px, root.width - self.x - 24px);
        height: toast-row.preferred-height;
        border-radius: Theme.radius-lg;
        background: root.status-error ? Theme.danger-bg : Theme.info-bg;
        border-width: 1px;
        border-color: root.status-error ? Theme.danger : Theme.stroke-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000030;
        toast-row := HorizontalLayout {
            padding: Theme.s2;
            padding-left: Theme.s3;
            spacing: Theme.s2;
            Icon {
                text: root.status-error ? Icons.error : Icons.info;
                color: root.status-error ? Theme.danger : Theme.accent-text;
                width: 20px;
            }
            BodyText { text: root.status; horizontal-stretch: 1; vertical-alignment: center; }
            IconButton { icon: Icons.dismiss; tooltip: "Dismiss"; width: 32px; clicked => { root.dismiss-status(); } }
        }
    }

    // ---- settings overlay
    if root.show-settings: SettingsDialog {
        width: root.width;
        height: root.height;
        accounts: root.accounts;
        busy: root.a-busy;
        error: root.a-error;
        close => { root.show-settings = false; root.settings-closed(); }
        add-account(form) => { root.add-account(form); }
        remove-account(id) => { root.remove-account(id); }
    }
}
