    // Settings keep the pane from a message or draft tab too.
    out property <bool> pane-shown: root.mail-shown && (root.mail-tab || root.show-settings) && !root.detail-only;
    property <length> nav-width: !root.pane-shown ? 0
        : root.compact ? Theme.rail-width : Theme.rail-width + root.fold-extra;
    // What the full pane adds to the rail from 1040 px. WinUI's
