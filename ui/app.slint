    out property <bool> folded: root.compact || root.nav-collapsed;
    changed folded => { root.layout-changed(root.folded); }
    out property <bool> rail: root.folded && !root.pane-open;
    property <[NavItem]> shown-nav: root.rail ? root.rail-items : root.nav-items;
    property <int> shown-pill: root.rail ? root.rail-pill : root.nav-pill;
    changed rail => { root.nav-cursor = max(0, root.shown-pill); }
    // The row the folder pane's menu is for.
    property <NavItem> menu-nav;
    function show-nav-menu(item: NavItem, x: length, y: length) {
