            root.settings-refocus += 1;
            return;
        }
        if root.composing {
            root.body-refocus += 1;
        } else if root.return-pane == 0 {
            nav.focus();
        } else if root.return-pane == 2 && root.reader-target {
            root.pane-seq += 1;
        } else {
            keys.focus();
        }
        root.return-pane = 1;
    }
    changed src-show => { if !root.src-show { root.after-prompt(); } }
    changed q-title => { if root.q-title == "" { root.after-prompt(); } }
    // The sender notice's Why? hands the focus back to the reader.
    changed why-show => {
        if !root.why-show {
            root.return-pane = 2;
            root.after-prompt();
        }
    }
    changed c-confirm-discard => { if !root.c-confirm-discard { root.after-prompt(); } }
    // The question before a switch to plain text hands the body back.
    property <bool> plain-ask: Rich.plain-ask;
    changed plain-ask => { if !root.plain-ask { root.after-prompt(); } }
    // A reader button that may have asked a question (the prompt is up
    // once its callback returns): the answer hands the focus back here.
    function asked-in-reader() {
        if root.q-title != "" {
            root.return-pane = 2;
        }
    }
    // Show original, the focus coming back to pane `p` (none to show:
    // nothing to come back to).
    property <int> menu-pane: 1;
    function original-from(p: int) {
        root.return-pane = p;
        root.show-original();
        if !root.src-show {
            root.return-pane = 1;
        }
    }
    // Back to the page (its focused link) after the link prompt.
    function page-back() {
        if root.has-message && !root.composing {
            root.focus-page = true;
        } else {
            keys.focus();
        }
    }
    // A row to open a menu on: a message (open or selected), or a draft
    // or Outbox row under the keyboard.
    property <bool> row-menu-ready: root.has-message || root.selected-count > 0
        || (root.selected-folder < 0 && root.selected-index >= 0);
    function show-row-menu() {
        let below = (max(0, root.selected-index) + 1) * Theme.row-height + list.content-y;
        root.show-row-menu-at(list-keys.absolute-position.x + Theme.s6, list-keys.absolute-position.y + clamp(below, 0px, list-keys.height));
    }
    // The row menu at a window position (Shift+F10 and a right-click
    // alike): a draft's or an Outbox row's own, else the messages' menu.
    function show-row-menu-at(x: length, y: length) {
        if root.selected-folder < 0 {
            draft-menu.show({ x: x, y: y });
        } else {
            root.menu-opening();
            row-menu.show({ x: x, y: y });
        }
    }
    function cycle-pane(back: bool) {
        // A dialog keeps the focus: F6 never moves it behind the scrim.
        if root.shortcuts-show || root.src-show || root.l-show || root.q-title != "" || root.c-confirm-discard || Rich.plain-ask || root.why-show {
            return;
        }
        // The welcome (and Settings from it) is one pane: nothing to cycle.
        if !root.mail-shown {
            if root.show-settings {
                Focus.keyboard = true;
                root.settings-refocus += 1;
            }
            return;
        }
        let p = root.pane-of-focus();
        // Settings: the folders and the page.
        if root.show-settings {
            Focus.keyboard = true;
            // No pane (a message window): the page is the one stop.
            if p == 0 || root.nav-width == 0 {
                root.settings-refocus += 1;
            } else {
                nav.focus();
            }
            return;
        }
        // The stops, in order: the title bar's search (-1), the tab strip
        // (3, while it shows), the folders, the list (Mail tab), the reader
        // (when it shows something).
        let s = search.has-focus || scope-box.has-focus ? -1 : p;
        let j = root.stop-place(s);
        let d = back ? 4 : 1;
        let j1 = mod(j + d, 5);
        let j2 = mod(j1 + d, 5);
        let j3 = mod(j2 + d, 5);
        let j4 = mod(j3 + d, 5);
        let next = root.stop-ok(root.stop-at(j1)) ? root.stop-at(j1)
            : root.stop-ok(root.stop-at(j2)) ? root.stop-at(j2)
            : root.stop-ok(root.stop-at(j3)) ? root.stop-at(j3)
            : root.stop-ok(root.stop-at(j4)) ? root.stop-at(j4) : s;
        Focus.keyboard = true;
        if next == -1 {
            search.focus();
        } else if next == 3 {
            strip.focus();
        } else if next == 0 {
            nav.focus();
        } else if next == 1 {
            list-keys.focus();
        } else {
            root.pane-seq += 1;
        }
    }
    // The F6 stops' order (search, tab strip, folders, list, reader), and
    // which of them show now.
    pure function stop-place(k: int) -> int {
        k == -1 ? 0 : k == 3 ? 1 : k + 2
    }
    pure function stop-at(j: int) -> int {
        j == 0 ? -1 : j == 1 ? 3 : j - 2
    }
    pure function stop-ok(k: int) -> bool {
        k == -1 ? true
            : k == 3 ? root.tabs-shown
            : k == 0 ? root.mail-tab
            : k == 1 ? root.mail-tab && root.show-list
            : root.show-reader && (root.reader-target || !root.mail-tab)
    }

    // Put `text` on the clipboard (the hidden buffer below; no extra crate).
    public function r-copy-text(text: string) {
        copy-buf.text = text;
        copy-buf.select-all();
        copy-buf.copy();
        copy-buf.text = "";
    }

    function ensure-visible(index: int) {
        if index < 0 { return; }
        if index * Theme.row-height + list.content-y < 0 {
            list.content-y = -index * Theme.row-height;
        } else if (index + 1) * Theme.row-height + list.content-y > list.visible-height {
            list.content-y = list.visible-height - (index + 1) * Theme.row-height;
        }
    }

    changed selected-index => { ensure-visible(selected-index); }
    changed r-scale => { root.r-body-resized(); }
    // A message with dark rules is laid out again when the app theme flips.
    property <bool> dark: Theme.dark;
    changed dark => { root.r-body-resized(); }
    // Back from the plain-text view: fetch the tiles in view again.
    changed r-plain => { root.r-view-changed(); }
    // A sign-in that failed after the dialog closed must not greet the next open.
    changed show-settings => {
        if root.show-settings {
            root.show-calendar = false;
            root.a-error = "";
            root.settings-opened();
        } else {
            root.a-ok = "";
            root.a-test = [];
            // Closed from the controller too (an account added or saved).
            if root.settings-from == 1 {
                root.chrome-refocus += 1;
            } else if root.settings-from == 0 {
                root.after-prompt();
            }
            root.settings-from = 0;
            // The flow opened from Add account goes with Settings.
            if root.ob-open && root.ob-embedded {
                root.close-onboarding();
            }
        }
    }

    keys := FocusScope {
        // Not a Tab stop itself: the list below has the keys (see
        // `list-keys`), and these see what the focused control leaves.
        forward-focus: list-keys;
        focus-on-tab-navigation: false;
        // Keys that move the focus show where it is (rings on the list and
        // folder rows); a click hides it again.
        capture-key-pressed(e) => {
            // A key hides the tooltip, as in WinUI.
            Tip.shown = false;
            // Esc closes a teaching tip first, as Got it: the innermost
            // step of the Esc stack, before a text field or the list.
            if e.text == Key.Escape && root.tip-visible {
                root.tip-got-it();
                return accept;
            }
            // Ctrl+/ (any layout's "/", Shift or not), except in the
            // composer, where Portugal's Ctrl+Shift+7 is the numbered list.
            if e.text == "/" && e.modifiers.control && !e.modifiers.alt && !root.composing {
                root.open-shortcuts();
                return accept;
            }
            // The tab keys (docs/WINUI3.md "TabView"), before any field:
            // Ctrl+Tab would otherwise reach the composer's body.
            if root.tab-keys-on && e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                if e.text == Key.Tab || e.text == Key.Backtab {
                    root.tab-key(e.modifiers.shift || e.text == Key.Backtab ? 2 : 1);
                    return accept;
                }
                if e.text == Key.PageDown {
                    root.tab-key(e.modifiers.shift ? 4 : 1);
                    return accept;
                }
                if e.text == Key.PageUp {
                    root.tab-key(e.modifiers.shift ? 3 : 2);
                    return accept;
                }
                if e.modifiers.shift && (e.text == "t" || e.text == "T") {
                    root.tab-key(6);
                    return accept;
                }
                if !e.modifiers.shift {
                    if e.text == "w" || e.text == "W" || e.text == Key.F4 {
                        root.tab-key(5);
                        return accept;
                    }
                    if e.text == "o" || e.text == "O" {
                        root.open-window();
                        return accept;
                    }
                    if e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5"
                        || e.text == "6" || e.text == "7" || e.text == "8" || e.text == "9" {
                        root.tab-key(10 + e.text.to-float());
                        return accept;
                    }
                }
            }
            if e.text == Key.Tab || e.text == Key.Backtab || e.text == Key.F6 || e.text == Key.UpArrow || e.text == Key.DownArrow
                || e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == Key.Home || e.text == Key.End
                || e.text == Key.PageUp || e.text == Key.PageDown {
                Focus.keyboard = true;
            }
            reject
        }
        // Keys reach these only when the focused widget doesn't use them
        // (text fields keep their own arrows, Delete and so on).
        KeyBinding { keys: @keys(F5); activated => { root.refresh(); } }
        KeyBinding { keys: @keys(F1); activated => { root.open-shortcuts(); } }
        KeyBinding { keys: @keys(F6); activated => { root.cycle-pane(false); } }
        KeyBinding { keys: @keys(Shift + F6); activated => { root.cycle-pane(true); } }
        // Settings open and close with the same key (as the gear does).
        KeyBinding {
            keys: @keys(Control + ",");
            activated => {
                if root.show-settings {
                    root.close-settings(root.settings-from);
                } else {
                    root.return-pane = root.pane-of-focus();
                    root.pane-open = false;
                    root.show-settings = true;
                }
            }
        }
        KeyBinding { keys: @keys(Control + "n"); enabled: !root.show-settings; activated => { root.show-calendar = false; root.compose(); } }
        // Show / hide the folders (WinUI's pane toggle).
        KeyBinding { keys: @keys(Control + Shift + "e"); enabled: root.mail-shown && !root.ob-open; activated => { root.toggle-pane(); } }
        // Search: Ctrl+E and F3 (Outlook), Ctrl+F (Windows Mail); from
        // Settings too, which then close.
        KeyBinding { keys: @keys(Control + "e"); activated => { root.focus-search(); } }
        KeyBinding { keys: @keys(Control + "f"); activated => { root.focus-search(); } }
        KeyBinding { keys: @keys(F3); activated => { root.focus-search(); } }
        // These act on the selected message; a draft must never be replaced
        // by a stray Ctrl+R.
        KeyBinding { keys: @keys(Control + "r"); enabled: root.reading; activated => { root.reply(); } }
        KeyBinding { keys: @keys(Control + Shift + "r"); enabled: root.reading; activated => { root.reply-all(); } }
        // Ctrl+Q marks read, Ctrl+U unread (Outlook); Ctrl+Shift+F
        // forwards, Ctrl+Shift+V opens Move, Ctrl+Shift+I goes to the Inbox.
        KeyBinding { keys: @keys(Control + "q"); enabled: root.reading; activated => { root.mark-read(true); } }
        KeyBinding { keys: @keys(Control + "u"); enabled: root.reading; activated => { root.mark-read(false); } }
        KeyBinding { keys: @keys(Control + Shift + "f"); enabled: root.reading && (root.has-message || root.selected-count == 1); activated => { root.menu-respond(2); } }
        KeyBinding { keys: @keys(Control + Shift + "v"); enabled: root.reading; activated => { root.open-move(); } }
        KeyBinding {
            keys: @keys(Control + Shift + "i");
            enabled: !root.composing;
            activated => {
                if !root.mail-tab {
                    root.tab-activate(0);
                }
                root.pane-open = false;
                root.show-calendar = false;
                if root.show-settings {
                    root.close-settings(2);
                }
                root.go-inbox();
            }
        }
        KeyBinding { keys: @keys(Delete); enabled: root.reading; activated => { root.delete(); } }
        KeyBinding { keys: @keys(DownArrow); enabled: root.reading && root.mail-tab; activated => { root.select-offset(1); } }
        KeyBinding { keys: @keys(UpArrow); enabled: root.reading && root.mail-tab; activated => { root.select-offset(-1); } }
        KeyBinding { keys: @keys(Shift + DownArrow); enabled: root.reading && root.mail-tab; activated => { root.select-extend(1); } }
        KeyBinding { keys: @keys(Shift + UpArrow); enabled: root.reading && root.mail-tab; activated => { root.select-extend(-1); } }
        KeyBinding { keys: @keys(Home); enabled: root.reading && root.mail-tab; activated => { root.select-edge(false); } }
        KeyBinding { keys: @keys(End); enabled: root.reading && root.mail-tab; activated => { root.select-edge(true); } }
        KeyBinding { keys: @keys(PageDown); enabled: root.reading && root.mail-tab; activated => { root.select-offset(root.page-rows); } }
        KeyBinding { keys: @keys(PageUp); enabled: root.reading && root.mail-tab; activated => { root.select-offset(-root.page-rows); } }
        KeyBinding { keys: @keys(Return); enabled: root.reading && root.mail-tab; activated => { root.focus-page = root.open-current(); } }
        // Open the list's current message in a tab of its own.
        KeyBinding { keys: @keys(Shift + Return); enabled: root.reading && root.mail-tab && root.show-list; activated => { root.open-current-tab(); } }
        KeyBinding { keys: @keys(Control + "s"); enabled: root.reading; activated => { root.save-eml(); } }
        // Never while typing a search: these keys would reach the list.
        KeyBinding { keys: @keys(Insert); enabled: root.reading && !search.has-focus; activated => { root.toggle-flag(); } }
        // Mark as important without an Insert key (laptops); a chord, so it
        // also works from the search box.
        KeyBinding { keys: @keys(Control + Shift + "g"); enabled: root.reading; activated => { root.toggle-flag(); } }
        // The page and text fields take their own Ctrl+A and Esc first.
        KeyBinding { keys: @keys(Control + "a"); enabled: root.reading && root.mail-tab; activated => { root.select-all-rows(); } }
        // Esc closes the folder pane first, when it is open over the content.
        KeyBinding {
            keys: @keys(Escape);
            enabled: !root.ob-open && ((root.reading && root.mail-tab) || root.pane-open || root.show-settings || root.show-calendar || root.detail-only);
            activated => {
                if root.detail-only {
                    // A message window closes on Esc.
                    root.close-window();
                } else if root.pane-open {
                    root.pane-open = false;
                } else if root.show-calendar && (Cal.editing || Cal.picker > 0) {
                    // The event editor (or its date picker) closes first.
                    if Cal.picker > 0 { Cal.picker = 0; } else { Cal.ed-cancel(); }
                } else if root.show-calendar {
                    // The Calendar page closes back to the mail.
                    root.show-calendar = false;
                    root.focus-list();
                } else if root.show-settings {
                    root.close-settings(root.settings-from);
                } else {
                    root.list-escape();
                }
            }
        }
        KeyBinding { keys: @keys(Control + "z"); enabled: root.reading && root.undo-text != ""; activated => { root.undo-clicked(); } }
        // Shift+F10 or the Menu key: the row menu, under the current row.
        KeyBinding { keys: @keys(Shift + F10); enabled: root.reading && root.row-menu-ready; activated => { root.show-row-menu(); } }
        KeyBinding { keys: @keys(Menu); enabled: root.reading && root.row-menu-ready; activated => { root.show-row-menu(); } }

        // The row menu and the More menu: shown by `show()` once the
        // selection is up to date, never by a click of its own.
        row-menu := ContextMenuArea {
            enabled: false;
            // Built by Rust (`menu-opening`), each item with its
            // accelerator text after a tab.
            Menu {
                for e in root.row-menu-1: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, false); } }
                MenuSeparator { }
                for e in root.row-menu-2: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, false); } }
                MenuSeparator { }
                for e in root.row-menu-3: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, false); } }
                Menu {
                    title: @tr("Move to");
                    enabled: root.move-targets.length > 0;
                    for f in root.move-targets: MenuItem { title: f.label; activated => { root.move-to(f.id); } }
                }
                for e in root.row-menu-4: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, false); } }
                MenuSeparator { }
                for e in root.row-menu-5: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, false); } }
                if root.row-menu-6.length > 0: MenuSeparator { }
                for e in root.row-menu-6: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, false); } }
            }
        }

        // The reader's More menu: the open message's secondary commands
        // (docs/WINUI3.md "CommandBar / AppBarButton"), the view toggles
        // checked while on.
        reader-menu := ContextMenuArea {
            enabled: false;
            // Built by Rust (`menu-opening`): Forward as attachment, Move
            // to, Report junk; the view toggles (checked while on) and
            // images; the message's file commands; Show in folder.
            Menu {
                for e in root.more-menu-1: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, true); } }
                Menu {
                    title: @tr("Move to");
                    enabled: root.move-targets.length > 0;
                    for f in root.move-targets: MenuItem { title: f.label; activated => { root.move-to(f.id); } }
                }
                for e in root.more-menu-2: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, true); } }
                MenuSeparator { }
                for e in root.more-menu-3: MenuItem { title: e.title; enabled: e.enabled; checkable: e.checkable; checked: e.checked; activated => { root.run-command(e.command, true); } }
                MenuSeparator { }
                for e in root.more-menu-4: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, true); } }
                if root.more-menu-5.length > 0: MenuSeparator { }
                for e in root.more-menu-5: MenuItem { title: e.title; enabled: e.enabled; activated => { root.run-command(e.command, true); } }
            }
        }

        // The list's "..." menu: text commands on the whole view, built by
        // the Rust side as it opens (`list-menu`; `menu:list` prints it).
        list-menu := ContextMenuArea {
            enabled: false;
            Menu {
                for e in root.list-menu: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    checkable: e.checkable;
                    checked: e.checked;
                    activated => { root.list-command(e.command); }
                }
            }
        }

        // The search scope (`menu:scope` prints it): scope words, never a
        // view name.
        scope-menu := ContextMenuArea {
            enabled: false;
            Menu {
                // The marks are set as the menu opens (a click on a
                // checkable item writes its mark, which would end a binding).
                MenuItem { title: root.scope-first; checkable: true; checked <=> root.scope-mark-this; activated => { root.set-search-all(false); } }
                MenuItem { title: Tr.all-folders(); checkable: true; checked <=> root.scope-mark-all; activated => { root.set-search-all(true); } }
            }
        }

        // A tab's menu (right-click, Shift+F10 on the strip).
        tab-menu := ContextMenuArea {
            enabled: false;
            Menu {
                MenuItem { title: @tr("Close tab"); enabled: root.menu-tab > 0; activated => { root.tab-command(root.menu-tab, 0); } }
                MenuItem { title: @tr("Close other tabs"); enabled: root.tabs.length > 2 || (root.tabs.length > 1 && root.menu-tab == 0); activated => { root.tab-command(root.menu-tab, 1); } }
                MenuItem { title: @tr("Close tabs to the right"); enabled: root.menu-tab-right; activated => { root.tab-command(root.menu-tab, 2); } }
                MenuSeparator { }
                MenuItem { title: @tr("Open in new window"); enabled: root.menu-tab-message; activated => { root.tab-command(root.menu-tab, 3); } }
                MenuItem { title: @tr("Reopen closed tab"); enabled: root.tabs-reopenable; activated => { root.tab-command(root.menu-tab, 4); } }
            }
        }
        // The strip's "All tabs" menu: every tab, the active one checked.
        all-menu := ContextMenuArea {
            enabled: false;
            Menu {
                for t[i] in root.tabs: MenuItem {
                    title: t.kind == 0 ? @tr("tab" => "Mail") : t.title;
                    checkable: true;
                    checked: i == root.active-tab;
                    activated => { root.tab-activate(i); }
                }
            }
        }

        // A draft's or an Outbox row's menu (right-click, Shift+F10).
        draft-menu := ContextMenuArea {
            enabled: false;
            Menu {
                MenuItem { title: @tr("Open"); activated => { root.focus-page = root.open-current(); } }
                MenuItem { title: @tr("Discard"); activated => { root.delete(); } }
            }
        }

        // The folder pane's row menu (`show-nav-menu`), built by the Rust
        // side for that row whatever view is open (`menu:pane` and
        // `menu:rail` print it).
        nav-menu := ContextMenuArea {
            enabled: false;
            Menu {
                for e in root.nav-menu-main: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    activated => { root.run-nav-command(e); }
                }
                if root.nav-menu-extra.length > 0: MenuSeparator { }
                for e in root.nav-menu-extra: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    activated => { root.run-nav-command(e); }
                }
            }
        }

        // ---- the title bar (docs/WINUI3.md "Title bar"), on the layer so
        // it and the folder pane read as one surface: the icon and title,
        // the search centred, the caption buttons; under the system caption
        // the search alone. First in the tree: the search is the first Tab
        // stop.
        title-bar := Rectangle {
            visible: !root.detail-only;
            property <bool> custom: root.custom-title-bar;
            // Room kept clear at each end: the icon and title, the caption
            // buttons and 48 px of drag space.
            property <length> lead: !self.custom ? Theme.s4 : root.compact ? 44px : 44px + ceil(app-title.preferred-width / 1px) * 1px + Theme.s4;
            property <length> trail: self.custom ? 3 * 46px + 48px : Theme.s4;
            property <length> gap: Theme.s2;
            property <length> scope-w: scope-box.width;
            property <length> room: self.width - self.gap - self.scope-w;
            // The search box: 220 to 600 px, centred while the ends allow,
            // after the icon in the compact layout; below 720 px down to
            // 120 px, so the 48 px of drag space stays at 500 px.
            property <length> search-w: root.compact
                ? clamp(self.room - self.lead - self.trail, root.one-pane ? 120px : 220px, 600px)
                : clamp(self.room - 2 * max(self.lead, self.trail), 220px, 600px);
            property <length> group-x: root.compact ? self.lead : max(self.lead, (self.width - self.search-w - self.gap - self.scope-w) / 2);
            x: 0;
            y: 0;
            width: root.width;
            height: root.bar-height;
            background: Theme.layer;
            // No search before the first account (nothing to search): the
            // whole bar drags (docs/WINUI3.md "Title bar").
            property <bool> searchable: root.mail-shown;
            function push() {
                if self.searchable {
                    root.title-bar-regions(self.height, [
                        { x: search.x, y: search.y, width: search.width, height: search.height },
                        { x: scope-box.x, y: scope-box.y, width: scope-box.width, height: scope-box.height },
                    ], root.popup-open);
                } else {
                    root.title-bar-regions(self.height, [], root.popup-open);
                }
            }
            init => { self.push(); }
            changed searchable => { self.push(); }
            changed height => { self.push(); }
            changed search-w => { self.push(); }
            changed group-x => { self.push(); }
            changed scope-w => { self.push(); }
            if root.top-border && title-bar.custom && !root.window-maximized: Rectangle {
                y: 0;
                height: 1px;
                background: Theme.stroke;
            }
            if title-bar.custom: Image {
                x: 16px;
                y: 16px;
                width: 16px;
                height: 16px;
                source: root.app-icon;
                opacity: root.window-active ? 1 : 0.5;
                accessible-role: none;
            }
            app-title := Text {
                // Collapses in the compact layout to make room for the
                // search; with no account there is no search, so it stays.
                visible: title-bar.custom && (!root.compact || !title-bar.searchable);
                x: 44px;
                y: 0;
                height: 48px;
                text: "Komorebi";
                font-size: Theme.caption;
                color: root.window-active ? Theme.text : Theme.text-3;
                vertical-alignment: center;
                accessible-role: none;
            }
            search := SearchBox {
                visible: title-bar.searchable;
                x: title-bar.group-x;
                y: (title-bar.height - self.height) / 2;
                width: title-bar.search-w;
                placeholder: Tr.search-in(root.search-view);
                text <=> root.search-text;
                edited(t) => { root.search-edited(t); }
                // A click: no focus ring on the row it hands the keys to.
                query => {
                    Focus.keyboard = false;
                    list-keys.focus();
                }
                changed has-focus => {
                    if self.has-focus {
                        root.search-focused();
                    }
                }
            }
            scope-box := ScopeBox {
                visible: title-bar.searchable;
                x: title-bar.group-x + title-bar.search-w + title-bar.gap;
                y: search.y + (search.height - self.height) / 2;
                text: root.search-all ? Tr.all-folders() : root.scope-first;
                words: [Tr.scope-this-folder(), Tr.scope-these-inboxes(), Tr.all-folders()];
                // Drafts and the Outbox search themselves only.
                enabled: root.selected-folder >= 0;
                tooltip: @tr("Search scope");
                clicked => {
                    root.search-focused();
                    root.scope-mark-this = !root.search-all;
                    root.scope-mark-all = root.search-all;
                    scope-menu.show({ x: self.absolute-position.x, y: self.absolute-position.y + self.height + Theme.s1 });
                }
            }
            if title-bar.custom: HorizontalLayout {
                x: root.width - 3 * 46px;
                y: 0;
                width: 3 * 46px;
                height: 48px;
                CaptionButton {
                    icon: Icons.chrome-minimize;
                    label: @tr("Minimize");
                    hover: root.caption-hover == 1;
                    pressed: root.caption-pressed == 1;
                    active: root.window-active;
                    activate => { root.caption-command(1); }
                }
                CaptionButton {
                    icon: root.window-maximized ? Icons.chrome-restore : Icons.chrome-maximize;
                    label: root.window-maximized ? @tr("Restore") : @tr("Maximize");
                    hover: root.caption-hover == 2;
                    pressed: root.caption-pressed == 2;
                    active: root.window-active;
                    activate => { root.caption-command(2); }
                }
                CaptionButton {
                    icon: Icons.chrome-close;
                    label: @tr("Close");
                    close: true;
                    hover: root.caption-hover == 3;
                    pressed: root.caption-pressed == 3;
                    active: root.window-active;
                    activate => { root.caption-command(3); }
                }
            }
        }

        // ---- the content area (docs/WINUI3.md "NavigationView, left"):
        // one card under the list and the reader, flush with the window's
        // right and bottom edges, its top-left corner rounded and its top
        // and left edges outlined.
        Rectangle {
            x: root.nav-width;
            y: root.content-top;
            width: root.width - self.x;
            height: root.height - self.y;
            // Square at the window's edge (a message or draft tab).
            border-top-left-radius: root.nav-width > 0 ? Theme.radius-lg : 0;
            background: Theme.card-stroke;
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 1px;
                height: parent.height - 1px;
                border-top-left-radius: root.nav-width > 0 ? Theme.radius-lg - 1px : 0;
                background: Theme.card;
            }
        }

        // ---- the tab strip (docs/WINUI3.md "TabView"): over the content
        // card it heads, from two tabs on; the selected tab joins the card.
        strip := TabStrip {
            visible: root.tabs-shown;
            x: root.nav-width + Theme.s2;
            y: root.bar-height;
            z: 3;
            width: root.width - self.x - Theme.s1;
            tabs: root.tabs;
            active: root.active-tab;
            narrow: root.one-pane;
            activate(i) => { root.tab-activate(i); }
            close(i) => { root.tab-close(i); }
            moved(from, to) => { root.tab-move(from, to); }
            menu(i, x, y) => {
                root.menu-tab = i;
                root.menu-tab-message = root.tabs[i].kind != 0;
                root.menu-tab-right = i + 1 < root.tabs.length;
                tab-menu.show({ x: x, y: y });
            }
            all-tabs(x, y) => { all-menu.show({ x: x, y: y }); }
        }

        HorizontalLayout {
            padding-top: root.content-top + 1px;
            // Room for the folder pane (drawn over the content, below).
            Rectangle { width: root.nav-width + 1px; }

            // ---- message list (hidden under Settings: no Tab stops, and
            // kept as it was for when they close)
            list-col := Rectangle {
                visible: root.show-list;
                min-width: root.show-list && root.show-reader ? root.list-fixed : 0;
                max-width: !root.show-list ? 0 : root.show-reader ? root.list-fixed : 100000px;
                horizontal-stretch: root.show-reader ? 0 : 1;
                clip: true;
        VerticalLayout {
                    // 52 px tall, its 32 px buttons centred (the title
                    // and a folder's account under it fill the height).
                    HorizontalLayout {
                        padding-top: root.list-subtitle != "" ? 4px : 10px;
                        padding-bottom: root.list-subtitle != "" ? 4px : 10px;
                        padding-left: Theme.s4;
                        padding-right: Theme.s2;
                        spacing: Theme.s1;
                        // The view's name, and a folder's account under it.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Heading { text: root.list-title; }
                            if root.list-subtitle != "": Text {
                                text: root.list-subtitle;
                                font-size: Theme.caption;
                                color: Theme.text-2;
                                overflow: elide;
                            }
                        }
                        // A sync that lasts a second shows a 16 px ring
                        // (FLUENT2 "Wait UX").
                        if root.syncing: Rectangle {
                            width: 32px;
                            sync-ring := ProgressRing { accessible-label: @tr("Syncing\u{a0}…"); }
                            sync-ta := TouchArea { }
                            TipTimer {
                                text: sync-ring.due ? @tr("Syncing\u{a0}…") : "";
                                hover: sync-ta.has-hover;
                            }
                        }
                        if !root.syncing && root.last-updated != "" && !root.compact: Text {
                            text: root.last-updated;
                            font-size: Theme.caption;
                            color: Theme.text-2;
                            vertical-alignment: center;
                        }
                        refresh-btn := IconButton {
                            icon: Icons.refresh;
                            tooltip: root.last-updated == "" ? @tr("Refresh (F5)") : @tr("Refresh (F5). {0}", root.last-updated);
                            width: 32px;
                            enabled: !root.syncing;
                            clicked => { root.refresh(); }
                        }
                        // Its menu holds text commands only (Mark all as
                        // read, Select messages): no bulk action hides
                        // behind an icon.
                        list-more := IconButton {
                            icon: Icons.more;
                            tooltip: @tr("More actions");
                            description: @tr("Mark all as read, Select messages");
                            width: 32px;
                            // Drafts and the Outbox have no folder actions.
                            enabled: root.selected-folder >= 0;
                            clicked => {
                                root.list-menu-opening();
                                list-menu.show({ x: self.absolute-position.x, y: self.absolute-position.y + self.height });
                            }
                        }
                    }
                    // The filters (docs/WINUI3.md "SelectorBar"); items pad
                    // 12, so "All" lines up with the heading.
                    if root.selected-folder >= 0 && !root.list-drafts: HorizontalLayout {
                        padding-left: Theme.s1;
                        SelectorBar {
                            items: [@tr("All"), @tr("Unread"), @tr("filter" => "Important")];
                            selected <=> root.list-filter;
                            picked(i) => { root.set-filter(i); }
                        }
                    }
                    // While searching: what was found where, and the ways on
                    // (docs/WINUI3.md "AutoSuggestBox"), announced politely.
                    if root.search-text != "": VerticalLayout {
                        vertical-stretch: 0;
                        // The links' text (11 px into each) lines up with
                        // the count's, and with the heading.
                        padding-left: Theme.s4 - 11px;
                        padding-right: Theme.s3;
                        padding-bottom: Theme.s1;
                        HorizontalLayout {
                            padding-left: 11px;
                            Text {
                                text: root.search-all && root.selected-folder >= 0 ? Tr.results-all(root.result-count) : Tr.results-in(root.result-count, root.search-view);
                                font-size: Theme.caption;
                                color: Theme.text-2;
                                wrap: word-wrap;
                                accessible-live-region: polite;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 0;
                            if !root.search-all && root.selected-folder >= 0: HyperlinkButton {
                                text: @tr("Search all folders");
                                clicked => { root.set-search-all(true); }
                            }
                            HyperlinkButton {
                                text: @tr("Clear search");
                                clicked => { root.clear-search(); }
                            }
                        }
                    }
                    // An automatic check found a newer version: a quiet
                    // bar (docs/WINUI3.md "InfoBar"), nothing installed
                    // without the press; Later (or its close) hides it
                    // until tomorrow.
                    if root.up-banner: HorizontalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        padding-top: Theme.s1;
                        padding-bottom: Theme.s2;
                        InfoBar {
                            severity: Severity.info;
                            message: @tr("Version {0} is available.", root.up-version);
                            button1: @tr("Download and install");
                            button2: @tr("update" => "Later");
                            close-label: @tr("Hide the update bar until tomorrow");
                            button-clicked(i) => { root.update-action(i == 0 ? 1 : 2); }
                            closed => { root.update-action(2); }
                        }
                    }
                    // The status line (docs/WINUI3.md "InfoBar"): at the top
                    // of the list it concerns, never over a row; its action
                    // under the message, which the narrow list leaves room for.
                    if root.status != "": HorizontalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        padding-top: Theme.s1;
                        padding-bottom: Theme.s2;
                        StatusBar {
                            text: root.status;
                            severity: root.status-severity;
                            action: root.status-action;
                            closable: root.status-closable;
                            act => { root.status-action-clicked(); }
                            closed => { root.dismiss-status(); }
                            escaped => { keys.focus(); }
                        }
                    }
                    Divider { }
                    // The list's Tab stop; its keys are the bindings above.
                    list-keys := FocusScope {
                        vertical-stretch: 1;
                        accessible-role: AccessibleRole.list;
                        accessible-label: @tr("Messages");
                        accessible-item-count: root.rows.length;
                        KeyBinding { keys: @keys(Backspace); enabled: root.backspace-archives; activated => { root.archive(); } }
                        // Screen readers follow the current row: an index among
                        // the rows built, which start at the top one in view.
                        accessible-delegate-focus: root.selected-index < 0 ? -1 : max(0, root.selected-index - floor(-list.content-y / Theme.row-height));
                        list := ListView {
                            width: 100%;
                            height: 100%;
                            accessible-role: none;
                            // WinUI's thumb over the rows instead (below).
                            vertical-scrollbar-policy: always-off;
                            for row[i] in root.rows: MailItem {
                                mail: row;
                                selected: row.selected || row.id == root.selected-id;
                                ring: list-keys.has-focus && Focus.keyboard && i == root.selected-index;
                                checks: root.list-checks;
                                quick-actions: root.selected-folder >= 0 && !root.list-drafts && root.reading;
                                context(x, y) => {
                                    if root.message-context(row.id) {
                                        keys.focus();
                                        root.show-row-menu-at(x, y);
                                    }
                                }
                                // With the check boxes on, a click checks the
                                // row as Ctrl+click does (Outlook).
                                clicked(ctrl, shift) => {
                                    keys.focus();
                                    if ctrl || (root.select-mode && !shift) {
                                        root.message-toggled(row.id);
                                    } else if shift {
                                        root.message-extended(row.id);
                                    } else {
                                        root.message-selected(row.id);
                                    }
                                }
                                check => {
                                    keys.focus();
                                    root.message-toggled(row.id);
                                }
                                // The list keeps the keys; the row is not
                                // opened or selected.
                                quick(k) => { root.message-quick(row.id, k); }
                                // A message in a tab of its own (not drafts
                                // or Outbox rows, which open in place).
                                double-clicked => {
                                    if root.selected-folder >= 0 {
                                        root.open-tab(row.id, false);
                                    }
                                }
                                middle-clicked => {
                                    if root.selected-folder >= 0 {
                                        root.open-tab(row.id, true);
                                    }
                                }
                            }
                        }
                        // The scroll bar (docs/WINUI3.md "ScrollBar"), from
                        // the rows' total height, not the list's estimate.
                        ScrollThumb {
                            x: parent.width - self.width;
                            content-y <=> list.content-y;
                            total: root.rows.length * Theme.row-height;
                            visible-height: list.visible-height;
                        }
                        // With no current row, the ring goes round the list.
                        FocusRing {
                            inset: 1px;
                            shown: list-keys.has-focus && root.selected-index < 0;
                        }
                        // The Undo offer (docs/WINUI3.md "InfoBar", Undo at
                        // the bottom of the list): over the last rows, never
                        // moving them, in a slot of its own.
                        if root.undo-text != "": UndoOffer {
                            x: Theme.s3;
                            y: parent.height - self.height - Theme.s3;
                            z: 2;
                            width: parent.width - 2 * Theme.s3;
                            text: root.undo-text;
                            hold(h) => { root.undo-hold(h); }
                            undo => { root.undo-clicked(); }
                        }
                        // An empty list says why, centred, with one way out
                        // (FLUENT2 "Onboarding": explain).
                        if root.rows.length == 0: empty := VerticalLayout {
                            property <bool> searching: root.search-text != "";
                            // While searching, the results line above has the
                            // ways on (Search all folders, Clear search).
                            property <string> action: !self.searching && root.list-filter != 0 && root.selected-folder >= 0 ? @tr("Show all") : "";
                            width: 100%;
                            height: 100%;
                            alignment: center;
                            padding-left: Theme.s4;
                            padding-right: Theme.s4;
                            spacing: Theme.s2;
                            Icon {
                                text: empty.searching ? Icons.search : root.list-filter == 2 ? Icons.flag : root.list-filter == 1 ? Icons.read : Icons.mail;
                                font-size: 32px;
                                color: Theme.text-disabled;
                            }
                            Text {
                                text: root.list-empty;
                                font-size: Theme.body;
                                color: Theme.text-2;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                accessible-live-region: polite;
                            }
                            // A new account's first download (docs/WINUI3.md
                            // "ListView item", empty list).
                            if root.list-fresh > 0: HorizontalLayout {
                                alignment: center;
                                padding-top: Theme.s2;
                                ProgressBar {
                                    width: 200px;
                                    delay: 0ms;
                                    indeterminate: root.list-fresh == 1;
                                    value: root.list-fresh-value;
                                    accessible-label: @tr("Downloading your mail");
                                }
                            }
                            if empty.searching: Text {
                                text: @tr("Searches subject, people and preview of downloaded mail.");
                                font-size: Theme.caption;
                                color: Theme.text-2;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            if empty.action != "": HorizontalLayout {
                                alignment: center;
                                HyperlinkButton {
                                    text: empty.action;
                                    clicked => { root.set-filter(0); }
                                }
                            }
                        }
                    }
                }
                // With no reader column (the list stretched, or one pane), the
                // drop overlay covers the list instead.
                if root.file-hover && root.accounts.length > 0 && !root.show-reader: DropOverlay {
                    z: 5;
                    composing: false;
                }
            }

            Rectangle {
                visible: root.show-list && root.show-reader;
                width: self.visible ? 1px : 0;
                background: Theme.stroke;
            }

            // A message or draft tab: centred at a reading width.
            Rectangle { width: root.show-reader ? root.tab-gutter : 0; }
            // ---- reader / composer
            Rectangle {
                visible: root.show-reader;
                max-width: root.show-reader ? 100000px : 0;
                horizontal-stretch: 1;
                clip: true;
                // Files dragged over the window: the drop overlay below says
                // where they go (docs/WINUI3.md "Drag and drop").

                // Shortcuts a field would otherwise take (Ctrl+Enter in a
                // line field, Alt+S typing an "s") are caught before the
                // field sees them; Esc arrives after the field ignores it.
                if root.composing: composer := FocusScope {
                    // A click on its padding focuses it, so the keys still work.
                    focus-on-tab-navigation: false;
                    // The link field (Ctrl+K), and the body's selection when
                    // it opened.
                    property <bool> link-open;
                    property <bool> link-error;
                    property <int> link-anchor;
                    property <int> link-cursor;
                    // The formatting toolbar moves its font, size, indent
                    // and align into More below 1040 px (and when the row
                    // would not fit, as Portuguese labels run longer).
                    property <bool> compact-bar: root.width < 1040px || self.width < 940px;
                    // Narrower still: the importance toggles go into More too,
                    // and then Quote and Clear formatting.
                    property <bool> narrow-bar: self.width < 700px;
                    property <bool> tight-bar: self.width < 560px;
                    // The label column: as wide as its longest label at
                    // the current text size (64 px at least), so the
                    // fields line up and no label is cut.
                    property <length> label-w: max(64px, max(label-measure.preferred-width, link-measure.preferred-width));
                    property <length> field-x: Theme.s4 + self.label-w + Theme.s2;
                    // Where the suggestions show: under the address field
                    // typed in last (`bottom`: its lower edge in the window).
                    property <length> suggest-y;
                    function place(bottom: length) {
                        self.suggest-y = bottom - self.absolute-position.y + Theme.s1;
                    }
                    function show(edit: BodyEdit) {
                        if edit.done {
                            body.set-selection-offsets(edit.anchor, edit.cursor);
                        }
                        body.focus();
                    }
                    function format(action: FormatAction) {
                        self.show(root.c-format(action, body.anchor, body.cursor));
                    }
                    function open-link() {
                        self.link-anchor = body.anchor;
                        self.link-cursor = body.cursor;
                        self.link-error = false;
                        self.link-open = true;
                    }
                    function close-link() {
                        self.link-open = false;
                        if root.c-rich {
                            rbody.focus-input();
                            return;
                        }
                        body.set-selection-offsets(self.link-anchor, self.link-cursor);
                        body.focus();
                    }
                    function insert-link(url: string) {
                        if url == "" {
                            self.close-link();
                            return;
                        }
                        if root.c-rich {
                            if !Rich.link(0, url) {
                                self.link-error = true;
                                return;
                            }
                            self.link-open = false;
                            rbody.focus-input();
                            return;
                        }
                        let edit = root.c-link(url, self.link-anchor, self.link-cursor);
                        if !edit.done {
                            self.link-error = true;
                            return;
                        }
                        self.link-open = false;
                        self.show(edit);
                    }
                    // A plain-text body has no formatting keys; Ctrl+Z right
                    // after a switch to plain text brings the formatted
                    // message back (the field's own undo otherwise).
                    function format-key(e: KeyEvent) -> EventResult {
                        if !e.modifiers.control || e.modifiers.alt || e.modifiers.shift {
                            return reject;
                        }
                        if e.text == "z" || e.text == "Z" {
                            let edit = root.c-unformat();
                            if edit.done {
                                self.show(edit);
                                return accept;
                            }
                            if root.c-rich {
                                return accept;
                            }
                        }
                        return reject;
                    }
                    // Up/Down, Enter, Tab and Esc work the recipient
                    // suggestions while they show; moving the caret closes
                    // them.
                    function suggest-key(e: KeyEvent) -> EventResult {
                        let n = root.c-suggestions.length;
                        if n == 0 || e.modifiers.control || e.modifiers.alt {
                            return reject;
                        }
                        if e.text == Key.DownArrow {
                            root.c-suggest-index = mod(root.c-suggest-index + 1, n);
                            return accept;
                        }
                        if e.text == Key.UpArrow {
                            root.c-suggest-index = mod(root.c-suggest-index + n - 1, n);
                            return accept;
                        }
                        if (e.text == Key.Return || e.text == Key.Tab) && !e.modifiers.shift {
                            root.c-suggest-accept(root.c-suggest-index);
                            return accept;
                        }
                        if e.text == Key.Escape {
                            root.c-suggest-close();
                            return accept;
                        }
                        if e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == Key.Home || e.text == Key.End {
                            root.c-suggest-close();
                        }
                        return reject;
                    }
                    function shortcut(e: KeyEvent) -> EventResult {
                        if e.modifiers.control && !e.modifiers.alt && e.text == Key.Return {
                            root.send();
                            return accept;
                        }
                        if e.modifiers.alt && !e.modifiers.control && (e.text == "s" || e.text == "S") {
                            root.send();
                            return accept;
                        }
                        if e.modifiers.control && e.modifiers.shift && !e.modifiers.alt {
                            if e.text == "c" || e.text == "C" {
                                root.c-reveal(ComposeField.cc);
                                return accept;
                            }
                            if e.text == "b" || e.text == "B" {
                                root.c-reveal(ComposeField.bcc);
                                return accept;
                            }
                            if e.text == "a" || e.text == "A" {
                                root.attach();
                                return accept;
                            }
                        }
                        return reject;
                    }
                    capture-key-pressed(e) => {
                        if self.suggest-key(e) == EventResult.accept {
                            return accept;
                        }
                        // Files on the clipboard are attached; text pastes.
                        if e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && (e.text == "v" || e.text == "V") && root.c-paste-files() {
                            return accept;
                        }
                        self.shortcut(e)
                    }
                    key-pressed(e) => { self.shortcut(e) }
                    KeyBinding { keys: @keys(Escape); activated => { root.c-close(); } }

                    // The Signature menu (`menu:signature` prints it): every
                    // signature, None, then Manage signatures.
                    sig-menu := ContextMenuArea {
                        x: 0;
                        y: 0;
                        width: 0;
                        height: 0;
                        enabled: false;
                        Menu {
                            for n[i] in Rich.sig-names: MenuItem {
                                title: n;
                                checkable: true;
                                checked: Rich.sig-current == i;
                                activated => { Rich.pick-signature(i); }
                            }
                            MenuItem {
                                title: @tr("signature" => "None");
                                checkable: true;
                                checked: Rich.sig-current == -1;
                                activated => { Rich.pick-signature(-1); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Manage signatures…");
                                activated => { Rich.pick-signature(-2); }
                            }
                        }
                    }
                    // More: what the narrow toolbar leaves out, Preview, and
                    // the message's format.
                    more-menu := ContextMenuArea {
                        x: 0;
                        y: 0;
                        width: 0;
                        height: 0;
                        enabled: false;
                        Menu {
                            if root.c-rich && composer.compact-bar: Menu {
                                title: @tr("Font");
                                for f[i] in Rich.fonts: MenuItem {
                                    title: f;
                                    checkable: true;
                                    checked: Rich.body-fmt.font == i;
                                    activated => { Rich.act(0, EdAction.font, i); }
                                }
                            }
                            if root.c-rich && composer.compact-bar: Menu {
                                title: @tr("Font size");
                                for s[i] in Rich.sizes: MenuItem {
                                    title: s;
                                    checkable: true;
                                    checked: Rich.body-fmt.size == i;
                                    activated => { Rich.act(0, EdAction.size, i); }
                                }
                            }
                            if root.c-rich && composer.compact-bar: Menu {
                                title: @tr("Align");
                                for a in 4: MenuItem {
                                    title: Rich.align-name(a);
                                    checkable: true;
                                    checked: Rich.body-fmt.align == a;
                                    activated => { Rich.act(0, EdAction.align, a); }
                                }
                            }
                            if root.c-rich && composer.compact-bar: MenuItem {
                                title: @tr("Decrease indent");
                                activated => { Rich.act(0, EdAction.outdent, 0); }
                            }
                            if root.c-rich && composer.compact-bar: MenuItem {
                                title: @tr("Increase indent");
                                activated => { Rich.act(0, EdAction.indent, 0); }
                            }
                            if root.c-rich && composer.tight-bar: MenuItem {
                                title: @tr("Quote");
                                activated => { Rich.act(0, EdAction.quote, 0); }
                            }
                            if root.c-rich && composer.tight-bar: MenuItem {
                                title: @tr("Clear formatting");
                                activated => { Rich.act(0, EdAction.clear, 0); }
                            }
                            if root.c-rich && composer.compact-bar: MenuSeparator { }
                            if composer.narrow-bar: MenuItem {
                                title: @tr("High importance");
                                checkable: true;
                                checked: root.c-importance == 1;
                                activated => { root.c-set-importance(root.c-importance == 1 ? 0 : 1); }
                            }
                            if composer.narrow-bar: MenuItem {
                                title: @tr("Low importance");
                                checkable: true;
                                checked: root.c-importance == 2;
                                activated => { root.c-set-importance(root.c-importance == 2 ? 0 : 2); }
                            }
                            if composer.narrow-bar: MenuSeparator { }
                            MenuItem {
                                title: @tr("Preview");
                                checkable: true;
                                checked: root.c-preview;
                                activated => { root.c-preview = !root.c-preview; }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: root.c-rich ? @tr("Switch to plain text") : @tr("Switch to formatted text");
                                activated => {
                                    if root.c-rich {
                                        Rich.plain-ask = true;
                                    } else {
                                        Rich.set-rich(true);
                                    }
                                }
                            }
                        }
                    }

                    label-measure := Text {
                        text: @tr("Subject");
                        font-size: Theme.body;
                        visible: false;
                        accessible-role: none;
                    }
                    link-measure := Text {
                        text: @tr("Link");
                        font-size: Theme.body;
                        visible: false;
                        accessible-role: none;
                    }

                    VerticalLayout {
                        padding: Theme.s4;
                        spacing: Theme.s2;
                        HorizontalLayout {
                            spacing: Theme.s2;
                            // The title, and under it when the draft was last
                            // saved (every save refreshes it).
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Heading { text: root.c-title; }
                                if root.c-saved != "": Text {
                                    text: root.c-saved;
                                    font-size: Theme.caption;
                                    color: Theme.text-2;
                                    overflow: elide;
                                }
                            }
                            // Narrow: Attach goes icon-only first; Discard
                            // and Send keep their labels.
                            IconButton { icon: Icons.attach; label: root.compact ? "" : @tr("Attach"); tooltip: @tr("Attach (Ctrl+Shift+A)"); clicked => { root.attach(); } }
                            IconButton { icon: Icons.delete; label: @tr("Discard"); tooltip: @tr("Discard"); clicked => { root.discard(); } }
                            // Always on: pressed too early, the field at fault
                            // says why under it and takes the focus.
                            Button {
                                accent: true;
                                icon: Icons.send;
                                label: @tr("Send");
                                tooltip: @tr("Send (Ctrl+Enter)");
                                description: root.c-send-reason;
                                clicked => { root.send(); }
                            }
                            // Close keeps the draft (saved here and on the
                            // server), as Esc does.
                            IconButton { icon: Icons.dismiss; tooltip: @tr("Close (Esc)"); description: @tr("Saves the draft in Drafts"); width: 32px; clicked => { root.c-close(); } }
                        }
                        // The send guards ask once; editing the draft dismisses it.
                        if root.c-guard != "": VerticalLayout {
                            InfoBar {
                                severity: Severity.caution;
                                message: root.c-guard;
                                accessible-live-region: assertive;
                                action-text: @tr("Send anyway");
                                close-label: @tr("Keep editing");
                                action => { root.c-send-anyway(); }
                                closed => { root.c-guard = ""; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            FieldLabel { text: @tr("From"); width: composer.label-w; }
                            // Our ComboBox (ui/widgets.slint).
                            Rectangle {
                                horizontal-stretch: 1;
                                ComboBox {
                                    width: 100%;
                                    height: 100%;
                                    model: root.c-from-options;
                                    current-index <=> root.c-from-index;
                                    accessible-label: @tr("From");
                                    selected => { root.c-from-changed(self.current-index); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            FieldLabel { text: @tr("To"); width: composer.label-w; }
                            // Cc and Bcc are links at the field's end, so
                            // every field ends at the same edge.
                            Rectangle {
                                horizontal-stretch: 1;
                                height: to-field.height;
                                to-field := RecipientField {
                                    property <int> focus-seq: root.c-focus-seq;
                                    // F6 into the composer lands here.
                                    property <int> pane: root.pane-seq;
                                    changed pane => { self.focus(); }
                                    width: 100%;
                                    end-room: cc-links.width;
                                    text <=> root.c-to;
                                    accessible-label: @tr("To");
                                    accessible-description: root.c-to-error;
                                    // The suggestions this brings show under it (placed after
                                    // the edit, which may close the guard bar above).
                                    edited(t) => {
                                        root.c-edited(ComposeField.to, t);
                                        composer.place(self.absolute-position.y + self.height);
                                    }
                                    changed has-focus => { if !self.has-focus { root.c-left(ComposeField.to); } }
                                    changed focus-seq => { if root.c-focus == ComposeField.to { self.focus(); } }
                                    property <int> caret-seq: root.c-caret-seq;
                                    changed caret-seq => {
                                        if root.c-focus == ComposeField.to {
                                            self.focus();
                                            self.caret-to-end();
                                        }
                                    }
                                    init => { if root.c-focus == ComposeField.to { self.focus(); } }
                                }
                                cc-links := HorizontalLayout {
                                    x: parent.width - self.width - Theme.s1;
                                    y: Theme.s1;
                                    width: self.preferred-width;
                                    height: parent.height - 2 * Theme.s1;
                                    if !root.c-show-cc: HorizontalLayout {
                                        HyperlinkButton {
                                            text: @tr("Cc");
                                            label: @tr("Add Cc (Ctrl+Shift+C)");
                                            height: parent.height;
                                            clicked => { root.c-reveal(ComposeField.cc); }
                                        }
                                        HyperlinkButton {
                                            text: @tr("Bcc");
                                            label: @tr("Add Bcc (Ctrl+Shift+B)");
                                            height: parent.height;
                                            clicked => { root.c-reveal(ComposeField.bcc); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.c-to-error != "": VerticalLayout { FieldError { text: root.c-to-error; indent: composer.label-w + Theme.s2; live: AccessibleLiveness.assertive; } }
                        if root.c-show-cc: HorizontalLayout {
                            spacing: Theme.s2;
                            FieldLabel { text: @tr("Cc"); width: composer.label-w; }
                            RecipientField {
                                property <int> focus-seq: root.c-focus-seq;
                                text <=> root.c-cc;
                                accessible-label: @tr("Cc");
                                accessible-description: root.c-cc-error;
                                // The suggestions this brings show under it.
                                edited(t) => {
                                    root.c-edited(ComposeField.cc, t);
                                    composer.place(self.absolute-position.y + self.height);
                                }
                                changed has-focus => { if !self.has-focus { root.c-left(ComposeField.cc); } }
                                changed focus-seq => { if root.c-focus == ComposeField.cc { self.focus(); } }
                                property <int> caret-seq: root.c-caret-seq;
                                changed caret-seq => {
                                    if root.c-focus == ComposeField.cc {
                                        self.focus();
                                        self.caret-to-end();
                                    }
                                }
                                init => { if root.c-focus == ComposeField.cc { self.focus(); } }
                            }
                        }
                        if root.c-show-cc && root.c-cc-error != "": VerticalLayout { FieldError { text: root.c-cc-error; indent: composer.label-w + Theme.s2; } }
                        if root.c-show-cc: HorizontalLayout {
                            spacing: Theme.s2;
                            FieldLabel { text: @tr("Bcc"); width: composer.label-w; }
                            RecipientField {
                                property <int> focus-seq: root.c-focus-seq;
                                text <=> root.c-bcc;
                                accessible-label: @tr("Bcc");
                                accessible-description: root.c-bcc-error;
                                // The suggestions this brings show under it.
                                edited(t) => {
                                    root.c-edited(ComposeField.bcc, t);
                                    composer.place(self.absolute-position.y + self.height);
                                }
                                changed has-focus => { if !self.has-focus { root.c-left(ComposeField.bcc); } }
                                changed focus-seq => { if root.c-focus == ComposeField.bcc { self.focus(); } }
                                property <int> caret-seq: root.c-caret-seq;
                                changed caret-seq => {
                                    if root.c-focus == ComposeField.bcc {
                                        self.focus();
                                        self.caret-to-end();
                                    }
                                }
                                init => { if root.c-focus == ComposeField.bcc { self.focus(); } }
                            }
                        }
                        if root.c-show-cc && root.c-bcc-error != "": VerticalLayout { FieldError { text: root.c-bcc-error; indent: composer.label-w + Theme.s2; } }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            FieldLabel { text: @tr("Subject"); width: composer.label-w; }
                            TextField {
                                text <=> root.c-subject;
                                accessible-label: @tr("Subject");
                                edited(t) => { root.c-edited(ComposeField.subject, t); }
                            }
                        }
                        // Near or over the size limit: Caution or Critical,
                        // with its icon (never colour alone).
                        if root.c-attachments.length > 0: HorizontalLayout {
                            spacing: root.c-attach-level > 0 ? Theme.s1 : 0;
                            Icon {
                                text: root.c-attach-level == 2 ? Icons.error : Icons.warning;
                                font-size: 12px;
                                color: root.c-attach-level == 2 ? Theme.danger : Theme.warning;
                                width: root.c-attach-level > 0 ? 16px : 0;
                                visible: root.c-attach-level > 0;
                            }
                            Text {
                                text: root.c-attach-total;
                                font-size: Theme.caption;
                                color: root.c-attach-level == 2 ? Theme.danger : root.c-attach-level == 1 ? Theme.warning : Theme.text-2;
                                horizontal-stretch: 1;
                            }
                        }
                        // The chips wrap, as many to a row as fit.
                        if root.c-attachments.length > 0: Rectangle {
                            property <length> gap: Theme.s2;
                            property <int> cols: max(1, floor((self.width + self.gap) / (200px + self.gap)));
                            property <length> cell: (self.width - (self.cols - 1) * self.gap) / self.cols;
                            height: ceil(root.c-attachments.length / self.cols) * (Theme.chip-height + self.gap) - self.gap;
                            for a[i] in root.c-attachments: Chip {
                                x: mod(i, parent.cols) * (parent.cell + parent.gap);
                                y: floor(i / parent.cols) * (Theme.chip-height + parent.gap);
                                width: parent.cell;
                                name: a.name;
                                size: a.size;
                                kind: a.kind;
                                action-icon: Icons.dismiss;
                                action-label: @tr("Remove {0}", a.name);
                                action => { root.remove-attachment(a.index); }
                            }
                        }
                        // The formatting toolbar (docs/WINUI3.md "Composer
                        // toolbar"; a plain-text message has none), then the
                        // Signature menu, importance and More. One Tab stop
                        // per group; the arrows move along each.
                        HorizontalLayout {
                            spacing: Theme.s1;
                            if root.c-rich: RichToolbar {
                                id: 0;
                                fmt: Rich.body-fmt;
                                compact: composer.compact-bar;
                                tight: composer.tight-bar;
                                link => { composer.open-link(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: sig-btn.preferred-width;
                                sig-btn := IconButton {
                                    icon: Icons.signature;
                                    label: composer.compact-bar ? "" : @tr("Signature");
                                    tooltip: @tr("Signature");
                                    menu: true;
                                    clicked => { sig-menu.show({ x: self.absolute-position.x - composer.absolute-position.x, y: self.absolute-position.y - composer.absolute-position.y + self.height + Theme.s1 }); }
                                }
                                Icon {
                                    x: parent.width - 20px;
                                    width: 12px;
                                    text: Icons.chevron-down;
                                    font-size: 12px;
                                    color: sig-btn.fg;
                                }
                            }
                            // Importance: two ToggleButtons, at most one on
                            // (as in Outlook); turning the one on off sends
                            // the message as normal.
                            f-high := IconButton {
                                visible: !composer.narrow-bar;
                                icon: Icons.important;
                                tooltip: @tr("High importance");
                                width: composer.narrow-bar ? 0 : 32px;
                                checkable: true;
                                checked: root.c-importance == 1;
                                clicked => { root.c-set-importance(root.c-importance == 1 ? 0 : 1); }
                            }
                            f-low := IconButton {
                                visible: !composer.narrow-bar;
                                icon: Icons.low-importance;
                                tooltip: @tr("Low importance");
                                width: composer.narrow-bar ? 0 : 32px;
                                checkable: true;
                                checked: root.c-importance == 2;
                                clicked => { root.c-set-importance(root.c-importance == 2 ? 0 : 2); }
                            }
                            IconButton {
                                icon: Icons.more;
                                tooltip: @tr("More options");
                                width: 32px;
                                clicked => { more-menu.show({ x: self.absolute-position.x - composer.absolute-position.x, y: self.absolute-position.y - composer.absolute-position.y + self.height + Theme.s1 }); }
                            }
                        }
                        if composer.link-open: HorizontalLayout {
                            spacing: Theme.s2;
                            FieldLabel { text: @tr("Link"); width: composer.label-w; }
                            link-field := TextField {
                                placeholder-text: @tr("https://example.com or name@example.com");
                                accessible-label: @tr("Link address");
                                accessible-description: composer.link-error ? @tr("Not a web or e-mail address") : "";
                                init => { self.focus(); }
                                edited => { composer.link-error = false; }
                                accepted(t) => { composer.insert-link(t); }
                                key-pressed(e) => {
                                    if e.text == Key.Escape {
                                        composer.close-link();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            // Enter inserts, as the accent button does; Esc cancels.
                            Button { accent: true; label: @tr("Insert"); tooltip: @tr("Insert link (Enter)"); clicked => { composer.insert-link(link-field.text); } }
                            IconButton { icon: Icons.dismiss; tooltip: @tr("Cancel (Esc)"); width: 32px; clicked => { composer.close-link(); } }
                        }
                        if composer.link-open && composer.link-error: VerticalLayout { FieldError { text: @tr("Not a web or e-mail address"); indent: composer.label-w + Theme.s2; } }
                        // The body, and Preview over it while on: the rendered
                        // HTML part on its own paper, scrolled as the body
                        // would be, drawn again at a new width or theme.
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 96px;
                            body := ComposeBody {
                                property <int> focus-seq: root.c-focus-seq;
                                property <int> refocus: root.body-refocus;
                                changed refocus => {
                                    if root.c-rich {
                                        rbody.focus-input();
                                    } else {
                                        self.focus();
                                    }
                                }
                                visible: !root.c-rich;
                                width: 100%;
                                height: 100%;
                                // Reached under Preview (Tab, a click through):
                                // back to writing, Preview off.
                                changed has-focus => {
                                    if self.has-focus && root.c-preview {
                                        root.c-preview = false;
                                    }
                                }
                                text <=> root.c-body;
                                font-size: Theme.body;
                                placeholder-text: @tr("Write your message");
                                accessible-label: @tr("Message body");
                                edited(t) => { root.c-edited(ComposeField.body, t); }
                                key-pressed(e) => { composer.format-key(e) }
                                // A reply starts typing above the quote.
                                changed focus-seq => { if root.c-focus == ComposeField.body { body.focus-top(); } }
                                init => { if root.c-focus == ComposeField.body { body.focus-top(); } }
                                function focus-top() {
                                    if root.c-rich {
                                        rbody.focus-top();
                                        return;
                                    }
                                    self.focus();
                                    self.set-selection-offsets(0, 0);
                                    self.content-y = 0;
                                }
                            }
                            // The formatted body (docs/WINUI3.md "RichEditBox
                            // mapping"): the painted page over its hidden input.
                            rbody := RichBody {
                                visible: root.c-rich;
                                width: 100%;
                                height: 100%;
                                id: 0;
                                state: Rich.body;
                                placeholder-text: @tr("Write your message");
                                label: @tr("Message body");
                                // Reached under Preview: back to writing.
                                changed has-focus => {
                                    if self.has-focus && root.c-preview {
                                        root.c-preview = false;
                                    }
                                }
                                user-key(e) => {
                                    if e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && (e.text == "k" || e.text == "K") {
                                        composer.open-link();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            if root.c-preview: Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: Theme.contrast ? Theme.text : Theme.stroke-strong;
                                background: root.c-preview-paper;
                                clip: true;
                                accessible-role: AccessibleRole.groupbox;
                                accessible-label: @tr("Preview");
                                property <bool> dark: Theme.dark;
                                init => { root.c-preview-render(self.width - 24px, Theme.dark, true); }
                                changed dark => { root.c-preview-render(self.width - 24px, Theme.dark, false); }
                                changed width => { root.c-preview-render(self.width - 24px, Theme.dark, false); }
                                // Swallows clicks, so the body under it stays put.
                                TouchArea { }
                                Flickable {
                                    x: 12px;
                                    y: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height - 24px;
                                    content-height: root.c-preview-height;
                                    Image {
                                        x: 0;
                                        y: 0;
                                        // As laid out (at most 960 wide), never stretched.
                                        width: root.c-preview-height > 0 ? min(parent.width, root.c-preview-width) : 0;
                                        height: root.c-preview-height;
                                        source: root.c-preview-image;
                                        image-fit: fill;
                                        accessible-role: none;
                                    }
                                }
                            }
                        }
                        if root.c-preview && (root.c-preview-cut || root.c-preview-failed): Text {
                            text: root.c-preview-failed ? @tr("Couldn't draw the preview. The message is sent as written.") : @tr("The preview shows the beginning of the message.");
                            font-size: Theme.caption;
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                        // A reply's or forward's quote, folded (it is still
                        // sent); one click puts it back in the body.
                        if root.c-quote-folded && !root.c-preview: HorizontalLayout {
                            alignment: start;
                            HyperlinkButton {
                                text: @tr("Show quoted text");
                                clicked => { root.c-unfold-quote(); }
                            }
                        }
                        // A formatted message's quote is the original's own
                        // HTML; this makes it ordinary text to edit.
                        if root.c-rich && Rich.body-fmt.quote-shown && !root.c-preview: HorizontalLayout {
                            alignment: start;
                            HyperlinkButton {
                                text: @tr("Edit quoted text");
                                clicked => { Rich.act(0, EdAction.edit-quote, 0); }
                            }
                        }
                    }
                    // Over the fields below, 4 px under the field typed in
                    // and as wide (every address field has the same x and
                    // width); nothing moves.
                    if root.c-suggestions.length > 0: SuggestList {
                        x: composer.field-x;
                        y: composer.suggest-y;
                        z: 2;
                        width: composer.width - composer.field-x - Theme.s4;
                        height: self.preferred-height;
                        items: root.c-suggestions;
                        current: root.c-suggest-index;
                        picked(i) => { root.c-suggest-accept(i); }
                    }
                }

                if !root.composing && !root.has-message && !root.o-show && root.selected-count == 0 && root.draft-popped: VerticalLayout {
                    alignment: center;
                    spacing: Theme.s3;
                    padding: Theme.s4;
                    Icon { text: Icons.compose; font-size: 40px; color: Theme.text-disabled; }
                    Text {
                        text: @tr("This message is open in its own window");
                        font-size: Theme.body;
                        color: Theme.text-2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button { label: @tr("Bring to front"); clicked => { root.bring-popped(); } }
                    }
                }

                if !root.composing && !root.has-message && !root.o-show && root.selected-count == 0 && !root.draft-popped: VerticalLayout {
                    alignment: center;
                    spacing: Theme.s2;
                    Icon { text: Icons.read; font-size: 40px; color: Theme.text-disabled; }
                    Text {
                        text: root.selected-folder == -1 ? @tr("Select a draft to keep writing") : @tr("Select a message to read");
                        font-size: Theme.body;
                        color: Theme.text-2;
                        horizontal-alignment: center;
                    }
                }

                // ---- several messages selected: actions on all of them
                if !root.composing && !root.has-message && !root.o-show && root.selected-count > 0: VerticalLayout {
                    alignment: center;
                    spacing: Theme.s3;
                    // Its Move list open: the title bar lets a click close it.
                    property <bool> popup: sel-move-menu.is-open;
                    changed popup => { root.popup-open = self.popup; }
                    // Ctrl+Shift+V opens the Move list here.
                    property <int> move-seq: root.move-seq;
                    changed move-seq => { sel-move-menu.show(); }
                    Icon { text: Icons.multi-select; font-size: 40px; color: Theme.text-disabled; }
                    Heading {
                        text: @tr("{n} message selected" | "{n} messages selected" % root.selected-count);
                        horizontal-alignment: center;
                    }
                    sel-row := HorizontalLayout {
                        alignment: center;
                        spacing: Theme.s1;
                        IconButton {
                            property <int> pane: root.pane-seq;
                            changed pane => { self.focus(); }
                            icon: Icons.archive;
                            label: @tr("Archive");
                            tooltip: @tr("Archive (Backspace)");
                            clicked => { root.archive(); }
                        }
                        IconButton { icon: Icons.delete; label: @tr("Delete"); tooltip: @tr("Delete (Del)"); clicked => { root.delete(); } }
                        sel-move := IconButton {
                            icon: Icons.move;
                            label: @tr("Move");
                            enabled: root.move-possible;
                            tooltip: @tr("Move (Ctrl+Shift+V)");
                            clicked => { sel-move-menu.show(); }
                        }
                    }
                    // Why Move is off, said where it shows (not only in a
                    // tooltip a disabled button never shows).
                    if !root.move-possible: Text {
                        text: @tr("Select messages of one account to move them");
                        font-size: Theme.caption;
                        color: Theme.text-2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    sel-move-menu := PopupWindow {
                        x: sel-row.x + sel-move.x;
                        y: sel-row.y + sel-row.height;
                        width: 280px;
                        close-policy: close-on-click-outside;
                        MoveList {
                            targets: root.move-targets;
                            filter <=> root.move-filter;
                            init => {
                                root.move-filter-edited("");
                                self.focus-filter();
                            }
                            filter-edited(t) => { root.move-filter-edited(t); }
                            picked(id) => {
                                sel-move-menu.close();
                                root.move-to(id);
                            }
                        }
                    }
                    // Two to a row, so the labels fit the narrow reader at a
                    // large text size (FLUENT2 "Layout and spacing").
                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.s1;
                        IconButton { icon: Icons.read; label: @tr("Mark as read"); tooltip: @tr("Mark as read (Ctrl+Q)"); clicked => { root.mark-read(true); } }
                        IconButton { icon: Icons.mail; label: @tr("Mark as unread"); tooltip: @tr("Mark as unread (Ctrl+U)"); clicked => { root.mark-read(false); } }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.s1;
                        IconButton { icon: Icons.flag-filled; label: @tr("Mark as important"); tooltip: @tr("Mark as important (Ctrl+Shift+G)"); clicked => { root.mark-flagged(true); } }
                        IconButton { icon: Icons.flag; label: @tr("Remove importance"); clicked => { root.mark-flagged(false); } }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 0;
                        HyperlinkButton {
                            text: @tr("Select all");
                            clicked => { root.select-all-rows(); }
                        }
                        HyperlinkButton {
                            text: @tr("Clear selection");
                            clicked => { root.clear-selection(); }
                        }
                    }
                }

                // ---- an outbox message: its commands, then where its send
                // is as an InfoBar (Critical when it failed or may not have
                // gone, else Informational).
                if !root.composing && root.o-show: VerticalLayout {
                    padding: Theme.s4;
                    spacing: Theme.s3;
                    alignment: start;
                    // A command bar, 4 px apart (docs/WINUI3.md "CommandBar /
                    // AppBarButton"); Retry is a standard button. F6 lands
                    // on the first one shown.
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.s1;
                        // Below 720 px: back to the Outbox list.
                        if root.one-pane: IconButton {
                            icon: Icons.back;
                            tooltip: @tr("Back to list (Esc)");
                            clicked => { root.back-to-list(); }
                            property <int> pane: root.pane-seq;
                            changed pane => { if !root.show-list { self.focus(); } }
                            init => { if !root.show-list { self.focus(); } }
                        }
                        // A refusal sending again can't fix: Edit is the
                        // accent and Retry subtle; otherwise the reverse.
                        if root.o-can-edit && root.o-permanent: HorizontalLayout {
                            Button {
                                property <int> pane: root.pane-seq;
                                changed pane => { if root.show-list || !root.one-pane { self.focus(); } }
                                accent: true;
                                icon: Icons.compose;
                                label: @tr("Edit");
                                clicked => { root.o-edit(); }
                            }
                        }
                        if root.o-can-edit && !root.o-permanent: HorizontalLayout {
                            IconButton {
                                property <int> pane: root.pane-seq;
                                changed pane => { if root.show-list || !root.one-pane { self.focus(); } }
                                icon: Icons.compose;
                                label: @tr("Edit");
                                clicked => { root.o-edit(); }
                            }
                        }
                        if root.o-can-retry && root.o-permanent: HorizontalLayout {
                            IconButton {
                                property <int> pane: root.pane-seq;
                                changed pane => { if !root.o-can-edit && (root.show-list || !root.one-pane) { self.focus(); } }
                                icon: Icons.send;
                                label: @tr("Retry");
                                clicked => { root.o-retry(); root.asked-in-reader(); }
                            }
                        }
                        if root.o-can-retry && !root.o-permanent: HorizontalLayout {
                            Button {
                                property <int> pane: root.pane-seq;
                                changed pane => { if !root.o-can-edit && (root.show-list || !root.one-pane) { self.focus(); } }
                                accent: true;
                                icon: Icons.send;
                                label: @tr("Retry");
                                clicked => { root.o-retry(); root.asked-in-reader(); }
                            }
                        }
                        if root.o-can-discard: HorizontalLayout {
                            IconButton {
                                property <int> pane: root.pane-seq;
                                changed pane => { if !root.o-can-edit && !root.o-can-retry && (root.show-list || !root.one-pane) { self.focus(); } }
                                icon: Icons.delete;
                                label: @tr("Discard");
                                clicked => { root.o-discard(); root.asked-in-reader(); }
                            }
                        }
                    }
                    Heading { text: root.o-subject; }
                    Text {
                        text: @tr("To: {0}", root.o-to);
                        font-size: Theme.body;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    InfoBar {
                        severity: root.o-problem ? Severity.critical : Severity.info;
                        message: root.o-status;
                        closable: false;
                    }
                    // The server's own words, for whoever needs them.
                    if root.o-problem && root.o-detail != "": outbox-details := VerticalLayout {
                        property <bool> open;
                        Expander {
                            header: @tr("Details");
                            description: @tr("The server's reply, as it came");
                            expanded <=> outbox-details.open;
                        }
                        if outbox-details.open: Rectangle {
                            background: Theme.card-fill;
                            border-width: 1px;
                            border-color: Theme.card-edge;
                            border-bottom-left-radius: Theme.radius;
                            border-bottom-right-radius: Theme.radius;
                            height: detail-text.preferred-height + 2 * Theme.s3;
                            detail-text := Text {
                                x: Theme.s4;
                                width: parent.width - 2 * Theme.s4;
                                text: root.o-detail;
                                font-size: Theme.caption;
                                color: Theme.text-2;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // The first lines of the text, as written.
                    if root.o-body != "": Text {
                        text: root.o-body;
                        font-size: Theme.body;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }

                // Files dragged over the window: where they go, over the
                // whole column (docs/WINUI3.md "Drag and drop"). Not with no
                // account (nothing to write from).
                if root.file-hover && root.accounts.length > 0: DropOverlay {
                    z: 5;
                    composing: root.composing;
                }

                // The target of the hovered or focused link, over the
                // bottom of the reader, as browsers show it; drawn as a
                // ToolTip (docs/WINUI3.md "MenuFlyout / ToolTip / Flyout").
                if !root.composing && root.has-message && root.r-hover-href != "": Rectangle {
                    x: Theme.s2;
                    y: parent.height - self.height - Theme.s2;
                    z: 1;
                    width: min(hover-text.preferred-width + 18px, parent.width - 2 * Theme.s2);
                    height: hover-text.preferred-height + 14px;
                    background: Theme.flyout;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.flyout-stroke;
                    hover-text := Text {
                        x: 9px;
                        y: 6px;
                        width: parent.width - 18px;
                        text: root.r-hover-href;
                        font-size: Theme.caption;
                        color: Theme.text;
                        overflow: elide;
                    }
                }

                if !root.composing && root.has-message: VerticalLayout {
                    // Its Move list open: the title bar lets a click close it.
                    property <bool> popup: move-popup.is-open;
                    changed popup => { root.popup-open = self.popup; }
                    // Ctrl+Shift+V opens the Move list here.
                    property <int> move-seq: root.move-seq;
                    changed move-seq => { move-popup.show(); }
                    // Command bar (docs/WINUI3.md "CommandBar / AppBarButton"):
                    // one Tab stop, Left/Right move along it. The secondary
                    // commands (plain text, original colours, ...) are in More.
                    cmd-bar := FocusScope {
                        focus-on-click: false;
                        focus-on-tab-navigation: false;
                        // The button the arrows last reached (Tab returns to
                        // it); Move may be off.
                        property <int> current;
                        // Labels by priority, each measured on its own
                        // (hidden texts below) at the current text size:
                        // Archive, Delete and Reply strictly in that order;
                        // then Mark as read, Flag, Move, Reply all and
                        // Forward, each while it still fits after the ones
                        // before it. Without
                        // labels the bar is 366 px (padding 16, eight 32 px
                        // buttons, Move 52, separators 2, gaps 40); a label
                        // adds its text and 15 px (Move 8 px).
                        // Below 720 px the back button and a separator lead
                        // (32 + 1 px and two 4 px gaps).
                        property <length> room0: self.width - 366px - (root.one-pane ? 41px : 0);
                        property <length> w-archive: archive-text.preferred-width + 15px;
                        property <length> w-delete: delete-text.preferred-width + 15px;
                        property <length> w-reply: root.r-server-draft ? 0 : reply-text.preferred-width + 15px;
                        property <length> w-read: read-text.preferred-width + 15px;
                        property <length> w-flag: flag-text.preferred-width + 15px;
                        property <length> w-move: move-text.preferred-width + 8px;
                        property <length> w-reply-all: root.r-server-draft ? 0 : reply-all-text.preferred-width + 15px;
                        property <length> w-forward: forward-text.preferred-width + 15px;
                        property <bool> show-archive: self.w-archive <= self.room0;
                        property <length> room1: self.room0 - (self.show-archive ? self.w-archive : 0);
                        property <bool> show-delete: self.show-archive && self.w-delete <= self.room1;
                        property <length> room2: self.room1 - (self.show-delete ? self.w-delete : 0);
                        property <bool> show-reply: self.show-delete && !root.r-server-draft && self.w-reply <= self.room2;
                        property <length> room3: self.room2 - (self.show-reply ? self.w-reply : 0);
                        // The rest only once those three have theirs.
                        property <bool> core: self.show-delete && (self.show-reply || root.r-server-draft);
                        property <bool> show-read: self.core && self.w-read <= self.room3;
                        property <length> room4: self.room3 - (self.show-read ? self.w-read : 0);
                        property <bool> show-flag: self.core && self.w-flag <= self.room4;
                        property <length> room5: self.room4 - (self.show-flag ? self.w-flag : 0);
                        property <bool> show-move: self.core && self.w-move <= self.room5;
                        property <length> room6: self.room5 - (self.show-move ? self.w-move : 0);
                        property <bool> show-reply-all: self.core && !root.r-server-draft && self.w-reply-all <= self.room6;
                        property <length> room7: self.room6 - (self.show-reply-all ? self.w-reply-all : 0);
                        property <bool> show-forward: self.core && self.w-forward <= self.room7;
                        // A bit per label in drop order (Forward first), for
                        // the tests (`cmd-labels`).
                        property <int> labels: (self.show-forward ? 1 : 0) + (self.show-reply-all ? 2 : 0) + (self.show-move ? 4 : 0)
                            + (self.show-flag ? 8 : 0) + (self.show-read ? 16 : 0) + (self.show-reply ? 32 : 0)
                            + (self.show-delete ? 64 : 0) + (self.show-archive ? 128 : 0);
                        changed labels => { root.cmd-labels = self.labels; }
                        init => { root.cmd-labels = self.labels; }
                        property <int> stop: !self.off(self.current) ? self.current : root.r-server-draft ? 2 : 0;
                        property <int> pane: root.pane-seq;
                        changed pane => { if root.show-list || !root.one-pane { self.go(self.stop, 1); } }
                        // Buttons that are off or hidden: Move with nowhere
                        // to go, Reply and Reply all on a server draft.
                        pure function off(k: int) -> bool {
                            (k == 5 && !root.move-possible) || (k <= 1 && root.r-server-draft)
                        }
                        // Focus button `i`, or the next one in direction `d`
                        // when `i` is off.
                        function go(i: int, d: int) {
                            let j = mod(i + 9, 9);
                            let k1 = self.off(j) ? mod(j + d + 9, 9) : j;
                            let k = self.off(k1) ? mod(k1 + d + 9, 9) : k1;
                            self.current = k;
                            if k == 0 { b-reply.focus(); }
                            else if k == 1 { b-reply-all.focus(); }
                            else if k == 2 { b-forward.focus(); }
                            else if k == 3 { b-archive.focus(); }
                            else if k == 4 { b-delete.focus(); }
                            else if k == 5 { move-btn.focus(); }
                            else if k == 6 { b-read.focus(); }
                            else if k == 7 { b-flag.focus(); }
                            else { b-more.focus(); }
                        }
                        key-pressed(e) => {
                            if e.modifiers.control || e.modifiers.alt || e.modifiers.shift {
                                return reject;
                            }
                            if e.text == Key.LeftArrow {
                                self.go(self.current - 1, -1);
                                return accept;
                            }
                            if e.text == Key.RightArrow {
                                self.go(self.current + 1, 1);
                                return accept;
                            }
                            reject
                        }
                        // The labels, measured (never shown).
                        reply-text := Text { visible: false; height: 0; accessible-role: none; text: @tr("Reply"); font-size: Theme.body; }
                        reply-all-text := Text { visible: false; height: 0; accessible-role: none; text: @tr("Reply all"); font-size: Theme.body; }
                        forward-text := Text { visible: false; height: 0; accessible-role: none; text: root.r-server-draft ? @tr("Forward as new draft") : @tr("Forward"); font-size: Theme.body; }
                        archive-text := Text { visible: false; height: 0; accessible-role: none; text: @tr("Archive"); font-size: Theme.body; }
                        delete-text := Text { visible: false; height: 0; accessible-role: none; text: @tr("Delete"); font-size: Theme.body; }
                        move-text := Text { visible: false; height: 0; accessible-role: none; text: @tr("Move"); font-size: Theme.body; }
                        read-text := Text { visible: false; height: 0; accessible-role: none; text: root.r-unread ? @tr("Mark as read") : @tr("Mark as unread"); font-size: Theme.body; }
                        flag-text := Text { visible: false; height: 0; accessible-role: none; text: root.r-flagged ? @tr("Remove importance") : @tr("Mark as important"); font-size: Theme.body; }
                        // The image bar's two button labels (below).
                        images-text := Text { visible: false; height: 0; accessible-role: none; text: @tr("Load images") + @tr("Always load from this sender"); font-size: Theme.body; }
                        // 4 px apart, so a button's outside focus ring stays
                        // clear of its neighbours and the separators. Every
                        // button is as tall as Archive, the last to lose its
                        // label, so a larger text size keeps the icons in line.
                        HorizontalLayout {
                            padding: Theme.s2;
                            spacing: Theme.s1;
                            alignment: start;
                            // One pane at a time (below 720 px): back to the
                            // list. Reached by Tab, not by the arrows.
                            if root.one-pane && !root.detail-only: IconButton {
                                height: b-archive.height;
                                icon: Icons.back;
                                tooltip: @tr("Back to list (Esc)");
                                clicked => { root.back-to-list(); }
                                // Shown with the list gone from under the
                                // focus: it takes the keys, also on F6 (the
                                // command bar's buttons stand back then).
                                property <int> pane: root.pane-seq;
                                changed pane => { if !root.show-list { self.focus(); } }
                                init => { if !root.show-list { self.focus(); } }
                            }
                            if root.one-pane && !root.detail-only: Rectangle { width: 1px; Rectangle { height: 20px; background: Theme.stroke; } }
                            b-reply := IconButton { enabled: !root.r-gone; visible: !root.r-server-draft; width: root.r-server-draft ? 0 : self.preferred-width; height: b-archive.height; icon: Icons.reply; label: cmd-bar.show-reply ? reply-text.text : ""; tooltip: @tr("Reply (Ctrl+R)"); tab-stop: cmd-bar.stop == 0; clicked => { root.reply(); } }
                            b-reply-all := IconButton { enabled: !root.r-gone; visible: !root.r-server-draft; width: root.r-server-draft ? 0 : self.preferred-width; height: b-archive.height; icon: Icons.reply-all; label: cmd-bar.show-reply-all ? reply-all-text.text : ""; tooltip: @tr("Reply all (Ctrl+Shift+R)"); tab-stop: cmd-bar.stop == 1; clicked => { root.reply-all(); } }
                            b-forward := IconButton { enabled: !root.r-gone; height: b-archive.height; icon: Icons.forward; label: cmd-bar.show-forward ? forward-text.text : ""; tooltip: root.r-server-draft ? @tr("Forward as new draft (Ctrl+Shift+F)") : @tr("Forward (Ctrl+Shift+F)"); tab-stop: cmd-bar.stop == 2; clicked => { root.forward(); } }
                            // Separators 1x20, centred in the row (a child
                            // without x / y is centred in its parent).
                            Rectangle { width: 1px; Rectangle { height: 20px; background: Theme.stroke; } }
                            b-archive := IconButton { enabled: !root.r-gone; icon: Icons.archive; label: cmd-bar.show-archive ? archive-text.text : ""; tooltip: @tr("Archive (Backspace)"); tab-stop: cmd-bar.stop == 3; clicked => { root.archive(); } }
                            b-delete := IconButton { enabled: !root.r-gone; height: b-archive.height; icon: Icons.delete; label: cmd-bar.show-delete ? delete-text.text : ""; tooltip: @tr("Delete (Del)"); tab-stop: cmd-bar.stop == 4; clicked => { root.delete(); root.asked-in-reader(); } }
                            Rectangle {
                                width: move-btn.preferred-width;
                                move-btn := IconButton {
                                    icon: Icons.move;
                                    height: b-archive.height;
                                    label: cmd-bar.show-move ? move-text.text : "";
                                    tooltip: @tr("Move (Ctrl+Shift+V)");
                                    menu: true;
                                    tab-stop: cmd-bar.stop == 5;
                                    enabled: root.move-possible && !root.r-gone;
                                    clicked => { move-popup.show(); }
                                }
                                // Its menu chevron, 8 px from its end.
                                Icon {
                                    x: parent.width - 20px;
                                    width: 12px;
                                    text: Icons.chevron-down;
                                    font-size: 12px;
                                    color: move-btn.fg;
                                }
                            }
                            Rectangle { width: 1px; Rectangle { height: 20px; background: Theme.stroke; } }
                            // Plain buttons whose label and icon say what
                            // they will do (not toggles).
                            b-read := IconButton { enabled: !root.r-gone;
                                icon: root.r-unread ? Icons.read : Icons.mail;
                                height: b-archive.height;
                                label: cmd-bar.show-read ? read-text.text : "";
                                tooltip: root.r-unread ? @tr("Mark as read (Ctrl+Q)") : @tr("Mark as unread (Ctrl+U)");
                                tab-stop: cmd-bar.stop == 6;
                                clicked => { root.mark-read(root.r-unread); }
                            }
                            b-flag := IconButton { enabled: !root.r-gone;
                                icon: root.r-flagged ? Icons.flag-filled : Icons.flag;
                                height: b-archive.height;
                                label: cmd-bar.show-flag ? flag-text.text : "";
                                tooltip: root.r-flagged ? @tr("Remove importance (Ctrl+Shift+G)") : @tr("Mark as important (Ctrl+Shift+G)");
                                tab-stop: cmd-bar.stop == 7;
                                clicked => { root.mark-flagged(!root.r-flagged); }
                            }
                            b-more := IconButton {
                                icon: Icons.more;
                                tooltip: @tr("More actions");
                                height: b-archive.height;
                                width: 32px;
                                tab-stop: cmd-bar.stop == 8;
                                clicked => {
                                    // A click leaves the focus where it was;
                                    // Show original gives it back there.
                                    root.menu-pane = root.pane-of-focus();
                                    root.menu-opening();
                                    reader-menu.show({ x: self.absolute-position.x, y: self.absolute-position.y + self.height + Theme.s1 });
                                }
                            }
                        }
                    }
                    // Under the Move button, 4 px below it.
                    move-popup := PopupWindow {
                        x: move-btn.absolute-position.x - cmd-bar.absolute-position.x;
                        y: cmd-bar.y + (move-btn.absolute-position.y - cmd-bar.absolute-position.y) + move-btn.height + Theme.s1;
                        width: 280px;
                        close-policy: close-on-click-outside;
                        MoveList {
                            targets: root.move-targets;
                            filter <=> root.move-filter;
                            init => {
                                root.move-filter-edited("");
                                self.focus-filter();
                            }
                            filter-edited(t) => { root.move-filter-edited(t); }
                            picked(id) => {
                                move-popup.close();
                                root.move-to(id);
                            }
                        }
                    }
                    Divider { }
                    // Ctrl+A, Ctrl+C and Escape act on the page selection once a
                    // click on the page focuses this. It sits outside the scroll
                    // view, which would otherwise scroll to it on focus.
                    page-keys := FocusScope {
                        height: 0;
                        // A Tab stop only while the page shows (its links).
                        focus-on-tab-navigation: page.shown;
                        // Enter in the list opens a message and focuses this.
                        property <bool> wanted: root.focus-page;
                        changed wanted => {
                            if self.wanted {
                                self.focus();
                                root.focus-page = false;
                            }
                        }
                        init => {
                            if root.focus-page {
                                self.focus();
                                root.focus-page = false;
                            }
                        }
                        KeyBinding { keys: @keys(Control + "a"); enabled: page.shown; activated => { root.r-select-all(); } }
                        KeyBinding { keys: @keys(Backspace); enabled: root.backspace-archives; activated => { root.archive(); } }
                        KeyBinding { keys: @keys(Control + "c"); enabled: page.shown; activated => { root.r-copy(); } }
                        // With no selection or focused link on the page, Esc
                        // reaches the list (and closes the message).
                        KeyBinding { keys: @keys(Escape); enabled: page.shown && (root.r-selection.length > 0 || root.r-focus.length > 0); activated => { root.r-clear-selection(); } }
                        function scroll-by(d: length) {
                            root.r-content-y = clamp(root.r-content-y - d, root.r-scroll-min, 0px);
                        }
                        // Tab cycles the page's links and Enter follows the
                        // focused one; the scroll keys act here only, so the
                        // arrows still move through the message list.
                        key-pressed(e) => {
                            if !page.shown || e.modifiers.control || e.modifiers.alt || e.modifiers.meta {
                                return reject;
                            }
                            if e.text == Key.Tab || e.text == Key.Backtab {
                                return root.r-focus-link(e.text == Key.Backtab || e.modifiers.shift) ? accept : reject;
                            }
                            if e.text == Key.Return && root.r-focus.length > 0 {
                                root.r-activate-focused();
                                return accept;
                            }
                            if e.text == Key.PageDown || (e.text == " " && !e.modifiers.shift) {
                                scroll-by(body-scroll.visible-height * 0.9);
                            } else if e.text == Key.PageUp || (e.text == " " && e.modifiers.shift) {
                                scroll-by(-body-scroll.visible-height * 0.9);
                            } else if e.text == Key.Home {
                                root.r-content-y = 0px;
                            } else if e.text == Key.End {
                                root.r-content-y = root.r-scroll-min;
                            } else {
                                return reject;
                            }
                            accept
                        }
                    }
                    body-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-height: body-col.preferred-height;
                        content-y <=> root.r-content-y;
                        // The page band in view; the header above the page
                        // varies in height, so its offset is part of it.
                        property <length> view-top: -self.content-y - body-area.y - page.y;
                        property <length> scroll-min: min(0px, self.visible-height - self.content-height);
                        init => {
                            root.r-view-top = self.view-top;
                            root.r-view-height = self.visible-height;
                            root.r-scroll-min = self.scroll-min;
                        }
                        changed view-top => {
                            root.r-view-top = self.view-top;
                            root.r-view-changed();
                        }
                        changed visible-height => {
                            root.r-view-height = self.visible-height;
                            root.r-view-changed();
                        }
                        changed scroll-min => { root.r-scroll-min = self.scroll-min; }
                        body-col := VerticalLayout {
                            width: parent.visible-width;
                            init => {
                                root.r-body-width = self.width - 2 * Theme.s6;
                                root.r-body-resized();
                            }
                            changed width => {
                                root.r-body-width = self.width - 2 * Theme.s6;
                                root.r-body-resized();
                            }
                            padding: Theme.s6;
                            padding-top: Theme.s4;
                            spacing: Theme.s4;
                            Text {
                                text: root.r-subject == "" ? @tr("(no subject)") : root.r-subject;
                                accessible-label: @tr("Subject: {0}", self.text);
                                font-family: Theme.display-font;
                                font-size: Theme.title;
                                font-weight: 600;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            // Below 560 px (wider with a larger text size) the date
                            // moves to the To line, or to a line of its own when
                            // that would leave To less than 10 em (FLUENT2 "Layout
                            // and spacing": reflow). The three date texts are
                            // hidden rather than `if`s: an `if` is code of its own.
                            header := HorizontalLayout {
                                property <bool> narrow: body-col.width < 40 * Theme.body;
                                property <length> unsub-width: root.r-unsubscribe ? unsub-text.preferred-width + 22px + Theme.s3 : 0;
                                property <bool> tight: self.narrow && body-col.width - 2 * Theme.s6 - 52px - self.unsub-width - Theme.s3 - to-date.preferred-width < 10 * Theme.body;
                                spacing: Theme.s3;
                                // The avatar repeats the sender: hidden from screen
                                // readers. Under a contrast theme a PersonPicture
                                // (docs/WINUI3.md "Progress, PersonPicture, InfoBadge"):
                                // Window, a WindowText ring and initials.
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: Theme.contrast ? Theme.card : root.r-avatar;
                                    border-width: Theme.contrast ? 1px : 0;
                                    border-color: Theme.text;
                                    accessible-role: none;
                                    Text { text: root.r-initials; color: Theme.on-avatar; font-size: Theme.body; font-weight: 600; accessible-role: none; }
                                    // Measures the Unsubscribe link (beside).
                                    unsub-text := Text { visible: false; accessible-role: none; text: @tr("Unsubscribe"); font-size: Theme.body; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            text: root.r-from-name;
                                            accessible-label: @tr("From: {0}", self.text);
                                            font-size: Theme.body;
                                            font-weight: 600;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "<" + root.r-from-addr + ">";
                                            accessible-label: @tr("Sender address: {0}", root.r-from-addr);
                                            font-size: Theme.caption;
                                            color: Theme.text-2;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            visible: !header.narrow;
                                            width: header.narrow ? 0 : self.preferred-width;
                                            text: root.r-date;
                                            accessible-label: @tr("Date: {0}", self.text);
                                            font-size: Theme.caption;
                                            color: Theme.text-2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s3;
                                        Text {
                                            text: root.r-cc != "" ? @tr("To: {0}   Cc: {1}", root.r-to, root.r-cc) : @tr("To: {0}", root.r-to);
                                            // A long address wraps anywhere rather than
                                            // widen the header past the reader.
                                            min-width: 0;
                                            font-size: Theme.caption;
                                            color: Theme.text-2;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        to-date := Text {
                                            visible: header.narrow && !header.tight;
                                            width: self.visible ? self.preferred-width : 0;
                                            text: root.r-date;
                                            accessible-label: @tr("Date: {0}", self.text);
                                            font-size: Theme.caption;
                                            color: Theme.text-2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        visible: header.tight;
                                        height: self.visible ? self.preferred-height : 0;
                                        text: root.r-date;
                                        accessible-label: @tr("Date: {0}", self.text);
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                    }
                                    // The importance its sender set, as plain
                                    // Caption text (docs/WINUI3.md "High
                                    // importance"): High leads with the list's
                                    // bold "!" in TextPrimary, Low is a quiet
                                    // note. Passive; the "!" is hidden from screen
                                    // readers, which read the sentence.
                                    if root.r-importance == 1 || root.r-importance == 2: HorizontalLayout {
                                        spacing: Theme.s1;
                                        if root.r-importance == 1: Text {
                                            text: "!";
                                            font-family: Theme.text-font;
                                            font-size: Theme.body;
                                            font-weight: 700;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }
                                        Text {
                                            text: root.r-importance == 1 ? @tr("Sent with high importance") : @tr("Sent with low importance");
                                            font-size: Theme.caption;
                                            color: Theme.text-2;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                // List-Unsubscribe, never fetched by itself
                                // (docs/WINUI3.md "HyperlinkButton").
                                if root.r-unsubscribe: VerticalLayout {
                                    alignment: center;
                                    HyperlinkButton {
                                        text: @tr("Unsubscribe");
                                        clicked => { root.unsubscribe(); }
                                    }
                                }
                            }
                            // A message tab whose message the server moved or
                            // deleted: still readable, its actions off.
                            if root.r-gone: VerticalLayout {
                                InfoBar {
                                    severity: Severity.caution;
                                    message: @tr("This message was moved or deleted on the server.");
                                    closable: false;
                                }
                            }
                            // A draft from the server's Drafts folder: where it
                            // came from and how to go on with it here: Edit
                            // opens it in the composer, and saving replaces it.
                            if root.r-server-draft: VerticalLayout {
                                InfoBar {
                                    severity: Severity.info;
                                    message: @tr("This draft was saved on another device or in webmail. To keep writing it here, select Edit.");
                                    action-text: root.detail-only ? "" : @tr("Edit");
                                    closable: false;
                                    action => { root.edit-server-draft(); }
                                }
                            }
                            // A reply to this message in progress (in memory or
                            // in Drafts): Resume reopens it, as Reply does.
                            if root.r-draft-reply && !root.r-server-draft: VerticalLayout {
                                InfoBar {
                                    severity: Severity.info;
                                    message: @tr("You started a reply to this message.");
                                    action-text: @tr("Resume");
                                    closable: false;
                                    action => { root.reply(); }
                                }
                            }
                            // Why to look twice at the sender (caution), and that
                            // the message is encrypted (information); one bar, as
                            // both are rare (docs/WINUI3.md "InfoBar").
                            // A sender notice: plain words first, the reason on
                            // the second line, and what to do about it (Report
                            // junk, Delete, Why?). Not closable: it stays with
                            // the message.
                            if root.r-notice != "" || root.r-crypt != "": VerticalLayout {
                                InfoBar {
                                    severity: root.r-notice != "" ? Severity.caution : Severity.info;
                                    title: root.r-notice != "" ? @tr("This message may not be from who it says") : "";
                                    message: root.r-notice + (root.r-notice != "" && root.r-crypt != "" ? " " : "") + root.r-crypt;
                                    closable: false;
                                    button1: root.r-notice == "" ? "" : root.r-in-junk ? @tr("Not junk") : @tr("Report junk");
                                    button2: root.r-notice == "" ? "" : @tr("Delete");
                                    button3: root.r-notice == "" ? "" : @tr("Why?");
                                    button-clicked(i) => {
                                        if i == 0 {
                                            root.junk(!root.r-in-junk);
                                        } else if i == 1 {
                                            root.delete();
                                        } else {
                                            root.why-show = true;
                                        }
                                    }
                                }
                            }
                            // A meeting invitation: drawn here, outside the page, as
                            // a card outline on the reader's card.
                            if root.i-title != "": invite-card := Rectangle {
                                property <bool> details;
                                border-radius: Theme.radius-lg;
                                border-width: 1px;
                                border-color: Theme.stroke;
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s3;
                                    Text {
                                        text: root.i-title;
                                        font-size: Theme.subtitle;
                                        font-weight: 600;
                                        color: root.i-cancelled ? Theme.text-2 : Theme.text;
                                        wrap: word-wrap;
                                        // Struck through when cancelled (its first line).
                                        if root.i-cancelled: Rectangle {
                                            x: 0;
                                            y: 11px;
                                            width: min(parent.width, parent.preferred-width);
                                            height: 1px;
                                            background: Theme.text-2;
                                        }
                                    }
                                    if root.i-state != "": BodyText {
                                        text: root.i-state;
                                        font-weight: 600;
                                        color: root.i-cancelled ? Theme.warning : Theme.text-2;
                                    }
                                    BodyText { text: root.i-lines; color: Theme.text-2; }
                                    // The answers as buttons, the one given accent-filled
                                    // (shown again by Change).
                                    if root.i-answers.length > 0: HorizontalLayout {
                                        alignment: start;
                                        spacing: Theme.s2;
                                        // In a layout each, so they share the Button code.
                                        for a in root.i-answers: HorizontalLayout {
                                            Button {
                                                icon: a == 1 ? Icons.accept : a == 2 ? Icons.tentative : Icons.dismiss;
                                                label: a == 1 ? @tr("Accept") : a == 2 ? @tr("Tentative") : @tr("Decline");
                                                accent: a == root.i-answer;
                                                clicked => {
                                                    root.invite(a);
                                                    root.asked-in-reader();
                                                }
                                            }
                                        }
                                    }
                                    // The rest, subtle: Change, Join, Details (Expander's
                                    // 12 px chevron, docs/WINUI3.md "Expander"), Save .ics.
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: Theme.s1;
                                        for a in root.i-tools: HorizontalLayout {
                                            IconButton {
                                                icon: a == 5 ? Icons.compose : a == 0 ? Icons.link : a == 4 ? Icons.save
                                                    : a == 7 ? Icons.delete
                                                    : invite-card.details ? Icons.chevron-up : Icons.chevron-down;
                                                icon-size: a == 6 ? 12px : 16px;
                                                label: a == 5 ? @tr("Change") : a == 0 ? @tr("Join") : a == 4 ? @tr("Save .ics")
                                                    : a == 7 ? @tr("Remove from calendar") : @tr("Details");
                                                clicked => {
                                                    if a == 6 {
                                                        invite-card.details = !invite-card.details;
                                                    } else {
                                                        root.invite(a);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if invite-card.details: BodyText { text: root.i-details; color: Theme.text-2; }
                                }
                            }
                            // Its server reachable: a ring (nothing for the
                            // first second, FLUENT2 "Wait UX"). Out of reach:
                            // after 2 s, why the page is empty, with Retry
                            // (docs/WINUI3.md "InfoBar"), never a blank page.
                            if root.loading && !root.r-unreachable: HorizontalLayout {
                                spacing: Theme.s2;
                                load-ring := ProgressRing { y: (parent.height - self.height) / 2; }
                                Text { text: @tr("Downloading message\u{a0}…"); visible: load-ring.due; font-size: Theme.body; color: Theme.text-2; vertical-alignment: center; }
                            }
                            if root.loading && root.r-unreachable: not-there := VerticalLayout {
                                property <bool> late;
                                property <int> message: root.selected-id;
                                changed message => { self.late = false; }
                                spacing: Theme.s2;
                                Timer {
                                    interval: 2s;
                                    running: !not-there.late;
                                    triggered => { not-there.late = true; }
                                }
                                if not-there.late: Text {
                                    text: @tr("This message hasn't been downloaded yet. It downloads when Komorebi can reach the server.");
                                    font-size: Theme.body;
                                    color: Theme.text-2;
                                    wrap: word-wrap;
                                    accessible-live-region: polite;
                                }
                                if not-there.late: HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        label: @tr("Retry");
                                        clicked => {
                                            not-there.late = false;
                                            root.r-retry-body();
                                        }
                                    }
                                }
                            }
                            // Spacing 0 here: the page stays in the layout (it
                            // anchors the scroll position) even in text mode.
                            body-area := VerticalLayout {
                                // The image bar closed for the message shown.
                                property <bool> images-closed;
                                property <int> message: root.selected-id;
                                changed message => { self.images-closed = false; }
                                // The attachments wrap, as many to a row as fit, each
                                // 180 to 280 px wide, 12 px above what follows (no
                                // `if`: 0 px tall without attachments).
                                Rectangle {
                                    property <length> gap: Theme.s2;
                                    property <int> count: root.r-attachments.length;
                                    property <int> cols: max(1, floor((self.width + self.gap) / (180px + self.gap)));
                                    property <length> cell: min(280px, (self.width - (self.cols - 1) * self.gap) / self.cols);
                                    height: self.count == 0 ? 0 : ceil(self.count / self.cols) * (Theme.chip-height + self.gap) - self.gap + Theme.s3;
                                    for a[i] in root.r-attachments: Chip {
                                        x: mod(i, parent.cols) * (parent.cell + parent.gap);
                                        y: floor(i / parent.cols) * (Theme.chip-height + parent.gap);
                                        width: parent.cell;
                                        opens: true;
                                        name: a.name;
                                        size: a.size;
                                        kind: a.kind;
                                        action-icon: Icons.save;
                                        action-label: @tr("Save {0}", a.name);
                                        action => { root.save-attachment(a.index); }
                                        clicked => { root.open-attachment(a.index); }
                                    }
                                }
                                // A text body that stands in for a failed HTML render.
                                if root.r-note != "" && !root.r-html && !root.r-waiting: VerticalLayout {
                                    padding-bottom: Theme.s3;
                                    Text {
                                        text: root.r-note;
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        wrap: word-wrap;
                                    }
                                }
                                // Remote images the page leaves out (information, the
                                // sender's address in full: it is what "Always"
                                // trusts); after Load, those that could not be fetched
                                // (caution: no HTTPS on the host, not found, too large,
                                // too slow). Closable for this message.
                                // "Always load from this sender" just pressed:
                                // what it did, with Undo and the setting.
                                if root.r-remote-always != "" && root.r-html && !root.r-plain: VerticalLayout {
                                    padding-bottom: Theme.s3;
                                    InfoBar {
                                        severity: Severity.info;
                                        message: @tr("Images from {0} will always load.", root.r-remote-always);
                                        button1: @tr("Undo");
                                        button2: @tr("Privacy settings");
                                        button-clicked(i) => {
                                            if i == 0 {
                                                root.r-remote-undo();
                                            } else {
                                                root.open-privacy();
                                            }
                                        }
                                        closed => { root.r-remote-always = ""; }
                                    }
                                }
                                // Later messages from an allowed sender: a quiet
                                // caption, with the way to change it.
                                if root.r-remote-allowed && root.r-remote-always == "" && root.r-html && !root.r-plain: HorizontalLayout {
                                    padding-bottom: Theme.s2;
                                    spacing: Theme.s1;
                                    alignment: start;
                                    Text {
                                        text: @tr("Images load from this sender");
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "·";
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                    HyperlinkButton {
                                        text: @tr("remote images" => "Change");
                                        label: @tr("Change which senders' images load");
                                        font-size: Theme.caption;
                                        clicked => { root.open-privacy(); }
                                    }
                                }
                                if (root.r-remote-blocked > 0 || root.r-remote-failed > 0) && root.r-html && !root.r-plain && !body-area.images-closed: VerticalLayout {
                                    property <bool> blocked: root.r-remote-blocked > 0;
                                    padding-bottom: Theme.s3;
                                    InfoBar {
                                        severity: parent.blocked ? Severity.info : Severity.caution;
                                        message: !parent.blocked
                                            ? @tr("{n} image couldn't be loaded." | "{n} images couldn't be loaded." % root.r-remote-failed)
                                            : root.r-from-addr != ""
                                                ? @tr("{n} remote image from {0} blocked. If you load them, the sender can see when you open this message and your IP address." | "{n} remote images from {0} blocked. If you load them, the sender can see when you open this message and your IP address." % root.r-remote-blocked, root.r-from-addr)
                                                : @tr("{n} remote image blocked. If you load them, the sender can see when you open this message and your IP address." | "{n} remote images blocked. If you load them, the sender can see when you open this message and your IP address." % root.r-remote-blocked);
                                        button1: parent.blocked ? @tr("Load images") : "";
                                        button2: parent.blocked && root.r-from-addr != "" ? @tr("Always load from this sender") : "";
                                        // Side by side while the reader leaves the
                                        // text column room for both (padding, icon
                                        // and close button take 142 px of the
                                        // column, the buttons' padding 56 px).
                                        stack-buttons: body-col.width < images-text.preferred-width + 200px;
                                        button-clicked(i) => { root.r-load-remote(i == 1); }
                                        closed => { body-area.images-closed = true; }
                                    }
                                }
                                // The paper card: tiles sit at fixed offsets over
                                // the page colour, so a tile not yet rasterized is
                                // blank paper. Centred on a 4 px grid so tiles stay
                                // on whole device pixels at 125%, 150% and 175%.
                                // Screen readers get the message text (the tiles
                                // are pixels).
                                page := Rectangle {
                                    property <bool> shown: root.r-html && !root.r-plain;
                                    height: self.shown ? root.r-page-height : 0px;
                                    visible: self.shown;
                                    accessible-role: text;
                                    accessible-label: @tr("Message");
                                    accessible-value: root.r-body;
                                    // Fixed-width mail comes scaled to the column; at the
                                    // smallest scale the page is wider and scrolls sideways
                                    // (Shift+wheel or the bar). A drag still selects text.
                                    ScrollView {
                                        width: parent.width;
                                        height: parent.height;
                                        vertical-scrollbar-policy: always-off;
                                        content-width: max(self.visible-width, root.r-page-width);
                                        content-height: self.visible-height;
                                        content-x <=> root.r-page-x;
                                        Rectangle {
                                            x: max(0px, round((parent.width - root.r-page-width) / 8px) * 4px);
                                            width: root.r-page-width;
                                            background: root.r-paper;
                                            clip: true;
                                            for t[i] in root.r-tiles: Image {
                                                y: i * 256px;
                                                width: root.r-page-width;
                                                height: t.h;
                                                source: t.img;
                                                image-fit: fill;
                                            }
                                            for r in root.r-selection: Rectangle {
                                                x: r.x;
                                                y: r.y;
                                                width: r.w;
                                                height: r.h;
                                                background: Theme.selection-bg.with-alpha(0.4);
                                            }
                                            // The focused link: the double focus ring,
                                            // radius 2 (docs/WINUI3.md "Control metrics").
                                            for r in root.r-focus: Rectangle {
                                                x: r.x;
                                                y: r.y;
                                                width: r.w;
                                                height: r.h;
                                                border-width: 2px;
                                                border-radius: 2px;
                                                border-color: Theme.focus;
                                                Rectangle {
                                                    x: 2px;
                                                    y: 2px;
                                                    width: parent.width - 4px;
                                                    height: parent.height - 4px;
                                                    border-width: 1px;
                                                    border-color: Theme.focus-inner;
                                                }
                                            }
                                            // Screen readers reach the links here (the
                                            // page itself is pixels).
                                            for l[i] in root.r-links: Rectangle {
                                                x: l.x;
                                                y: l.y;
                                                width: l.w;
                                                height: l.h;
                                                accessible-role: button;
                                                accessible-label: l.text;
                                                accessible-description: l.href;
                                                accessible-action-default => { root.r-activate(i); }
                                            }
                                            ContextMenuArea {
                                                Menu {
                                                    MenuItem {
                                                        title: @tr("Copy");
                                                        enabled: root.r-selection.length > 0;
                                                        activated => { root.r-copy(); }
                                                    }
                                                    MenuItem {
                                                        title: @tr("Select all");
                                                        activated => { root.r-select-all(); }
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: root.r-hover-link ? pointer : text;
                                                    changed mouse-x => { if self.has-hover && !self.pressed { root.r-hover(self.mouse-x, self.mouse-y); } }
                                                    changed mouse-y => { if self.has-hover && !self.pressed { root.r-hover(self.mouse-x, self.mouse-y); } }
                                                    changed has-hover => { if !self.has-hover { root.r-hover(-1px, -1px); } }
                                                    pointer-event(e) => {
                                                        // Any button focuses the page, so Ctrl+C works after the
                                                        // context menu's Select all.
                                                        if e.kind == PointerEventKind.down {
                                                            Focus.keyboard = false;
                                                            page-keys.focus();
                                                        }
                                                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                                            if e.modifiers.shift {
                                                                root.r-extend(self.mouse-x, self.mouse-y);
                                                            } else {
                                                                root.r-press(self.mouse-x, self.mouse-y);
                                                            }
                                                        }
                                                        // A click on a link (no drag, no Shift) follows it.
                                                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && !e.modifiers.shift {
                                                            root.r-release(self.mouse-x, self.mouse-y);
                                                        }
                                                    }
                                                    moved => {
                                                        if self.pressed {
                                                            root.r-extend(self.mouse-x, self.mouse-y);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // Tabbed to, before a link has the focus.
                                    FocusRing {
                                        inset: 1px;
                                        shown: page-keys.has-focus && root.r-focus.length == 0;
                                    }
                                }
                                if page.shown && root.r-truncated: HorizontalLayout {
                                    padding-top: Theme.s3;
                                    spacing: Theme.s2;
                                    alignment: start;
                                    Text {
                                        text: @tr("[Message shortened for display]");
                                        font-size: Theme.body;
                                        color: Theme.text-2;
                                    }
                                    HyperlinkButton {
                                        text: @tr("View as plain text");
                                        clicked => { root.r-plain = true; }
                                    }
                                }
                                // A Tab stop (its text can be selected with the
                                // keyboard), ringed while Tab put the focus there.
                                if root.r-plain || (!root.r-html && !root.r-waiting): plain-text := TextInput {
                                    text: root.r-body;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    font-size: Theme.body;
                                    color: Theme.text;
                                    selection-background-color: Theme.selection-bg;
                                    selection-foreground-color: Theme.selection-text;
                                    key-pressed(e) => {
                                        if e.text == Key.Backspace && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && root.backspace-archives {
                                            root.archive();
                                            return accept;
                                        }
                                        reject
                                    }
                                    FocusRing { shown: plain-text.has-focus; }
                                }
                            }
                        }
                    }
                }
                // One pane (below 720 px): the list's status line and Undo
                // offer would be hidden with it, so they show over the
                // reader's foot instead, never moving its content.
                if !root.show-list && (root.undo-text != "" || root.status != ""): VerticalLayout {
                    x: Theme.s3;
                    y: parent.height - self.height - Theme.s3;
                    z: 3;
                    width: parent.width - 2 * Theme.s3;
                    height: self.preferred-height;
                    spacing: Theme.s2;
                    if root.status != "": Rectangle {
                        background: Theme.card;
                        border-radius: Theme.radius-lg;
                        drop-shadow-blur: 8px;
                        drop-shadow-offset-y: 2px;
                        drop-shadow-color: Theme.contrast ? transparent : #00000024;
                        height: one-status.preferred-height;
                        one-status := StatusBar {
                            width: 100%;
                            text: root.status;
                            severity: root.status-severity;
                            action: root.status-action;
                            closable: root.status-closable;
                            act => { root.status-action-clicked(); }
                            closed => { root.dismiss-status(); }
                            escaped => { keys.focus(); }
                        }
                    }
                    if root.undo-text != "": UndoOffer {
                        text: root.undo-text;
                        hold(h) => { root.undo-hold(h); }
                        undo => { root.undo-clicked(); }
                    }
                }
            }
            Rectangle { width: root.show-reader ? root.tab-gutter : 0; }
        }

        // ---- Contacts, a page over the Mail tab's content card
        if root.show-contacts && root.mail-tab && !root.show-settings && !root.ob-open: ContactsPage {
            x: root.mail-shown ? root.nav-width + 1px : 0;
            y: root.content-top + (root.mail-shown ? 1px : 0);
            width: root.width - self.x;
            height: root.height - self.y;
        }

        // ---- Calendar, a page over the content card (as Settings)
        if root.show-calendar && !root.show-settings: CalendarPage {
            x: root.mail-shown ? root.nav-width + 1px : 0;
            y: root.content-top + (root.mail-shown ? 1px : 0);
            width: root.width - self.x;
            height: root.height - self.y;
            border-top-left-radius: root.mail-shown ? Theme.radius-lg - 1px : 0;
            lines: root.cal-lines;
            range: root.cal-range;
            loaded: root.cal-loaded;
            today => { root.cal-today(); }
            move(days) => { root.cal-move(days); }
        }

        // ---- Settings, a page over the content card
        if root.show-settings: SettingsPage {
            x: root.mail-shown ? root.nav-width + 1px : 0;
            y: root.content-top + (root.mail-shown ? 1px : 0);
            width: root.width - self.x;
            height: root.height - self.y;
            border-top-left-radius: root.mail-shown ? Theme.radius-lg - 1px : 0;
            rejected <=> root.a-rejected;
            cancel-check => { root.cancel-check(); }
            status-closable: root.status-closable;
            accounts: root.accounts;
            busy: root.a-busy;
            error: root.a-error;
            ok: root.a-ok;
            test-steps <=> root.a-test;
            cert-imap: root.a-cert-imap;
            cert-smtp: root.a-cert-smtp;
            pinned-imap: root.a-pinned-imap;
            pinned-smtp: root.a-pinned-smtp;
            review: root.a-review;
            cert-wait: root.a-reading;
            finding: root.a-finding;
            find-note: root.a-find-note;
            found-from: root.a-found-from;
            found-email: root.a-found-email;
            found-to: root.a-found-to;
            found-seq: root.a-found-seq;
            find-settings(email, fields) => { root.find-settings(email, fields); }
            roles: root.a-roles;
            choose-role(role, option) => { root.choose-role(role, option); }
            review-certificate(form, which) => { root.review-certificate(form, which); }
            forget-certificate(which) => { root.forget-certificate(which); }
            form-changed(form) => { root.account-form-changed(form); }
            form-opened => { root.account-form-opened(); }
            edit-id <=> root.a-edit-id;
            edit: root.a-edit;
            remote-senders: root.remote-senders;
            section <=> root.settings-section;
            refocus: root.settings-refocus;
            g-choices: root.g-choices;
            g-flash: root.g-flash;
            g-reopen-tabs: root.g-reopen-tabs;
            g-notify: root.g-notify;
            g-notify-detail: root.g-notify-detail;
            g-cal-remind: root.g-cal-remind;
            g-close-to-tray: root.g-close-to-tray;
            g-autostart: root.g-autostart;
            g-language: root.g-language;
            g-diag: root.g-diag;
            about-version: root.about-version;
            about-data: root.about-data;
            status: root.status;
            status-severity: root.status-severity;
            status-action: root.status-action;
            status-action-clicked => { root.status-action-clicked(); }
            dismiss-status => { root.dismiss-status(); }
            add-account => { root.open-onboarding(); }
            general-changed(which, value) => { root.general-changed(which, value); }
            open-repository => { root.open-repository(); }
            open-data-folder => { root.open-data-folder(); }
            show-tips-again => { root.show-tips-again(); }
            show-shortcuts => { root.open-shortcuts(); }
            about-link(which) => { root.welcome-link(which); }
            up-state: root.up-state;
            up-version: root.up-version;
            up-error: root.up-error;
            up-retry: root.up-retry;
            up-progress: root.up-progress;
            up-done: root.up-done;
            up-total: root.up-total;
            up-auto: root.up-auto;
            update-action(which) => { root.update-action(which); }
            copy-text(t) => { root.r-copy-text(t); }
            forget-remote(a) => { root.forget-remote(a); }
            forget-all-remote => { root.forget-all-remote(); }
            close => { root.close-settings(root.settings-from); }
            save-account(form) => { root.save-account(form); }
            test-account(form) => { root.test-account(form); }
            edit-account(id) => { root.edit-account(id); }
            remove-account(id) => { root.remove-account(id); }
            account-enabled(id, on) => { root.account-enabled(id, on); }
            account-notify(id, on) => { root.account-notify(id, on); }
            move-account(id, up) => { root.move-account(id, up); }
            redownload(id) => { root.redownload-account(id); }
            remove-all-data => { root.remove-all-data(); }
            review-changed(id) => { root.review-changed-certificate(id); }
            open-logs-folder => { root.open-logs-folder(); }
            edit-index: root.a-edit-index;
            edit-preset: root.a-edit-preset;
            scroll-folders <=> root.a-scroll-folders;
        }

        // ---- the first run and Add account (ui/onboarding.slint): the
        // whole window under the title bar, or (from Settings) the content
        // area; over Settings while the flow is open.
        if root.ob-shown: OnboardingPage {
            visible: root.ob-open || !root.show-settings;
            x: root.ob-embedded ? root.nav-width + 1px : 0;
            y: root.bar-height + (root.ob-embedded ? 1px : 0);
            width: root.width - self.x;
            height: root.height - self.y;
            border-top-left-radius: root.ob-embedded ? Theme.radius-lg - 1px : 0;
            embedded: root.ob-embedded;
            window-wide: root.width >= 1040px;
            step <=> root.ob-step;
            email <=> root.ob-email;
            refocus: root.ob-refocus;
            busy: root.a-busy;
            error: root.a-error;
            error-kind: root.a-error-kind;
            test-steps: root.a-test;
            rejected <=> root.a-rejected;
            review: root.a-review;
            cert-imap: root.a-cert-imap;
            cert-smtp: root.a-cert-smtp;
            pinned-imap: root.a-pinned-imap;
            pinned-smtp: root.a-pinned-smtp;
            finding: root.a-finding;
            find-note: root.a-find-note;
            found-from: root.a-found-from;
            found-email: root.a-found-email;
            found-to: root.a-found-to;
            found-seq: root.a-found-seq;
            chip: root.ob-chip;
            chip-host: root.ob-chip-host;
            domain: root.ob-domain;
            provider <=> root.ob-provider;
            manual <=> root.ob-manual;
            offline-note: root.ob-offline;
            email-problem <=> root.ob-email-problem;
            name <=> root.ob-name;
            address: root.ob-address;
            sync: root.ob-sync;
            sync-value: root.ob-sync-value;
            sync-text: root.ob-sync-text;
            newest: root.ob-newest;
            slow <=> root.ob-slow;
            language: root.g-language;
            continue-email(email, fields) => { root.onboard-continue(email, fields); }
            sign-in(form) => { root.save-account(form); }
            cancel-check => { root.cancel-check(); }
            find-settings(email, fields) => { root.find-settings(email, fields); }
            review-certificate(form, which) => { root.review-certificate(form, which); }
            forget-certificate(which) => { root.forget-certificate(which); }
            form-changed(form) => { root.account-form-changed(form); }
            reset => { root.onboard-closed(); }
            personalise(save, name, signature) => { root.onboard-personalise(save, name, signature); }
            open-inbox => { root.onboard-open-inbox(); }
            close => { root.close-onboarding(); }
            link(which) => { root.welcome-link(which); }
            language-changed(i) => { root.general-changed(6, i); }
            open-settings => {
                root.settings-section = 3;
                root.show-settings = true;
            }
        }

        // ---- folder pane (docs/WINUI3.md "NavigationView, left"): on the
        // layer, or the narrow rail; the rail's toggle opens it over the
        // content on the flyout surface until Esc, a click outside it or a
        // choice closes it.
        // Opened over the content: the content under smoke (#4D000000,
        // WinUI's light-dismiss overlay), which a click closes.
        if root.pane-open: Rectangle {
            x: Theme.rail-width;
            y: root.content-top;
            width: root.width - self.x;
            height: root.height - self.y;
            background: Theme.scrim;
            TouchArea { clicked => { root.pane-open = false; } }
        }
        // The flyout's shadow on the smoke: 16 px fading from the pane's
        // edge (the software renderer draws no drop-shadow).
        if root.pane-open && !Theme.contrast: Rectangle {
            x: Theme.pane-width;
            y: root.content-top;
            width: 16px;
            height: root.height - self.y;
            background: @linear-gradient(90deg, #00000040 0%, #00000000 100%);
        }
        Rectangle {
            // The welcome has the whole window until the first account; a
            // message or draft tab, and a message window, have no pane.
            visible: root.pane-shown;
            x: 0;
            y: root.content-top;
            // Follows the animated width; the rows switch at once.
            width: root.pane-open ? Theme.pane-width : root.nav-width;
            height: root.height - self.y;
            clip: true;
            background: root.pane-open ? Theme.flyout : transparent;
            // Opened over the content, its edge reads against the white
            // card in light (`surface-stroke`; WindowText under HC).
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: root.pane-open ? Theme.surface-stroke : transparent;
            }
            VerticalLayout {
                padding: Theme.s1;
                // Room for the toggle above and the footer below.
                padding-top: root.rail || root.pane-open ? 2 * Theme.s2 + Theme.rail-row : Theme.s2;
                padding-bottom: 2 * Theme.s1 + Theme.s2 + 2 * (root.rail ? Theme.rail-row : Theme.nav-row)
                    + (root.mail-shown ? Theme.s1 + (root.rail ? Theme.rail-row : Theme.nav-row) : 0);
                spacing: Theme.s2;
                // In the rail: the accent button with its name under it, as
                // the rail's other items have.
                Rectangle {
                    height: root.mail-shown ? new-mail.natural-height + (root.rail ? new-mail-label.height + 2px : 0) : 0;
                    visible: root.mail-shown;
                    // The full pane's toggle (WinUI's PaneToggleButton,
                    // E700), before New mail as in Outlook; the rail and the
                    // overlay have theirs at the top (`pane-chrome`).
                    pane-hide := IconButton {
                        visible: !root.rail && !root.pane-open;
                        x: 0;
                        y: 0;
                        width: self.visible ? 40px : 0;
                        height: new-mail.height;
                        icon: Icons.menu;
                        tooltip: @tr("Hide folders (Ctrl+Shift+E)");
                        changed has-focus => {
                            if self.has-focus {
                                root.chrome-focus = 6;
                            } else if root.chrome-focus == 6 {
                                root.chrome-focus = 0;
                            }
                        }
                        clicked => { root.toggle-pane(); }
                    }
                    new-mail := Button {
                        property <length> lead: pane-hide.width + (pane-hide.visible ? Theme.s1 : 0);
                        x: root.rail ? (parent.width - 40px) / 2 : self.lead;
                        y: 0;
                        width: root.rail ? 40px : parent.width - self.lead;
                        accent: true;
                        icon: Icons.compose;
                        label: root.rail ? "" : @tr("New mail");
                        tooltip: @tr("New mail (Ctrl+N)");
                        // Hidden until there is an account to write from.
                        enabled: root.mail-shown;
                        clicked => { root.new-mail-chosen(); }
                    }
                    new-mail-label := Text {
                        x: 1px;
                        y: new-mail.height + 2px;
                        width: parent.width - 2px;
                        height: root.rail ? min(self.preferred-height, 2 * Theme.caption-line + 2px) : 0;
                        visible: root.rail;
                        text: @tr("New mail");
                        font-size: Theme.caption;
                        color: Theme.text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                        accessible-role: none;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.new-mail-chosen(); }
                        }
                    }
                }
                // One Tab stop: Up/Down (Home/End) move along the folders,
                // Enter or Space opens one (or folds an account line);
                // Right opens a folded line, then goes to its first child,
                // Left folds an open line, else goes to the parent line
                // (TreeView; not in the rail); Shift+F10 or the Menu key
                // opens the row's menu under it.
                nav := FocusScope {
                    vertical-stretch: 1;
                    accessible-role: AccessibleRole.list;
                    accessible-label: @tr("Folders");
                    accessible-delegate-focus: root.nav-cursor;
                    // Each change opens the current row's menu under it.
                    property <int> menu-seq;
                    // The overlay has been scrolled to the selected folder
                    // since it opened.
                    property <bool> revealed;
                    // The sliding selection pill's top in the list; placed
                    // at once the first time, then it slides.
                    property <length> pill-y;
                    property <bool> pill-placed;
                    // A new selection slides; a reflow moves it with its row.
                    property <bool> pill-slide;
                    function pill-to(y: length, slide: bool) {
                        self.pill-slide = slide && self.pill-placed;
                        self.pill-y = y;
                        self.pill-placed = true;
                    }
                    function step(d: int) {
                        root.nav-cursor = clamp(root.nav-cursor + d, 0, root.shown-nav.length - 1);
                    }
                    function open() {
                        let item = root.shown-nav[root.nav-cursor];
                        if item.kind == 1 {
                            root.nav-toggle(item);
                        } else {
                            root.nav-chosen(item);
                        }
                        // Opening a folder hands the list the focus; the
                        // keyboard stays here.
                        self.focus();
                    }
                    function ensure-visible(y: length, h: length) {
                        if y + nav-flick.content-y < 0 {
                            nav-flick.content-y = -y;
                        } else if y + h + nav-flick.content-y > nav-flick.height {
                            nav-flick.content-y = nav-flick.height - y - h;
                        }
                    }
                    key-pressed(e) => {
                        if root.shown-nav.length == 0 || e.modifiers.control || e.modifiers.alt {
                            return reject;
                        }
                        if (e.text == Key.F10 && e.modifiers.shift) || (e.text == Key.Menu && !e.modifiers.shift) {
                            self.menu-seq += 1;
                            return accept;
                        }
                        if e.modifiers.shift {
                            return reject;
                        }
                        let i = root.nav-cursor;
                        let item = root.shown-nav[i];
                        let parent = item.kind == 1 || (item.kind == 2 && item.has-children);
                        if e.text == Key.DownArrow {
                            self.step(1);
                        } else if e.text == Key.UpArrow {
                            self.step(-1);
                        } else if e.text == Key.Home {
                            root.nav-cursor = 0;
                        } else if e.text == Key.End {
                            root.nav-cursor = root.shown-nav.length - 1;
                        } else if e.text == Key.Return || e.text == " " {
                            self.open();
                        } else if root.rail && (e.text == Key.RightArrow || e.text == Key.LeftArrow) {
                            // (No tree in the rail.)
                        } else if e.text == Key.RightArrow {
                            if parent && !item.expanded {
                                root.nav-toggle(item);
                            } else if parent && i + 1 < root.shown-nav.length && root.shown-nav[i + 1].parent == i {
                                root.nav-cursor = i + 1;
                            }
                        } else if e.text == Key.LeftArrow {
                            if parent && item.expanded {
                                root.nav-toggle(item);
                            } else if item.parent >= 0 {
                                root.nav-cursor = item.parent;
                            }
                        } else {
                            return reject;
                        }
                        accept
                    }
                    nav-flick := Flickable {
                        width: 100%;
                        height: 100%;
                        content-height: nav-col.preferred-height;
                        nav-col := VerticalLayout {
                            alignment: start;
                            spacing: Theme.s1;
                            for item[i] in root.shown-nav: NavRow {
                                property <bool> current: i == root.nav-cursor;
                                property <int> menu-seq: nav.menu-seq;
                                item: item;
                                compact: root.rail;
                                on-flyout: root.pane-open;
                                // The rail's first account tile: 8 px of space above it.
                                group-start: root.rail && item.initial != "" && i > 0 && root.shown-nav[i - 1].initial == "";
                                // Settings, while shown, is the one selected item.
                                selected: !root.show-settings && !root.show-calendar && i == root.shown-pill;
                                ring: nav.has-focus && Focus.keyboard && self.current;
                                own-pill: false;
                                changed current => { if self.current { nav.ensure-visible(self.y, self.height); } }
                                changed selected => { if self.selected { nav.pill-to(self.y + self.pill-y, true); } }
                                changed y => { if self.selected { nav.pill-to(self.y + self.pill-y, false); } }
                                changed pill-y => { if self.selected { nav.pill-to(self.y + self.pill-y, false); } }
                                // The overlay opens on the selected folder (its rows
                                // are made anew as it opens); once, as folding
                                // makes them anew too.
                                init => {
                                    if self.selected {
                                        nav.pill-to(self.y + self.pill-y, false);
                                    }
                                    if root.pane-open && self.selected && !nav.revealed {
                                        nav.revealed = true;
                                        nav.ensure-visible(self.y, self.height);
                                    }
                                }
                                changed menu-seq => {
                                    if self.current {
                                        nav.ensure-visible(self.y, self.height);
                                        root.show-nav-menu(item, self.absolute-position.x + Theme.s6, self.absolute-position.y + self.height);
                                    }
                                }
                                context(x, y) => {
                                    // The keyboard's row too, so Shift+F10 asks for
                                    // the same row's menu again.
                                    root.nav-cursor = i;
                                    nav.focus();
                                    root.show-nav-menu(item, x, y);
                                }
                                clicked => {
                                    root.nav-chosen(item);
                                    keys.focus();
                                }
                                // The caution button: the account's page.
                                alert => { root.nav-command(item, 4, item.account); }
                                toggled => {
                                    root.nav-cursor = i;
                                    root.nav-toggle(item);
                                    nav.focus();
                                }
                            }
                        }
                        // The selection pill (3x16, accent), sliding between
                        // rows (0 ms with animation effects off).
                        Rectangle {
                            x: 0;
                            y: nav.pill-y;
                            width: 3px;
                            height: 16px;
                            border-radius: 2px;
                            visible: nav.pill-placed && !root.show-settings && !root.show-calendar && root.shown-pill >= 0 && root.shown-pill < root.shown-nav.length;
                            background: Theme.on-fill(true, Theme.accent);
                            animate y { duration: nav.pill-slide ? Theme.normal : 0ms; easing: cubic-bezier(0, 0, 0, 1); }
                        }
                    }
                    // The list's thin scroll bar, its thumb in the pane's
                    // right 4 px.
                    // 8 px wide (the list's is 12), so it starts where the
                    // account line's "..." ends; its thumb draws where the
                    // list's would.
                    ScrollThumb {
                        width: 8px;
                        x: parent.width + Theme.s1 - self.width;
                        content-y <=> nav-flick.content-y;
                        total: nav-col.preferred-height;
                        visible-height: nav-flick.height;
                    }
                }
            }
            // While rows are scrolled away: a 1 px edge under New mail
            // (scrolled down) and the footer separator above Settings (rows
            // below), both in the middle of the 8 px between.
            Rectangle {
                x: Theme.s1;
                y: nav.y - Theme.s1;
                width: parent.width - 2 * Theme.s1;
                height: 1px;
                background: nav-flick.content-y < 0 ? Theme.stroke : transparent;
            }
            Rectangle {
                x: Theme.s1;
                y: nav.y + nav.height + Theme.s1 - 1px;
                width: parent.width - 2 * Theme.s1;
                height: 1px;
                background: nav-col.preferred-height + nav-flick.content-y > nav-flick.height + 0.5px ? Theme.stroke : transparent;
            }
            // The rail's pane toggle (WinUI's PaneToggleButton, 40x36) at
            // the top and the Settings footer item at the bottom: one
            // repeater, so they share one copy of NavRow's code.
            for c in root.pane-chrome: NavRow {
                x: Theme.s1;
                y: c.kind == 6 ? Theme.s2 : c.kind == 7 ? parent.height - (root.mail-shown ? 3 : 2) * (self.height + Theme.s1) : c.kind == 8 ? parent.height - 2 * (self.height + Theme.s1) : parent.height - self.height - Theme.s1;
                width: c.kind == 6 ? Theme.rail-width - 2 * Theme.s1 : parent.width - 2 * Theme.s1;
                item: c;
                compact: c.kind == 6 || root.rail;
                on-flyout: root.pane-open;
                selected: (c.kind == 5 && root.show-settings) || (c.kind == 7 && root.show-contacts && !root.show-settings) || (c.kind == 8 && root.show-calendar && !root.show-settings);
                tab-stop: true;
                focus-seq: c.kind == 5 ? root.chrome-refocus : 0;
                accessible-role: button;
                accessible-label: self.tooltip;
                // WinUI's own names (NavigationButtonOpenName / ClosedName).
                tooltip: c.kind == 5 ? @tr("Settings (Ctrl+,)") : c.kind == 7 ? @tr("Contacts") : c.kind == 8 ? @tr("Calendar") : root.pane-open ? @tr("Folders (Close navigation)")
                    : !root.compact ? @tr("Show folders (Ctrl+Shift+E)") : @tr("Folders (Open navigation)");
                changed has-focus => {
                    if self.has-focus {
                        root.chrome-focus = c.kind;
                    } else if root.chrome-focus == c.kind {
                        root.chrome-focus = 0;
                    }
                }
                clicked => {
                    if c.kind == 7 {
                        root.pane-open = false;
                        if root.show-settings {
                            root.close-settings(2);
                        }
                        if !root.mail-tab {
                            root.tab-activate(0);
                        }
                        root.show-calendar = false;
                        root.show-contacts = !root.show-contacts;
                        root.contacts-toggled(root.show-contacts);
                    } else if c.kind == 8 {
                        // Calendar opens over the content and closes again.
                        root.pane-open = false;
                        if root.show-settings {
                            root.close-settings(2);
                        }
                        if root.show-contacts {
                            root.show-contacts = false;
                            root.contacts-toggled(false);
                        }
                        root.show-calendar = !root.show-calendar;
                    } else if c.kind == 5 {
                        // The gear opens Settings and closes them again.
                        root.pane-open = false;
                        if root.show-settings {
                            root.close-settings(root.settings-from);
                        } else {
                            root.settings-from = 1;
                            root.show-settings = true;
                        }
                    } else {
                        root.toggle-pane();
                    }
                }
            }
        }
    }

    // The rail's words, measured (none is drawn): the column is as wide
    // as the longest (`rail-measure`).
    Rectangle {
        width: 0;
        height: 0;
        clip: true;
        rail-words-col := VerticalLayout {
            for w in root.rail-words: Text {
                text: w;
                font-size: Theme.caption;
                accessible-role: none;
            }
        }
    }

    // The clipboard path for text selected on an HTML page (see r-copy-text).
    Rectangle {
        width: 0;
        height: 0;
        clip: true;
        copy-buf := TextInput {
            read-only: true;
            accessible-role: none;
        }
    }

    // ---- the teaching tip (docs/WINUI3.md "TeachingTip"), over the
    // content and under the dialogs: non-modal, never focused by itself,
    // 8 px beside its target and below the title bar (whose passthrough
    // rectangles would take its clicks). Search: under the search box,
    // over the reader column (never over the current row or the status
    // line at the top of the list). Help: above the Settings footer, in
    // the wide pane, or beside the rail's. Folders: beside the rail's
    // pane toggle.
    if root.tip-visible: TeachingTip {
        property <length> list-right: root.nav-width + 1px + list-col.width;
        // In the wide pane while its 248 px hold the tip (up to a text
        // size of about 170 %), else beside the footer.
        property <bool> in-pane: root.tip-kind == 3 && !root.rail && Theme.body < 24px;
        property <length> top: root.content-top + Theme.s2;
        width: self.in-pane ? Theme.pane-width - 2 * Theme.s2 : min(320px, root.width - root.nav-width - 2 * Theme.s2);
        // Search: beside the list over the reader column; with no reader
        // column (the list stretched below 1040 px, or one pane), under the
        // search box itself, over the list's header.
        x: root.tip-kind == 2 ? clamp(max(search.x, root.show-reader ? self.list-right + Theme.s2 : root.nav-width + Theme.s2), Theme.s2, root.width - self.width - Theme.s2)
            : self.in-pane ? Theme.s2
            : root.tip-kind == 3 ? root.nav-width + Theme.s2
            : Theme.rail-width + Theme.s2;
        y: root.tip-kind == 2 ? max(self.top, search.y + search.height + Theme.s2)
            : root.tip-kind == 1 ? self.top
            : self.in-pane ? max(self.top, root.height - Theme.s1 - Theme.nav-row - Theme.s2 - self.height)
            : max(self.top, root.height - Theme.s1 - self.height);
        title: root.tip-kind == 1 ? @tr("teaching tip" => "Your folders")
            : root.tip-kind == 2 ? @tr("teaching tip" => "Search")
            : @tr("teaching tip" => "Keys and help");
        text: root.tip-kind == 1 ? @tr("Accounts and folders are behind this button when the window is narrow.")
            : root.tip-kind == 2 ? @tr("Search this folder or all folders. Ctrl+E or Ctrl+F opens it.")
            : @tr("Keyboard shortcuts and help are in Settings › About, or press F1.");
        place: @tr("teaching tip" => "{0} of {1}", root.tip-n, root.tip-of);
        got-it => { root.tip-got-it(); }
        skip => { root.tip-skip(); }
    }

    // ---- Keyboard shortcuts (F1, Ctrl+/, Settings > About): a tall
    // ContentDialog (docs/WINUI3.md "ContentDialog") with the README's
    // keys in two columns by group, and Close (focused; Esc and Enter).
    if root.shortcuts-show: Rectangle {
        background: Theme.scrim;
        TouchArea { }  // swallow clicks behind the dialog
        FocusScope {
            // The list scrolls from the keyboard too (Close keeps the
            // focus): Up / Down a row, PageUp / PageDown a page, Home / End.
            function scroll-by(dy: length) {
                shortcuts-list.content-y = clamp(shortcuts-list.content-y - dy,
                    min(0px, shortcuts-list.visible-height - shortcuts-list.content-height), 0px);
            }
            key-pressed(e) => {
                if e.text == Key.Escape || e.text == Key.Return {
                    root.shortcuts-show = false;
                    return accept;
                }
                if e.text == Key.DownArrow || e.text == Key.UpArrow {
                    scroll-by(e.text == Key.DownArrow ? 36px : -36px);
                    return accept;
                }
                if e.text == Key.PageDown || e.text == Key.PageUp {
                    scroll-by(e.text == Key.PageDown ? shortcuts-list.visible-height : -shortcuts-list.visible-height);
                    return accept;
                }
                if e.text == Key.Home || e.text == Key.End {
                    scroll-by(e.text == Key.Home ? -shortcuts-list.content-height : shortcuts-list.content-height);
                    return accept;
                }
                // Tab moves between the traps; every other key stops here,
                // so Ctrl+N, Ctrl+E or Ctrl+, never act behind the scrim.
                if e.text == Key.Tab || e.text == Key.Backtab {
                    return reject;
                }
                accept
            }
            DialogCard {
                width: min(640px, root.width - 32px);
                height: min(756px, root.height - 32px);
                accessible-role: groupbox;
                accessible-label: @tr("Keyboard shortcuts");
                accessible-description: @tr("Every key, by group. Up and Down scroll the list; Esc closes.");
                FocusTrap { entered => { shortcuts-close.focus(); } }
                VerticalLayout {
                    VerticalLayout {
                        padding: Theme.s6;
                        padding-bottom: Theme.s3;
                        spacing: Theme.s3;
                        vertical-stretch: 1;
                        Text {
                            text: @tr("Keyboard shortcuts");
                            font-family: Theme.display-font;
                            font-size: Theme.title;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        shortcuts-list := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                padding-right: Theme.s3;
                                for r in Shortcuts.rows: HorizontalLayout {
                                    padding-top: r.heading ? Theme.s4 : Theme.s1;
                                    padding-bottom: Theme.s1;
                                    spacing: r.heading ? 0 : Theme.s4;
                                    Text {
                                        width: r.heading ? 0 : min(200px, shortcuts-list.width * 0.4);
                                        text: r.keys;
                                        font-size: Theme.body;
                                        font-weight: 600;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: r.action;
                                        font-size: Theme.body;
                                        font-weight: r.heading ? 600 : 400;
                                        color: r.heading ? Theme.text : Theme.text-2;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.card-edge;
                    }
                    Rectangle {
                        background: Theme.layer;
                        HorizontalLayout {
                            padding: Theme.s6;
                            alignment: end;
                            shortcuts-close := Button {
                                init => { self.focus(); }
                                accent: true;
                                label: @tr("Close");
                                min-width: max(self.natural-width, 120px);
                                clicked => { root.shortcuts-show = false; }
                            }
                        }
                    }
                }
                FocusTrap { entered => { shortcuts-close.focus(); } }
            }
        }
    }

    // ---- confirm before a web link opens in the browser: Open has the
    // focus, or Cancel when there are warnings; Enter opens only a link
    // with nothing to warn about.
    if root.l-show: Rectangle {
        ContentDialog {
            title: @tr("Open this link in your browser?");
            text: root.l-host;
            address: true;
            detail: root.l-before + root.l-host + root.l-after;
            warnings: root.l-warnings;
            primary-text: @tr("Open");
            focus-close: root.l-warnings.length > 0;
            enter-primary: root.l-warnings.length == 0;
            max-card-width: 520px;
            primary => {
                root.l-open();
                root.page-back();
            }
            close => {
                root.l-cancel();
                root.page-back();
            }
        }
    }


    // ---- the encrypted cache's question, and the locked-cache dialog.
    CacheLockDialogs {}

    // ---- confirm before a draft with content is discarded: a destructive
    // question (docs/WINUI3.md "ContentDialog"), so no accent default and
    // Cancel has the focus; Esc cancels.
    // ---- before a formatted message becomes plain text (it can be undone).
    if Rich.plain-ask: Rectangle {
        ContentDialog {
            title: @tr("Switch to plain text?");
            text: @tr("Formatting, tables and the signature logo are removed. You can undo this.");
            primary-text: @tr("Switch to plain text");
            max-card-width: 440px;
            primary => {
                Rich.plain-ask = false;
                Rich.set-rich(false);
            }
            close => { Rich.plain-ask = false; }
        }
    }

    if root.c-confirm-discard: Rectangle {
        ContentDialog {
            title: @tr("Discard this draft?");
            text: Tr.q-discard-text();
            primary-text: @tr("Discard");
            destructive: true;
            focus-close: true;
            max-card-width: 440px;
            primary => { root.discard-confirmed(); }
            close => { root.c-confirm-discard = false; }
        }
    }

    // ---- Show original: the open message's header fields and source, a
    // tall ContentDialog (docs/WINUI3.md "ContentDialog": the content on the
    // card, the button bar on the layer). Close has the focus; Esc closes.
    if root.src-show: Rectangle {
        background: Theme.scrim;
        TouchArea { }  // swallow clicks behind the dialog
        FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.src-show = false;
                    return accept;
                }
                reject
            }
            DialogCard {
                width: min(760px, root.width - 32px);
                height: root.height - 32px;
                FocusTrap { entered => { src-close.focus(); } }
                VerticalLayout {
                    VerticalLayout {
                        padding: Theme.s6;
                        spacing: Theme.s3;
                        vertical-stretch: 1;
                        Text {
                            text: @tr("Original message");
                            font-family: Theme.display-font;
                            font-size: Theme.title;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if root.src-msgid != "": TextInput {
                            text: @tr("Message-ID: {0}", root.src-msgid);
                            read-only: true;
                            font-size: Theme.caption;
                            color: Theme.text-2;
                            wrap: char-wrap;
                            selection-background-color: Theme.selection-bg;
                            selection-foreground-color: Theme.selection-text;
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: Theme.s3;
                                padding-right: Theme.s3;
                                Heading { text: @tr("Header fields"); }
                                src-headers := TextInput {
                                    text: root.src-headers;
                                    read-only: true;
                                    single-line: false;
                                    wrap: char-wrap;
                                    font-family: Theme.mono-font;
                                    font-size: Theme.caption;
                                    color: Theme.text;
                                    accessible-label: @tr("Header fields");
                                    selection-background-color: Theme.selection-bg;
                                    selection-foreground-color: Theme.selection-text;
                                }
                                Divider { }
                                Heading { text: @tr("Source"); }
                                TextInput {
                                    text: root.src-body;
                                    read-only: true;
                                    single-line: false;
                                    wrap: char-wrap;
                                    font-family: Theme.mono-font;
                                    font-size: Theme.caption;
                                    color: Theme.text;
                                    accessible-label: @tr("Message source");
                                    selection-background-color: Theme.selection-bg;
                                    selection-foreground-color: Theme.selection-text;
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.card-edge;
                    }
                    Rectangle {
                        background: Theme.layer;
                        // Equal buttons (docs/WINUI3.md "ContentDialog"):
                        // they grow from the same width, none narrower
                        // than its label.
                        HorizontalLayout {
                            padding: Theme.s6;
                            spacing: Theme.s2;
                            if root.src-msgid != "": HorizontalLayout {
                                horizontal-stretch: 1;
                                Button {
                                    label: @tr("Copy Message-ID");
                                    min-width: self.natural-width;
                                    preferred-width: 0;
                                    horizontal-stretch: 1;
                                    clicked => { root.r-copy-text(root.src-msgid); }
                                }
                            }
                            Button {
                                label: @tr("Copy headers");
                                min-width: self.natural-width;
                                preferred-width: 0;
                                horizontal-stretch: 1;
                                clicked => { root.r-copy-text(root.src-headers); }
                            }
                            Button {
                                accent: true;
                                label: @tr("Copy all");
                                min-width: self.natural-width;
                                preferred-width: 0;
                                horizontal-stretch: 1;
                                clicked => { root.r-copy-text(root.src-headers + "\n\n" + root.src-body); }
                            }
                            src-close := Button {
                                init => { self.focus(); }
                                label: @tr("Close");
                                min-width: self.natural-width;
                                preferred-width: 0;
                                horizontal-stretch: 1;
                                clicked => { root.src-show = false; }
                            }
                        }
                    }
                }
                FocusTrap { entered => { src-headers.focus(); } }
            }
        }
    }

    // ---- a yes/no prompt (docs/WINUI3.md "ContentDialog"): a destructive
    // one (a resend, a discard, a removal) starts on Cancel and has no
    // default button, so a stray Enter never confirms it; any other (an
    // invitation's reply, Download again) has the accent default, which
    // Enter presses.
    if root.q-title != "": Rectangle {
        ContentDialog {
            title: root.q-title;
            text: root.q-text;
            detail: root.q-detail;
            code: root.q-code;
            code-label: root.q-code-label;
            code-old: root.q-old;
            code-old-label: root.q-old-label;
            code-caution: root.q-caution;
            code-note: root.q-note;
            copy-code => { root.q-alt-answer(); }
            primary-text: root.q-ok;
            secondary-text: root.q-alt;
            destructive: root.q-destructive;
            focus-close: root.q-destructive;
            enter-primary: !root.q-destructive;
            // Three equal buttons need WinUI's widest dialog; so does a
            // fingerprint, which is shown whole.
            max-card-width: root.q-alt != "" || root.q-code != "" ? 548px : 440px;
            primary => { root.q-answer(true); }
            secondary => { root.q-alt-answer(); }
            close => { root.q-answer(false); }
            if root.q-choices.length > 0: RadioButtons {
                label: @tr("What to trust");
                items: root.q-choices;
                selected <=> root.q-choice;
            }
        }
    }

    // ---- the sender notice's "Why?": what the check is, and what to do,
    // with one Close button.
    if root.why-show: Rectangle {
        ContentDialog {
            title: @tr("Why am I seeing this?");
            text: @tr("Komorebi looks at the checks your mail server made when this message arrived, and at the sender's name and address. When they don't add up, someone may be pretending to be the sender.") + "\n\n" + @tr("Don't open its links or attachments, reply, or enter a password unless you're sure. If you know the sender, check with them another way. Report junk moves it to your Junk folder.");
            primary-text: @tr("Close");
            single: true;
            max-card-width: 440px;
            primary => { root.why-show = false; }
            close => { root.why-show = false; }
        }
    }

    // ---- the tooltip (docs/WINUI3.md "ToolTip"), over everything: under
    // its control, or over it where the window ends, centred on it.
    if Tip.shown: Rectangle {
        property <length> w: min(320px, tip-text.preferred-width + 18px);
        property <length> below: Tip.at-y + Tip.at-h + Theme.s1;
        width: self.w;
        height: tip-text.preferred-height + 14px;
        x: clamp(Tip.at-x + (Tip.at-w - self.w) / 2, Theme.s1, root.width - self.w - Theme.s1);
        y: self.below + self.height > root.height ? Tip.at-y - self.height - Theme.s1 : self.below;
        background: Theme.flyout;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.flyout-stroke;
        tip-text := Text {
            x: 9px;
            y: 6px;
            width: parent.width - 18px;
            text: Tip.text;
            font-size: Theme.caption;
            color: Theme.text;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}
