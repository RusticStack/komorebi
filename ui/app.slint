import { ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Icons, Tip } from "theme.slint";
import { Tr } from "tr.slint";
import { Shortcuts, ShortcutRow } from "shortcuts.slint";
import { ServerPorts, Discovery, ServerFields, AccountForm, GroupHeader, FieldHeader, FieldNote, StepList, CertLine, FindSettingsRow, SmtpNoAuth } from "forms.slint";
import { OnboardingPage, Onboard } from "onboarding.slint";
import { ContactsPage, Contacts, ContactItem, ContactLine, BookItem } from "contacts.slint";
import { Recipients, RecipientChip, RecipientField } from "chips.slint";
import { CalendarPage, AgendaLine, CalSync, Cal, CalChip, CalCell, CalBlock, CalAllDay } from "calendar.slint";
import { Rich, Sigs, SigRow, RichBody, RichToolbar, EdState, EdFormat, EdPiece, EdRect, EdAction, EdKey } from "editor.slint";
import { RulesUi, RuleRow, CondRow, LogRow, RulesList, RuleEditor } from "rules.slint";
import { NavItem, MenuCommand, MailRow, AttachmentRow, AccountRow, FolderOption, Focus, FocusRing, FocusTrap, Icon, Button, IconButton, HyperlinkButton, NavRow, MailItem, Chip, FieldLabel, ComposeBody, TextField, CheckBox, ToggleSwitch, Severity, InfoBar, ContentDialog, ProgressRing, ProgressBar, SelectorBar, SettingsCard, SettingsSurface, SearchBox, ScopeBox, CaptionButton, BarRect, TipTimer, Flyout, FlyoutItem, ComboBox, ScrollThumb, RadioButtons, RadioItem, Expander, TeachingTip, PressKeys, TabItem, TabStrip } from "widgets.slint";

import { CacheLock, CacheLockDialogs } from "cachelock.slint";
export { AgendaLine, CacheLock, CalSync, Cal, CalChip, CalCell, CalBlock, CalAllDay, Contacts, ContactItem, ContactLine, BookItem, Recipients, RecipientChip, TabItem, Theme, Palette, Severity, Tr, ServerPorts, Discovery, ServerFields, AccountForm, Onboard, Rich, Sigs, SigRow, EdState, EdFormat, EdPiece, EdRect, EdAction, EdKey, RulesUi, RuleRow, CondRow, LogRow }

// One folder role of the account form (Edit account > Folders): the folders
// to choose from (the first is "Automatic": what the server marks) and the
// one chosen.
export struct RoleChoice {
    options: [string],
    current: int,
}

// A composer field, for edits, focus and address checks.
export enum ComposeField { to, cc, bcc, subject, body }

// A recipient suggested from the contacts or the address index (`name`
// may be empty). `kind`: 0 seen in mail, 1 a contact, 2 a group of
// `count` people (`addr` empty).
export struct Suggestion {
    name: string,
    addr: string,
    kind: int,
    count: int,
}

// The formatting toolbar's actions on the composer body.
export enum FormatAction { bold, italic, bullets, numbers, quote }

// A formatting edit made by the controller: whether the body changed, and
// the selection (UTF-8 byte offsets) to show in it.
export struct BodyEdit {
    done: bool,
    anchor: int,
    cursor: int,
}

// One band of a rendered HTML body: 256 logical px tall (the last one may
// be shorter), rasterized at physical pixels so it blits 1:1.
export struct Tile {
    img: image,
    h: length,
}

// A selection highlight on the HTML page, in page coordinates.
export struct SelRect {
    x: length,
    y: length,
    w: length,
    h: length,
}

// A link on the HTML page for screen readers: its first hit area (page
// coordinates), text and target.
export struct LinkItem {
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    href: string,
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.card-stroke;
    clip: true;
}

// A dialog's card: outlined, no shadow (docs/WINUI3.md "ContentDialog",
// "Elevation borders").
component DialogCard inherits Card {
    border-color: Theme.surface-stroke;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.stroke;
}

// The folders a message or the selection can move to (in a PopupWindow),
// on a flyout surface (docs/WINUI3.md "CommandBar / AppBarButton", Move
// flyout): a filter box, the folders used last, then the account's folders
// indented by depth. Rust filters the list (`filter-edited`).
component MoveList inherits Flyout {
    in property <[FolderOption]> targets;
    in-out property <string> filter;
    callback picked(int);
    callback filter-edited(string);
    public function focus-filter() {
        filter-field.focus();
    }
    HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        padding-top: 6px;
        padding-bottom: Theme.s1;
        filter-field := TextField {
            placeholder-text: @tr("Filter folders");
            text <=> root.filter;
            edited(t) => { root.filter-edited(t); }
            // Enter moves to the first entry.
            accepted => {
                if root.targets.length > 0 {
                    root.picked(root.targets[0].id);
                }
            }
        }
    }
    if root.targets.length == 0: Text {
        x: Theme.s4;
        height: 36px;
        text: @tr("No folders match");
        font-size: Theme.body;
        color: Theme.text-2;
        vertical-alignment: center;
    }
    Flickable {
        height: min(folder-col.preferred-height, 360px);
        content-height: folder-col.preferred-height;
        folder-col := VerticalLayout {
            for f[i] in root.targets: VerticalLayout {
                if f.recent && i == 0: Text {
                    x: Theme.s4;
                    height: 28px;
                    text: @tr("Recent");
                    font-size: Theme.caption;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
                // The account's folders after the recent ones.
                if !f.recent && i > 0 && root.targets[i - 1].recent: Rectangle {
                    height: 9px;
                    Rectangle { y: 4px; height: 1px; background: Theme.stroke; }
                }
                FlyoutItem {
                    icon: Icons.folder;
                    label: f.label;
                    indent: f.recent ? 0 : f.level * Theme.nav-indent;
                    clicked => { root.picked(f.id); }
                }
            }
        }
    }
}

// The Undo offer (docs/WINUI3.md "InfoBar", Undo at the bottom of the
// list, or of the reader while one pane shows): a card over the content,
// never moving it, held open while pointed at or focused.
component UndoOffer inherits Rectangle {
    in property <string> text;
    callback hold(bool);
    callback undo();
    height: max(48px, undo-row.preferred-height);
    background: Theme.flyout;
    border-radius: Theme.radius-lg;
    border-width: Theme.contrast ? 2px : 1px;
    border-color: Theme.card-stroke;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.contrast ? transparent : #00000024;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-live-region: polite;
    property <bool> held: undo-ta.has-hover || undo-btn.has-focus;
    changed held => { root.hold(self.held); }
    // The row inside the touch area, so the pointer over Undo still
    // counts as over the offer.
    undo-ta := TouchArea {
        undo-row := HorizontalLayout {
            padding-left: Theme.s4;
            padding-right: Theme.s2;
            padding-top: Theme.s2;
            padding-bottom: Theme.s2;
            spacing: Theme.s3;
            Text {
                text: root.text;
                font-size: Theme.body;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            undo-btn := Button {
                label: @tr("Undo");
                tooltip: @tr("Undo (Ctrl+Z)");
                clicked => { root.undo(); }
            }
        }
    }
}

// Files dragged over the window: where they go, over the whole column
// (docs/WINUI3.md "Drag and drop").
component DropOverlay inherits Rectangle {
    in property <bool> composing;
    background: Theme.contrast ? Theme.layer : Theme.layer.with-alpha(0.92);
    Rectangle {
        x: Theme.s3;
        y: Theme.s3;
        width: parent.width - 2 * Theme.s3;
        height: parent.height - 2 * Theme.s3;
        border-radius: Theme.radius-lg;
        border-width: 2px;
        border-color: Theme.contrast ? Theme.hc-highlight : Theme.accent;
        VerticalLayout {
            alignment: center;
            spacing: Theme.s2;
            Icon {
                text: Icons.attach;
                font-size: 32px;
                color: Theme.contrast ? Theme.text : Theme.accent;
            }
            Text {
                text: root.composing ? @tr("Drop to attach") : @tr("Drop to attach to a new message");
                font-size: Theme.subtitle;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
                accessible-live-region: polite;
            }
        }
    }
}

component Heading inherits Text {
    font-size: Theme.subtitle;
    font-weight: 600;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

// An address problem, under its field (lined up with the field: `indent`
// is the label column and its gap).
component FieldError inherits HorizontalLayout {
    in property <string> text;
    in property <length> indent;
    // Announced as it appears (To's error after Send: assertive).
    in property <AccessibleLiveness> live: AccessibleLiveness.off;
    padding-left: root.indent;
    Text {
        text: root.text;
        font-size: Theme.caption;
        color: Theme.danger;
        wrap: word-wrap;
        accessible-live-region: root.live;
    }
}

// Recipient suggestions, over the composer just under the address field
// being typed in, as wide as it (one list for To, Cc and Bcc keeps the
// binary small): the ComboBox drop-down's surface and items
// (docs/WINUI3.md "ComboBox", "AutoSuggestBox"), drawn in the window
// rather than a popup, so the field keeps the keyboard and nothing below
// moves. The composer's keys move `current` and take a row (`suggest-key`).
component SuggestList inherits Flyout {
    in property <[Suggestion]> items;
    in property <int> current;
    callback picked(int);
    accessible-role: list;
    accessible-label: @tr("Suggested recipients");
    for s[i] in root.items: Rectangle {
        height: max(32px, name.preferred-height + 12px) + 4px;
        accessible-role: list-item;
        accessible-label: s.kind == 2 ? @tr("{0}, group of {1}", s.name, s.count) : s.name != "" ? @tr("suggestion" => "{0}, {1}", s.name, s.addr) : s.addr;
        accessible-item-selected: i == root.current;
        accessible-action-default => { root.picked(i); }
        // Item margin 5,2, radius 3; the current one selected, with the
        // 3x16 pill.
        Rectangle {
            x: 5px;
            y: 2px;
            width: parent.width - 10px;
            height: parent.height - 4px;
            border-radius: 3px;
            background: ta.pressed ? Theme.pressed : i == root.current || ta.has-hover ? Theme.selected : transparent;
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
            Rectangle {
                x: 0;
                width: 3px;
                height: 16px;
                border-radius: 1.5px;
                background: Theme.on-fill(true, Theme.accent);
                visible: i == root.current;
            }
            // Padding 11,5,11,7.
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                padding-top: 5px;
                padding-bottom: 7px;
                spacing: s.name != "" ? Theme.s2 : 0;
                if s.kind != 0: Icon {
                    text: s.kind == 2 ? Icons.people : Icons.person;
                    color: Theme.on-fill(i == root.current || ta.has-hover || ta.pressed, Theme.text-2);
                    vertical-stretch: 0;
                }
                name := Text {
                    text: s.name != "" ? s.name : s.addr;
                    font-size: Theme.body;
                    color: Theme.on-fill(i == root.current || ta.has-hover || ta.pressed, Theme.text);
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: s.name != "" ? 0 : 1;
                }
                Text {
                    text: s.kind == 2 ? @tr("{n} person" | "{n} people" % s.count) : s.name != "" ? s.addr : "";
                    font-size: Theme.caption;
                    color: Theme.on-fill(i == root.current || ta.has-hover || ta.pressed, Theme.text-2);
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

component BodyText inherits Text {
    font-size: Theme.body;
    color: Theme.text;
    wrap: word-wrap;
}


// ---------------------------------------------------------------- settings

// The status line's InfoBar: its action is a button under the message;
// Esc on its buttons closes it. Screen readers announce it as it appears:
// at once for a problem (there is no alert role), politely otherwise.
component StatusBar inherits FocusScope {
    in property <string> text;
    in property <Severity> severity;
    in property <string> action;
    // A line that stays until what it says ends (the first download of a
    // new account) has no close button.
    in property <bool> closable: true;
    callback act();
    callback closed();
    callback escaped();
    focus-on-click: false;
    focus-on-tab-navigation: false;
    key-pressed(e) => {
        if e.text == Key.Escape {
            if root.closable {
                root.closed();
            }
            root.escaped();
            return accept;
        }
        reject
    }
    VerticalLayout {
        InfoBar {
            severity: root.severity;
            message: root.text;
            closable: root.closable;
            button1: root.action;
            button-clicked => { root.act(); }
            closed => { root.closed(); }
            accessible-live-region: root.severity == Severity.info ? AccessibleLiveness.polite : AccessibleLiveness.assertive;
        }
    }
}

// Settings, a page in the content area as in Windows 11's own apps
// the title, SelectorBar tabs and a column of
// SettingsCards on the layer, at most 1000 px wide; the account form is a
// sub-page ("Accounts > Add an account").
component SettingsPage inherits Rectangle {
    in property <[AccountRow]> accounts;
    in property <bool> busy;
    in property <string> error;
    // The account check: a success note, and the state of each step (0
    // waiting, 1 running, 2 passed, 3 failed, 4 skipped); none: not run.
    in property <string> ok;
    in-out property <[int]> test-steps;
    // The servers' certificates (manual servers): the line under each,
    // whether a saved one can be forgotten, which server a failed check can
    // review (0 none, 1 incoming, 2 sending), and whether the wait is a
    // certificate read.
    in property <string> cert-imap;
    in property <string> cert-smtp;
    in property <bool> pinned-imap;
    in property <bool> pinned-smtp;
    in property <int> review;
    in property <bool> cert-wait;
    // "Find settings": a lookup is running, the note under the button, and
    // the answer: the server fields as they were when the button was
    // pressed and as they should be (applied only if they are still what
    // they were), signalled by `found-seq`.
    in property <bool> finding;
    in property <string> find-note;
    in property <ServerFields> found-from;
    // The address the lookup was for: its answer is not for another one.
    in property <string> found-email;
    in property <ServerFields> found-to;
    in property <int> found-seq;
    callback find-settings(string, ServerFields);
    callback review-certificate(AccountForm, /* 1 incoming, 2 sending */ int);
    callback forget-certificate(/* 1 incoming, 2 sending */ int);
    // Edit account > Folders: the roles Sent, Drafts, Trash, Archive and
    // Junk with their choices; a pick reports the role and the option.
    in property <[RoleChoice]> roles;
    callback choose-role(int, int);
    // A server, port or security was edited: a saved certificate of the old
    // one goes.
    callback form-changed(AccountForm);
    // The form opens for a new account.
    callback form-opened();
    in property <[string]> remote-senders;
    // 0 Accounts, 1 Signatures, 2 Rules, 3 General, 4 Privacy, 5 About.
    in-out property <int> section;
    // The account being edited (0: the form adds one), and its settings
    // without the password, which the form never shows.
    in-out property <int> edit-id;
    in property <AccountForm> edit;
    // General: indexes into the choices below, and the taskbar flash.
    in property <[int]> g-choices;
    in property <bool> g-reopen-tabs;
    in property <bool> g-flash;
    // Notifications (which = 8 notify, 9 sender and subject, 10 close to
    // the tray, 11 start with Windows).
    in property <bool> g-notify;
    in property <bool> g-notify-detail;
    // Event reminders as notifications (reported as general-changed 13).
    in property <bool> g-cal-remind;
    in property <bool> g-close-to-tray;
    in property <bool> g-autostart;
    // The display language: 0 System, 1 English, 2 Português (Portugal)
    // (reported as general-changed 6).
    in property <int> g-language;
    // Privacy: the diagnostics log (reported as general-changed 5).
    in property <bool> g-diag;
    callback general-changed(/* which */ int, /* value */ int);
    in property <string> about-version;
    in property <string> about-data;
    callback open-repository();
    callback open-data-folder();
    callback copy-text(string);
    // About: Show tips again, Keyboard shortcuts, and the pages opened
    // through the link prompt (2 What's new, 3 Get help, 4 Report a
    // problem, 1 Privacy statement; see AppWindow's `welcome-link`).
    callback show-tips-again();
    callback show-shortcuts();
    callback about-link(int);
    // About > Updates (src/app/updates.rs): the state (0 not checked, 1
    // checking, 2 up to date, 3 available, 4 downloading, 5 failed, 6
    // starting the installer), the version found, the error (0 offline,
    // 1 network, 2 release incomplete, 3 too large, 4 verify, 5 file),
    // whether a found release can be tried again, the automatic switch
    // (reported as general-changed 12) and the presses (0 Check, 1
    // Download and install, 2 Later, 3 Release notes).
    in property <int> up-state;
    in property <string> up-version;
    in property <int> up-error;
    in property <bool> up-retry;
    in property <bool> up-auto;
    // The download: its fraction (0 to 1, -1 when the size is not known) and
    // the bytes received and the size, already formatted ("" when unknown).
    in property <float> up-progress: -1;
    in property <string> up-done;
    in property <string> up-total;
    callback update-action(int);
    // The status line (the list's is hidden under the page).
    in property <string> status;
    in property <Severity> status-severity;
    in property <string> status-action;
    in property <bool> status-closable: true;
    callback status-action-clicked();
    callback dismiss-status();
    // Add account: the onboarding flow opens in the content area.
    callback add-account();
    // The password was rejected (the Password box's error state and Set
    // username); editing the password clears it.
    in-out property <bool> rejected;
    // Drops the running check's answer (Cancel, Back or Esc while it runs).
    callback cancel-check();
    // The account form (Add account or Edit) shows instead of the tabs.
    property <bool> form-open: false;
    // The form lives only while the page is open, so a typed password is
    // gone as soon as it closes.
    property <int> provider: -1;     // 0 Purelymail, 1 Postale.io, 2 Other; -1 none chosen yet
    // The provider was picked from the address, not by a click.
    property <bool> provider-guessed;
    property <string> name;
    property <string> email;
    property <string> password;
    property <string> imap-host;
    property <string> imap-port: "993";
    property <string> smtp-host;
    property <string> smtp-port: "465";
    property <int> smtp-security: 0; // 0 SSL/TLS, 1 STARTTLS
    property <int> imap-security: 0; // 0 SSL/TLS, 1 STARTTLS
    property <bool> save-sent: true;
    property <string> signature;
    property <string> imap-user;
    property <string> smtp-user;
    property <bool> same-login: true;   // SMTP signs in as IMAP does
    property <bool> smtp-no-auth;       // SMTP takes mail without a sign-in
    // "Set username" showed the sign-in name under the password (and the
    // field takes the focus as it appears).
    property <bool> user-open;
    property <bool> user-focus;
    // Other server: the server fields stay folded in the Server settings
    // expander until asked for, a lookup filled them, or a check or the
    // form's validation failed on one of them.
    property <bool> advanced-open: false;
    // The add form's inline errors, set by a press of Add account or Test
    // connection (docs/WINUI3.md "TextBox", error state).
    property <string> email-err;
    property <string> password-err;
    property <string> provider-err;
    property <string> imap-err;
    property <string> smtp-err;
    // The check has run for 3 s: the wait says what to check.
    property <bool> slow;
    // Each change focuses the error bar's first button.
    property <int> err-focus;
    // The edit form can be saved (Enter in a field does it).
    property <bool> can-save: !root.busy && root.email != "" && (root.password != "" || root.edit-id != 0);
    changed error => {
        if root.error != "" && root.provider == 2 { root.advanced-open = true; }
        if root.error == "" { root.err-pad = false; }
    }
    // An error below the fold: the form grows under its bar by what the
    // view lacks, so the bar can sit 8 px under the header (WINUI3
    // "SettingsCard"), and `err-height` is the bar's measured height.
    property <bool> err-pad;
    property <length> err-height;
    changed busy => { if !root.busy { root.slow = false; } }
    changed password => {
        root.rejected = false;
        root.password-err = "";
    }
    changed imap-host => { root.imap-err = ""; }
    changed smtp-host => { root.smtp-err = ""; }
    Timer {
        interval: 3s;
        running: root.busy && !root.slow;
        triggered => { root.slow = true; }
    }
    callback close;
    callback save-account(AccountForm);
    callback test-account(AccountForm);
    callback edit-account(int);
    callback remove-account(int);
    callback account-enabled(int, bool);
    callback account-notify(int, bool);
    callback move-account(int, /* up */ bool);
    callback redownload(int);
    callback remove-all-data();
    callback forget-remote(string);
    callback forget-all-remote();
    // Review certificate on an account's card (its saved one changed).
    callback review-changed(int);
    callback open-logs-folder();
    // The account page: where the edited account is in `accounts` (-1:
    // gone, so the page closes), whether its servers are a preset's (no
    // Find settings), and a request to scroll to its Folders (snapshots).
    in property <int> edit-index: -1;
    in property <bool> edit-preset;
    in-out property <bool> scroll-folders;
    changed edit-index => {
        if root.edit-index < 0 && root.form-open && root.edit-id != 0 {
            root.back();
        }
    }
    // The language changed in this session: the note under its card.
    property <bool> language-note;
    // The edited account's row (its name, switch and order).
    property <AccountRow> edit-row: root.edit-index >= 0 && root.edit-index < root.accounts.length ? root.accounts[root.edit-index] : { id: 0 };
    // Bumped when the focus comes back to the page (a prompt over it
    // closed, F6): the button that opened the prompt or the form
    // (`opener`) takes it, else the tabs (or the form's Back).
    in property <int> refocus;
    property <string> opener;
    // The button to focus (`opener` when the focus came back) and a count
    // that changes each time: its `focus-seq`.
    property <string> target;
    property <int> reopen;
    changed refocus => {
        if root.form-open {
            back-btn.focus();
        } else {
            tabs.focus();
        }
        root.target = root.opener;
        root.reopen += 1;
    }

    // Fill the form from `edit` (or empty it for a new account).
    function load-form() {
        root.password = "";
        root.test-steps = [];
        root.find-stale = false;
        root.user-open = false;
        root.email-err = "";
        root.password-err = "";
        root.provider-err = "";
        root.imap-err = "";
        root.smtp-err = "";
        root.rejected = false;
        root.provider-guessed = false;
        if root.edit-id == 0 {
            root.provider = -1;
            root.name = "";
            root.email = "";
            root.imap-host = "";
            root.imap-port = "993";
            root.imap-security = 0;
            root.smtp-host = "";
            root.smtp-port = "465";
            root.smtp-security = 0;
            root.save-sent = true;
            root.signature = "";
            root.imap-user = "";
            root.smtp-user = "";
            root.same-login = true;
            root.smtp-no-auth = false;
        } else {
            root.provider = 2;
            root.name = root.edit.name;
            root.email = root.edit.email;
            root.imap-host = root.edit.imap-host;
            root.imap-port = root.edit.imap-port;
            root.imap-security = root.edit.imap-starttls ? 1 : 0;
            root.smtp-host = root.edit.smtp-host;
            root.smtp-port = root.edit.smtp-port;
            root.smtp-security = root.edit.smtp-starttls ? 1 : 0;
            root.save-sent = root.edit.save-sent;
            root.signature = root.edit.signature;
            root.imap-user = root.edit.imap-user;
            root.smtp-user = root.edit.smtp-user;
            root.same-login = !root.edit.smtp-own-login;
            root.smtp-no-auth = root.edit.smtp-no-auth;
        }
    }
    // The server fields as typed.
    function servers-now() -> ServerFields {
        return {
            imap-host: root.imap-host,
            imap-port: root.imap-port,
            imap-starttls: root.imap-security == 1,
            imap-user: root.imap-user,
            smtp-host: root.smtp-host,
            smtp-port: root.smtp-port,
            smtp-starttls: root.smtp-security == 1,
            smtp-user: root.smtp-user,
            smtp-own-login: !root.same-login,
        };
    }
    // "Find settings" answered: fill the fields it found, unless the servers
    // or the address were edited while it looked.
    property <bool> find-stale: false;
    changed found-seq => {
        if root.servers-now() == root.found-from && root.email == root.found-email {
            root.find-stale = false;
            root.imap-host = root.found-to.imap-host;
            root.imap-port = root.found-to.imap-port;
            root.imap-security = root.found-to.imap-starttls ? 1 : 0;
            root.imap-user = root.found-to.imap-user;
            root.smtp-host = root.found-to.smtp-host;
            root.smtp-port = root.found-to.smtp-port;
            root.smtp-security = root.found-to.smtp-starttls ? 1 : 0;
            root.smtp-user = root.found-to.smtp-user;
            root.same-login = !root.found-to.smtp-own-login;
            root.advanced-open = true;
        } else {
            root.find-stale = true;
        }
    }
    // The form as typed.
    function form() -> AccountForm {
        return {
            id: root.edit-id,
            provider: root.provider,
            name: root.name,
            email: root.email,
            password: root.password,
            imap-host: root.imap-host,
            imap-port: root.imap-port,
            imap-starttls: root.imap-security == 1,
            smtp-host: root.smtp-host,
            smtp-port: root.smtp-port,
            smtp-starttls: root.smtp-security == 1,
            save-sent: root.save-sent,
            signature: root.signature,
            imap-user: root.imap-user,
            smtp-user: root.smtp-user,
            smtp-own-login: !root.same-login,
            smtp-no-auth: root.smtp-no-auth,
        };
    }
    // Edit (or "Update password") opens the form on Accounts: the account
    // page, its Server settings folded unless a certificate is saved or
    // the SMTP server needs no sign-in.
    function open-edit() {
        load-form();
        if root.edit-id != 0 {
            root.section = 0;
            root.form-open = true;
            root.advanced-open = root.pinned-imap || root.pinned-smtp || root.smtp-no-auth;
        }
    }
    changed cert-wait => { if root.cert-wait { root.advanced-open = true; } }
    changed review => { if root.review != 0 { root.advanced-open = true; } }
    // Back to the accounts: the button that opened the form takes the
    // focus again.
    function back() {
        if root.busy {
            root.cancel-check();
        }
        root.test-steps = [];
        root.form-open = false;
        root.edit-id = 0;
        tabs.focus();
        root.target = root.opener;
        root.reopen += 1;
    }
    // Save and Test connection (the account page; adding an account is
    // the onboarding flow's, ui/onboarding.slint).
    function submit(test: bool) {
        if root.busy || root.edit-id == 0 {
            return;
        }
        if test {
            root.test-account(root.form());
        } else if root.can-save {
            root.save-account(root.form());
        }
    }
    init => { open-edit(); }
    changed edit-id => { open-edit(); }
    // Each section (and the form) starts at its top.
    changed section => { settings-scroll.content-y = 0; }
    changed form-open => { settings-scroll.content-y = 0; }
    // The servers as typed, one value for all six fields.
    property <string> servers: root.imap-host + "|" + root.imap-port + "|" + root.imap-security + "|" + root.smtp-host + "|" + root.smtp-port + "|" + root.smtp-security;
    changed servers => { root.form-changed(root.form()); }

    background: Theme.layer;

    // The account page's "…" menu, shown under its button.
    acct-menu := ContextMenuArea {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Move up");
                enabled: !root.edit-row.first;
                activated => { root.move-account(root.edit-id, true); }
            }
            MenuItem {
                title: @tr("Move down");
                enabled: !root.edit-row.last;
                activated => { root.move-account(root.edit-id, false); }
            }
        }
    }

    // Esc leaves the account form, then closes Settings (text fields keep
    // the keys they use). Not a Tab stop itself.
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if e.text == Key.Escape {
                if root.form-open {
                    root.back();
                } else if Sigs.editing {
                    // A signature's page: back to the list, unsaved.
                    Sigs.cancel();
                } else {
                    root.close();
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding-top: Theme.s6;
            // The title, or the form's breadcrumb with Back before it.
            HorizontalLayout {
                vertical-stretch: 0;
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                spacing: Theme.s2;
                VerticalLayout {
                    alignment: center;
                    // Back to the accounts from the form, else out of
                    // Settings to the mail (Esc does the same).
                    back-btn := IconButton {
                        width: 40px;
                        icon: Icons.back;
                        tooltip: root.accounts.length == 0 ? @tr("Back") : root.form-open ? @tr("Back to accounts") : @tr("Back to mail (Esc)");
                        clicked => {
                            if root.form-open {
                                root.back();
                            } else {
                                root.close();
                            }
                        }
                    }
                }
                // With no account yet, the form is the page: its title
                // alone, no breadcrumb.
                property <bool> crumb: root.form-open && root.accounts.length > 0;
                Text {
                    text: parent.crumb ? @tr("Accounts") : root.form-open ? @tr("Edit {0}", root.email) : @tr("Settings");
                    font-family: Theme.display-font;
                    font-size: Theme.title-large;
                    font-weight: 600;
                    color: parent.crumb ? Theme.text-2 : Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: parent.crumb ? 0 : 1;
                }
                Icon {
                    visible: parent.crumb;
                    width: parent.crumb ? 16px : 0;
                    text: Icons.chevron-right;
                    font-size: 16px;
                    color: Theme.text-2;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                Text {
                    visible: parent.crumb;
                    max-width: parent.crumb ? 100000px : 0;
                    text: root.edit-row.name != "" ? root.edit-row.name : root.email;
                    font-family: Theme.display-font;
                    font-size: Theme.title-large;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                    // The account page's "…" follows the name.
                    horizontal-stretch: root.edit-id != 0 && root.accounts.length > 1 ? 0 : 1;
                }
                // The account page's "…": Move up / Move down (with two
                // accounts or more; `menu:account` prints it).
                if root.form-open && root.edit-id != 0 && root.accounts.length > 1: VerticalLayout {
                    alignment: center;
                    acct-more := IconButton {
                        width: 40px;
                        icon: Icons.more;
                        tooltip: @tr("More options for this account");
                        enabled: !root.busy;
                        clicked => { acct-menu.show({ x: self.absolute-position.x - root.absolute-position.x, y: self.absolute-position.y - root.absolute-position.y + self.height }); }
                    }
                }
                if root.form-open && root.edit-id != 0 && root.accounts.length > 1: Rectangle { horizontal-stretch: 1; }
            }
            // One Tab stop whose arrows pick the section; the first item's
            // text lines up with the title. No room while the form shows.
            HorizontalLayout {
                vertical-stretch: 0;
                padding-left: Theme.s1;
                padding-top: root.form-open ? 0 : Theme.s2;
                height: root.form-open ? 0 : tabs.preferred-height + Theme.s2;
                tabs := SelectorBar {
                    visible: !root.form-open;
                    init => {
                        if !root.form-open {
                            self.focus();
                        }
                    }
                    items: [@tr("Accounts"), @tr("Signatures"), @tr("Rules"), @tr("General"), @tr("Privacy"), @tr("About")];
                    selected <=> root.section;
                }
            }

            // The status line, at the top of the page's column.
            if root.status != "": HorizontalLayout {
                vertical-stretch: 0;
                padding-left: Theme.s4;
                padding-right: max(Theme.s4, root.width - 1000px - Theme.s4);
                padding-top: Theme.s4;
                StatusBar {
                    text: root.status;
                    severity: root.status-severity;
                    action: root.status-action;
                    closable: root.status-closable;
                    act => { root.status-action-clicked(); }
                    closed => { root.dismiss-status(); }
                    escaped => {
                        if root.form-open {
                            back-btn.focus();
                        } else {
                            tabs.focus();
                        }
                    }
                }
            }

            // One scroll view for every section (and the account form),
            // its column at most 1000 px wide.
            settings-scroll := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-left: Theme.s4;
                    padding-right: max(Theme.s4, settings-scroll.visible-width - 1000px - Theme.s4);
                    padding-top: Theme.s4;
                    padding-bottom: root.error != "" && root.err-pad
                        ? max(Theme.s6, settings-scroll.visible-height - root.err-height - Theme.s2)
                        : Theme.s6;
                    // ---- Accounts: the list
                    if !root.form-open && root.section == 0: VerticalLayout {
                        alignment: start;
                        spacing: Theme.s1;
                        // One card per account (Windows Settings' "Your
                        // accounts"): the whole card opens its page (click,
                        // Enter or Space); its status says what is wrong,
                        // with the fix as a link.
                        for a in root.accounts: acct-card := SettingsSurface {
                            property <int> seq: root.target == "edit" + a.id ? root.reopen : 0;
                            changed seq => { if self.seq > 0 { card-keys.focus(); } }
                            height: max(68px, card-row.preferred-height);
                            accessible-role: button;
                            accessible-label: (a.name != "" ? a.name + ", " : "") + a.email;
                            accessible-description: a.status;
                            accessible-action-default => {
                                root.opener = "edit" + a.id;
                                root.edit-account(a.id);
                            }
                            background: card-ta.has-hover ? Theme.card-fill-2 : Theme.card-fill;
                            border-color: Theme.contrast && card-ta.has-hover ? Theme.hc-highlight : Theme.card-edge;
                            card-keys := PressKeys {
                                enabled: !root.busy;
                                focus-on-tab-navigation: !root.busy;
                                pressed => {
                                    root.opener = "edit" + a.id;
                                    root.edit-account(a.id);
                                }
                            }
                            card-ta := TouchArea {
                                enabled: !root.busy;
                                mouse-cursor: pointer;
                                clicked => {
                                    Focus.keyboard = false;
                                    root.opener = "edit" + a.id;
                                    root.edit-account(a.id);
                                }
                            }
                            card-row := HorizontalLayout {
                                padding: Theme.s4;
                                Rectangle {
                                    width: 42px;
                                    Icon {
                                        x: 2px;
                                        width: 20px;
                                        text: a.warn ? Icons.error : a.caution ? Icons.warning : Icons.person;
                                        font-size: 20px;
                                        color: a.warn ? Theme.danger : a.caution ? Theme.warning : a.enabled ? Theme.text : Theme.text-disabled;
                                    }
                                    // The account's colour (All inboxes rows, navigation).
                                    Rectangle {
                                        visible: root.accounts.length > 1;
                                        x: 16px;
                                        y: parent.height / 2 + 2px;
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: a.dot;
                                        border-width: 1px;
                                        border-color: Theme.layer;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: a.name != "" ? a.name : a.email; font-size: Theme.body; color: a.enabled ? Theme.text : Theme.text-2; overflow: elide; }
                                    Text {
                                        text: a.email;
                                        visible: a.name != "";
                                        height: a.name == "" ? 0 : self.preferred-height;
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: a.status;
                                        visible: a.status != "";
                                        height: a.status == "" ? 0 : self.preferred-height;
                                        font-size: Theme.caption;
                                        color: a.warn ? Theme.danger : Theme.text-2;
                                        wrap: word-wrap;
                                    }
                                    // Its download, while a first sync or a large
                                    // catch-up runs (docs/WINUI3.md "Progress").
                                    if a.total > 0: VerticalLayout {
                                        padding-top: Theme.s2;
                                        padding-bottom: Theme.s1;
                                        ProgressBar {
                                            value: a.done / max(1, a.total);
                                            accessible-label: @tr("Downloading the mail of {0}", a.email);
                                        }
                                    }
                                    if a.warn: HorizontalLayout {
                                        alignment: start;
                                        HyperlinkButton {
                                            text: a.review ? @tr("Review certificate") : @tr("Update password");
                                            label: a.review ? @tr("Review the certificate of {0}", a.email) : @tr("Update password for {0}", a.email);
                                            clicked => {
                                                root.opener = "edit" + a.id;
                                                if a.review {
                                                    root.review-changed(a.id);
                                                } else {
                                                    root.edit-account(a.id);
                                                }
                                            }
                                        }
                                    }
                                }
                                // "Off" while switched off, then the chevron
                                // (it opens a page).
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    padding-left: Theme.s4;
                                    spacing: Theme.s3;
                                    if !a.enabled: Text {
                                        text: @tr("account switched off" => "Off");
                                        font-size: Theme.body;
                                        color: Theme.text-2;
                                        vertical-alignment: center;
                                    }
                                    Icon {
                                        text: Icons.chevron-right;
                                        font-size: 12px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }
                            }
                            FocusRing { shown: card-keys.has-focus; }
                        }
                        // As Windows Settings' "Add an account" card; the
                        // accent button only while there is no account.
                        SettingsCard {
                            icon: Icons.add;
                            header: root.accounts.length == 0 ? @tr("No accounts yet") : @tr("Add another account");
                            description: @tr("Purelymail, Postale.io or any IMAP and SMTP server.");
                            action: @tr("Add account");
                            action-accent: root.accounts.length == 0;
                            action-enabled: !root.busy;
                            action-focus: root.target == "add" ? root.reopen : 0;
                            action-clicked => {
                                root.opener = "add";
                                root.add-account();
                            }
                        }
                    }

                    // ---- Accounts: the form (Add account, or the account
                    // page), at most 560 px wide: headers above the fields,
                    // 8 below a header and 12 between fields. The add form
                    // asks, in order, Email, Password, Provider and an
                    // optional name; the account page groups Account,
                    // Signature, Folders, Server settings, then Download
                    // again and Remove (docs/WINUI3.md "SettingsCard").
                    // Its buttons are pinned under the scroll view.
                    if root.form-open: HorizontalLayout {
                        alignment: start;
                        form-col := VerticalLayout {
                            preferred-width: 560px;
                            max-width: 560px;
                            alignment: start;
                            spacing: Theme.s3;
                            // The account page starts with the account and
                            // whether it syncs (it applies at once).
                            if root.edit-id != 0: VerticalLayout {
                                spacing: Theme.s2;
                                GroupHeader { text: @tr("account page group" => "Account"); }
                                SettingsCard {
                                    header: @tr("Sync this account");
                                    description: @tr("When this is off, Komorebi doesn't connect to the account: no new mail comes in and nothing is sent. Its downloaded mail stays readable.");
                                    toggle: true;
                                    toggle-label: @tr("Sync {0}", root.email);
                                    checked: root.edit-row.enabled;
                                    toggled(on) => { root.account-enabled(root.edit-id, on); }
                                }
                                SettingsCard {
                                    header: @tr("Notifications for this account");
                                    description: @tr("New mail in this account can show a Windows notification. Notifications for new mail in Settings > General applies to every account.");
                                    toggle: true;
                                    toggle-label: @tr("Notifications for {0}", root.email);
                                    checked: root.edit-row.notify;
                                    toggled(on) => { root.account-notify(root.edit-id, on); }
                                }
                            }
                            if root.edit-id != 0: VerticalLayout {
                                spacing: Theme.s2;
                                FieldHeader { text: @tr("Name"); }
                                TextField {
                                    text <=> root.name;
                                    placeholder-text: @tr("Shown to recipients");
                                    accessible-label: @tr("Name");
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                FieldHeader { text: @tr("Email"); }
                                // An account's address is its identity: fixed
                                // once added. A new account starts here.
                                TextField {
                                    text <=> root.email;
                                    enabled: false;
                                    placeholder-text: @tr("you@yourdomain.com");
                                    accessible-label: @tr("Email");
                                    description: @tr("The address can't be changed. To use another one, add another account.");
                                    accepted => { root.submit(false); }
                                }
                                if root.edit-id != 0: FieldNote {
                                    text: @tr("The address can't be changed. To use another one, add another account.");
                                    accessible-role: none;
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                FieldHeader { text: @tr("Password"); }
                                // Editing (often "Update password") starts here.
                                pw-field := TextField {
                                    text <=> root.password;
                                    input-type: InputType.password;
                                    placeholder-text: @tr("Leave empty to keep the current one");
                                    accessible-label: @tr("Password");
                                    error: root.password-err != "" || root.rejected;
                                    description: root.password-err;
                                    accepted => { root.submit(false); }
                                    init => { if root.edit-id != 0 { self.focus(); } }
                                }
                                if root.password-err != "": FieldNote { error: true; text: root.password-err; }
                            }
                            // The account's signatures: one for new messages,
                            // one for replies and forwards (each None or a
                            // signature from Settings > Signatures), each
                            // header above its box; a pick is saved at once.
                            if root.edit-id != 0: VerticalLayout {
                                padding-top: Theme.s3;
                                spacing: Theme.s2;
                                GroupHeader { text: @tr("Signature"); }
                                VerticalLayout {
                                    spacing: Theme.s1;
                                    FieldHeader { text: @tr("New messages"); }
                                    Rectangle {
                                        height: 32px;
                                        sig-new := ComboBox {
                                            width: 100%;
                                            height: 100%;
                                            model: Sigs.choices;
                                            current-index: Sigs.acct-new;
                                            accessible-label: @tr("Signature for new messages");
                                            selected => { Sigs.set-defaults(root.edit-id, self.current-index, sig-reply.current-index); }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: Theme.s1;
                                    FieldHeader { text: @tr("Replies and forwards"); }
                                    Rectangle {
                                        height: 32px;
                                        sig-reply := ComboBox {
                                            width: 100%;
                                            height: 100%;
                                            model: Sigs.choices;
                                            current-index: Sigs.acct-reply;
                                            accessible-label: @tr("Signature for replies and forwards");
                                            selected => { Sigs.set-defaults(root.edit-id, sig-new.current-index, self.current-index); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    HyperlinkButton {
                                        text: @tr("Manage signatures");
                                        clicked => {
                                            root.back();
                                            root.section = 1;
                                        }
                                    }
                                }
                            }
                            // The folders for Sent, Drafts, Trash, Archive and
                            // Junk, for servers that don't mark them: each
                            // role's header above its ComboBox (no label is
                            // cut, in any language), after the Sent copy.
                            if root.edit-id != 0: folders-group := VerticalLayout {
                                padding-top: Theme.s3;
                                spacing: Theme.s3;
                                // Scrolled to on request (the snapshots').
                                Timer {
                                    interval: 120ms;
                                    running: root.scroll-folders;
                                    triggered => {
                                        root.scroll-folders = false;
                                        settings-scroll.content-y -= folders-group.absolute-position.y - settings-scroll.absolute-position.y - Theme.s2;
                                    }
                                }
                                VerticalLayout {
                                    spacing: Theme.s1;
                                    GroupHeader { text: @tr("Folders"); }
                                    Text {
                                        text: @tr("Where sent mail and drafts are saved, and where Delete, Archive and Report junk move mail. Automatic follows what the server marks. Nothing is created on the server.");
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        wrap: word-wrap;
                                    }
                                }
                                CheckBox {
                                    text: @tr("Save a copy of sent mail in the Sent folder");
                                    checked <=> root.save-sent;
                                }
                                if root.roles.length > 0: VerticalLayout {
                                    spacing: Theme.s3;
                                    for label[i] in [@tr("Sent"), @tr("Drafts"), @tr("Trash"), @tr("folder" => "Archive"), @tr("Junk")]: VerticalLayout {
                                        spacing: Theme.s2;
                                        FieldHeader { text: label; }
                                        Rectangle {
                                            height: role-box.min-height;
                                            role-box := ComboBox {
                                                width: 100%;
                                                height: 100%;
                                                model: root.roles[i].options;
                                                current-index: root.roles[i].current;
                                                accessible-label: label;
                                                selected(v) => { root.choose-role(i, self.current-index); }
                                            }
                                        }
                                    }
                                }
                            }
                            // Other server (and every account page): Find
                            // settings and the servers in the Server settings
                            // expander, folded until asked for, a lookup
                            // filled them, a check failed on one of them or
                            // a certificate is saved.
                            if root.provider == 2: VerticalLayout {
                                padding-top: root.edit-id != 0 ? Theme.s3 : 0;
                                spacing: Theme.s3;
                                VerticalLayout {
                                    spacing: 0;
                                    Expander {
                                        header: @tr("Server settings");
                                        description: @tr("Incoming and sending servers, ports and security");
                                        expanded <=> root.advanced-open;
                                    }
                                    if root.advanced-open: Rectangle {
                                        background: Theme.card-fill-2;
                                        border-width: 1px;
                                        border-color: Theme.card-edge;
                                        border-bottom-left-radius: Theme.radius;
                                        border-bottom-right-radius: Theme.radius;
                                        VerticalLayout {
                                            padding: Theme.s4;
                                            spacing: Theme.s3;
                                            // The account page's lookup, only for a
                                            // server that isn't a preset.
                                            if root.edit-id != 0 && !root.edit-preset: FindSettingsRow {
                                                finding: root.finding;
                                                can-find: !root.finding && !root.busy && Discovery.email-ok(root.email);
                                                note: root.find-stale ? @tr("Not filled in: the form changed while Komorebi looked.") : root.find-note;
                                                find => { root.find-stale = false; root.find-settings(root.email, root.servers-now()); }
                                            }
                                            HorizontalLayout {
                                                spacing: Theme.s2;
                                                VerticalLayout {
                                                    spacing: Theme.s2;
                                                    FieldHeader { text: @tr("IMAP server"); }
                                                    TextField {
                                                        text <=> root.imap-host;
                                                        placeholder-text: "imap.example.com";
                                                        accessible-label: @tr("IMAP server");
                                                        error: root.imap-err != "";
                                                        description: root.imap-err;
                                                    }
                                                    if root.imap-err != "": FieldNote { error: true; text: root.imap-err; }
                                                }
                                                VerticalLayout {
                                                    width: 96px;
                                                    spacing: Theme.s2;
                                                    alignment: start;
                                                    FieldHeader { text: @tr("Port"); }
                                                    TextField { text <=> root.imap-port; input-type: InputType.number; accessible-label: @tr("IMAP port"); }
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: Theme.s2;
                                                FieldHeader { text: @tr("IMAP security"); }
                                                Rectangle {
                                                    height: imap-box.min-height;
                                                    imap-box := ComboBox {
                                                        width: 100%;
                                                        height: 100%;
                                                        model: [@tr("SSL/TLS (port 993)"), @tr("STARTTLS (port 143)")];
                                                        current-index <=> root.imap-security;
                                                        accessible-label: @tr("IMAP security");
                                                        selected(v) => { root.imap-port = ServerPorts.port-for-security(true, 1 - root.imap-security, root.imap-security, root.imap-port); }
                                                    }
                                                }
                                            }
                                            // The sign-in name shows under the
                                            // password once "Set username" opened it.
                                            if !root.user-open: VerticalLayout {
                                                spacing: Theme.s2;
                                                FieldHeader { text: @tr("IMAP username"); }
                                                TextField {
                                                    text <=> root.imap-user;
                                                    placeholder-text: @tr("Same as email address");
                                                    accessible-label: @tr("IMAP username");
                                                }
                                            }
                                            CertLine {
                                                text: root.cert-imap;
                                                pinned: root.pinned-imap;
                                                forget => { root.forget-certificate(1); }
                                            }
                                            HorizontalLayout {
                                                spacing: Theme.s2;
                                                VerticalLayout {
                                                    spacing: Theme.s2;
                                                    FieldHeader { text: @tr("SMTP server"); }
                                                    TextField {
                                                        text <=> root.smtp-host;
                                                        placeholder-text: "smtp.example.com";
                                                        accessible-label: @tr("SMTP server");
                                                        error: root.smtp-err != "";
                                                        description: root.smtp-err;
                                                    }
                                                    if root.smtp-err != "": FieldNote { error: true; text: root.smtp-err; }
                                                }
                                                VerticalLayout {
                                                    width: 96px;
                                                    spacing: Theme.s2;
                                                    alignment: start;
                                                    FieldHeader { text: @tr("Port"); }
                                                    TextField { text <=> root.smtp-port; input-type: InputType.number; accessible-label: @tr("SMTP port"); }
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: Theme.s2;
                                                FieldHeader { text: @tr("SMTP security"); }
                                                Rectangle {
                                                    height: smtp-box.min-height;
                                                    smtp-box := ComboBox {
                                                        width: 100%;
                                                        height: 100%;
                                                        model: [@tr("SSL/TLS (port 465)"), @tr("STARTTLS (port 587)")];
                                                        current-index <=> root.smtp-security;
                                                        accessible-label: @tr("SMTP security");
                                                        selected(v) => { root.smtp-port = ServerPorts.port-for-security(false, 1 - root.smtp-security, root.smtp-security, root.smtp-port); }
                                                    }
                                                }
                                            }
                                            CertLine {
                                                text: root.cert-smtp;
                                                pinned: root.pinned-smtp;
                                                forget => { root.forget-certificate(2); }
                                            }
                                            SmtpNoAuth {
                                                checked <=> root.smtp-no-auth;
                                            }
                                            if !root.smtp-no-auth: CheckBox {
                                                text: @tr("Same sign-in as incoming");
                                                checked <=> root.same-login;
                                            }
                                            if !root.same-login && !root.smtp-no-auth: VerticalLayout {
                                                spacing: Theme.s2;
                                                FieldHeader { text: @tr("SMTP username"); }
                                                TextField {
                                                    text <=> root.smtp-user;
                                                    placeholder-text: @tr("Same as email address");
                                                    accessible-label: @tr("SMTP username");
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            // A failure: the sentence, the steps inside the
                            // bar and its next steps as its buttons. It
                            // scrolls into view and takes the focus (the
                            // Password box when the password was rejected).
                            if root.error != "": err-box := VerticalLayout {
                                // Set username (a rejected sign-in, until the
                                // field shows) and Review certificate.
                                property <bool> can-user: false;
                                property <bool> can-review: root.review != 0 && !root.busy;
                                property <int> a1: self.can-user ? 1 : self.can-review ? 2 : 0;
                                property <int> a2: self.can-user && self.can-review ? 2 : 0;
                                // Three passes, 60 ms apart: reveal once the page
                                // has laid the bar out, then focus (a focused
                                // field scrolls itself into view), then reveal
                                // again so the bar stays in view.
                                property <int> passes: 3;
                                function act(a: int) {
                                    if a == 1 {
                                        root.user-focus = true;
                                        root.user-open = true;
                                    } else if a == 2 {
                                        root.review-certificate(root.form(), root.review);
                                    }
                                }
                                // Below the fold, the bar's top goes 8 px
                                // under the header (WINUI3 "SettingsCard",
                                // the account page): a bottom-aligned scroll left the
                                // header's edge cutting through the field
                                // above (the Password box's red underline
                                // right under the title).
                                function reveal() {
                                    let top = err-box.absolute-position.y - settings-scroll.absolute-position.y;
                                    let bottom = top + err-box.height + Theme.s4;
                                    if bottom > settings-scroll.visible-height {
                                        root.err-height = err-box.height;
                                        root.err-pad = true;
                                    }
                                    // With the padding on, the bar's place is
                                    // fixed (the first pass may have scrolled
                                    // before the padding was laid out).
                                    if root.err-pad || top < 0 || bottom > settings-scroll.visible-height {
                                        settings-scroll.content-y -= top - Theme.s2;
                                    }
                                }
                                changed height => { if root.err-pad { root.err-height = self.height; } }
                                Timer {
                                    interval: 60ms;
                                    running: err-box.passes > 0;
                                    triggered => {
                                        err-box.passes -= 1;
                                        if err-box.passes != 1 {
                                            err-box.reveal();
                                        } else if root.rejected {
                                            pw-field.focus();
                                        } else if err-box.a1 != 0 {
                                            root.err-focus += 1;
                                        }
                                    }
                                }
                                InfoBar {
                                    severity: Severity.critical;
                                    message: root.error;
                                    closable: false;
                                    button1: err-box.a1 == 1 ? @tr("Set username") : err-box.a1 == 2 ? @tr("Review certificate") : "";
                                    button2: err-box.a2 == 2 ? @tr("Review certificate") : "";
                                    button-focus: root.err-focus;
                                    button-clicked(i) => { err-box.act(i == 0 ? err-box.a1 : err-box.a2); }
                                    accessible-live-region: assertive;
                                    if root.test-steps.length > 0: VerticalLayout {
                                        padding-top: Theme.s3;
                                        StepList { states: root.test-steps; }
                                    }
                                }
                            }
                            if root.ok != "": VerticalLayout {
                                InfoBar {
                                    severity: Severity.success;
                                    message: root.ok;
                                    closable: false;
                                    accessible-live-region: polite;
                                }
                            }
                            // The steps while the check runs, and after it
                            // passed; a failure shows them inside its bar.
                            if root.test-steps.length > 0 && root.error == "": StepList { states: root.test-steps; }
                            // The account page ends with what acts on the
                            // whole account: Download again, then Remove.
                            if root.edit-id != 0: VerticalLayout {
                                padding-top: Theme.s3;
                                spacing: Theme.s1;
                                GroupHeader { text: @tr("Downloaded mail"); }
                                Rectangle { height: Theme.s1; }
                                SettingsCard {
                                    header: @tr("Download again");
                                    description: @tr("Forgets the copy of this account's mail on this computer and downloads it once more. Mail on the server is not affected.");
                                    action: @tr("Download again");
                                    action-description: @tr("Download the mail of {0} again", root.email);
                                    action-enabled: !root.busy;
                                    action-focus: root.target == "download" + root.edit-id ? root.reopen : 0;
                                    action-clicked => {
                                        root.opener = "download" + root.edit-id;
                                        root.redownload(root.edit-id);
                                    }
                                }
                                // Apart from the rest, at the very end.
                                Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                                SettingsCard {
                                    header: @tr("Remove this account");
                                    description: @tr("Removes the account and its downloaded mail from this computer. Mail on the server is not affected.");
                                    action: @tr("Remove");
                                    action-danger: true;
                                    action-description: @tr("Remove {0}", root.email);
                                    action-enabled: !root.busy;
                                    action-focus: root.target == "remove" + root.edit-id ? root.reopen : 0;
                                    action-clicked => {
                                        root.opener = "remove" + root.edit-id;
                                        root.remove-account(root.edit-id);
                                    }
                                }
                            }
                        }
                    }

                    // ---- General
                    // ---- Signatures (docs/WINUI3.md "Signatures page"): the
                    // list, and one signature's page.
                    if !root.form-open && root.section == 1 && !Sigs.editing: VerticalLayout {
                        alignment: start;
                        spacing: Theme.s1;
                        if Sigs.items.length == 0: Text {
                            text: @tr("No signatures yet. Add one to use it in new mail and replies.");
                            font-size: Theme.body;
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                        for s[i] in Sigs.items: SettingsSurface {
                            height: max(68px, sig-row.preferred-height);
                            accessible-role: groupbox;
                            accessible-label: s.name;
                            accessible-description: s.preview;
                            sig-row := HorizontalLayout {
                                padding: Theme.s4;
                                spacing: Theme.s2;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: s.name;
                                        font-size: Theme.body;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                        accessible-role: none;
                                    }
                                    if s.preview != "": Text {
                                        text: s.preview;
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        overflow: elide;
                                        accessible-role: none;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        label: @tr("Edit");
                                        description: s.name;
                                        clicked => { Sigs.edit(i); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: Icons.delete;
                                        tooltip: @tr("Delete {0}", s.name);
                                        width: 32px;
                                        clicked => { Sigs.delete(i); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-top: Theme.s3;
                            alignment: start;
                            Button {
                                icon: Icons.add;
                                label: @tr("Add signature");
                                clicked => { Sigs.add(); }
                            }
                        }
                    }
                    if !root.form-open && root.section == 1 && Sigs.editing: sig-page := VerticalLayout {
                        alignment: start;
                        spacing: Theme.s3;
                        property <bool> link-open;
                        property <bool> link-error;
                        VerticalLayout {
                            spacing: Theme.s2;
                            FieldHeader { text: @tr("Name"); }
                            TextField {
                                text <=> Sigs.name;
                                accessible-label: @tr("Name");
                                error: Sigs.name-error != "";
                                description: Sigs.name-error;
                                init => { if Sigs.name == "" { self.focus(); } }
                            }
                            if Sigs.name-error != "": FieldNote { error: true; text: Sigs.name-error; }
                        }
                        VerticalLayout {
                            spacing: Theme.s2;
                            FieldHeader { text: @tr("Signature"); }
                            RichToolbar {
                                id: 1;
                                fmt: Rich.sig-fmt;
                                reduced: true;
                                compact: root.width < 900px;
                                link => { sig-page.link-open = true; }
                            }
                            if sig-page.link-open: HorizontalLayout {
                                spacing: Theme.s2;
                                sig-link := TextField {
                                    placeholder-text: @tr("https://example.com or name@example.com");
                                    accessible-label: @tr("Link address");
                                    init => { self.focus(); }
                                    accepted(u) => {
                                        if Rich.link(1, u) {
                                            sig-page.link-open = false;
                                            sig-page.link-error = false;
                                        } else {
                                            sig-page.link-error = true;
                                        }
                                    }
                                }
                                Button {
                                    accent: true;
                                    label: @tr("Insert");
                                    clicked => {
                                        if Rich.link(1, sig-link.text) {
                                            sig-page.link-open = false;
                                            sig-page.link-error = false;
                                        } else {
                                            sig-page.link-error = true;
                                        }
                                    }
                                }
                                IconButton { icon: Icons.dismiss; tooltip: @tr("Cancel (Esc)"); width: 32px; clicked => { sig-page.link-open = false; } }
                            }
                            if sig-page.link-open && sig-page.link-error: FieldNote { error: true; text: @tr("Not a web or e-mail address"); }
                            RichBody {
                                id: 1;
                                state: Rich.sig;
                                height: max(120px, 8 * Theme.body);
                                placeholder-text: @tr("Your name, and what people should know about you");
                                label: @tr("Signature");
                            }
                        }
                        // The logo: at most one, shown as it is sent (at most
                        // 400 x 150 px).
                        VerticalLayout {
                            spacing: Theme.s2;
                            FieldHeader { text: @tr("Logo"); }
                            if Sigs.has-logo: HorizontalLayout {
                                alignment: start;
                                Image {
                                    source: Sigs.logo;
                                    width: Sigs.logo-w;
                                    height: Sigs.logo-h;
                                    image-fit: contain;
                                    accessible-role: image;
                                    accessible-label: @tr("Logo");
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.s2;
                                Button {
                                    icon: Icons.picture;
                                    label: @tr("Add logo…");
                                    clicked => { Sigs.add-logo(); }
                                }
                                if Sigs.has-logo: Button {
                                    label: @tr("Remove logo");
                                    clicked => { Sigs.remove-logo(); }
                                }
                            }
                            if Sigs.logo-error != "": FieldNote { error: true; text: Sigs.logo-error; }
                            FieldNote { text: @tr("The logo must be a PNG or JPEG file of 200 KB or less."); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.s2;
                            Button {
                                accent: true;
                                label: @tr("Save");
                                clicked => { Sigs.save(); }
                            }
                            Button {
                                label: @tr("Cancel");
                                clicked => { Sigs.cancel(); }
                            }
                        }
                    }
                    // Settings > Rules (ui/rules.slint).
                    if !root.form-open && root.section == 2 && !RulesUi.editing: RulesList { }
                    if !root.form-open && root.section == 2 && RulesUi.editing: RuleEditor {
                        wide: settings-scroll.visible-width >= 760px;
                    }
                    if !root.form-open && root.section == 3: VerticalLayout {
                        alignment: start;
                        spacing: Theme.s1;
                        // One card per choice (one ComboBox for all four).
                        for row[i] in [
                            { label: @tr("Theme"), note: @tr("System follows your Windows app mode."), options: [@tr("settings theme" => "System"), @tr("Light"), @tr("Dark")] },
                            { label: @tr("Check for new mail"), note: @tr("Servers that push new mail show it within seconds whatever the interval."), options: [@tr("Every minute"), @tr("Every 2 minutes"), @tr("Every 5 minutes"), @tr("Every 15 minutes")] },
                            { label: @tr("Undo send"), note: @tr("Holds a sent message this long so it can be taken back."), options: [@tr("Off"), @tr("5 seconds"), @tr("10 seconds"), @tr("20 seconds"), @tr("30 seconds")] },
                            { label: @tr("Mark as read"), note: @tr("When a message opens in the reader."), options: [@tr("Right away"), @tr("After 1 second"), @tr("After 3 seconds"), @tr("Never")] },
                        ]: Rectangle {
                            height: choice-card.height;
                            choice-card := SettingsCard {
                                header: row.label;
                                description: row.note;
                                trailing: 200px;
                            }
                            // Over the card's free end, at least 200 px wide.
                            choice := ComboBox {
                                x: parent.width - Theme.s4 - self.width;
                                y: (parent.height - self.height) / 2;
                                width: 200px;
                                model: row.options;
                                current-index: root.g-choices[i];
                                accessible-label: row.label;
                                selected(v) => { root.general-changed(i, self.current-index); }
                            }
                        }
                        SettingsCard {
                            header: @tr("Flash the taskbar button");
                            description: @tr("When new mail arrives while Komorebi is in the background.");
                            toggle: true;
                            toggle-label: @tr("Flash the taskbar button when new mail arrives");
                            checked: root.g-flash;
                            toggled(on) => { root.general-changed(4, on ? 1 : 0); }
                        }
                        SettingsCard {
                            header: @tr("Notifications for new mail");
                            description: @tr("Windows shows a notification when new mail arrives while Komorebi is in the background. They are made on this computer; nothing is sent anywhere.");
                            toggle: true;
                            toggle-label: @tr("Notifications for new mail");
                            checked: root.g-notify;
                            toggled(on) => { root.general-changed(8, on ? 1 : 0); }
                        }
                        SettingsCard {
                            header: @tr("Show the sender and subject");
                            description: @tr("Off: a notification only says New mail, which is safer on a shared screen or the lock screen.");
                            toggle: true;
                            toggle-label: @tr("Show the sender and subject in notifications");
                            checked: root.g-notify-detail;
                            toggled(on) => { root.general-changed(9, on ? 1 : 0); }
                        }
                        SettingsCard {
                            header: @tr("Notifications for event reminders");
                            description: @tr("Windows shows a notification when an event's reminder is due, only while Komorebi is open or in the notification area. The agenda marks due events either way.");
                            toggle: true;
                            toggle-label: @tr("Notifications for event reminders");
                            checked: root.g-cal-remind;
                            toggled(on) => { root.general-changed(13, on ? 1 : 0); }
                        }
                        SettingsCard {
                            header: @tr("Keep running in the notification area");
                            description: @tr("Closing the window keeps Komorebi in the notification area, so mail keeps arriving. Quit from its icon's menu.");
                            toggle: true;
                            toggle-label: @tr("Keep running in the notification area when the window closes");
                            checked: root.g-close-to-tray;
                            toggled(on) => { root.general-changed(10, on ? 1 : 0); }
                        }
                        SettingsCard {
                            header: @tr("Start with Windows");
                            description: @tr("Komorebi starts in the notification area when you sign in to Windows.");
                            toggle: true;
                            toggle-label: @tr("Start Komorebi with Windows");
                            checked: root.g-autostart;
                            toggled(on) => { root.general-changed(11, on ? 1 : 0); }
                        }
                        SettingsCard {
                            header: @tr("Reopen tabs at start");
                            description: @tr("The message and draft tabs open when Komorebi closes come back the next time.");
                            toggle: true;
                            toggle-label: @tr("Reopen tabs at start");
                            checked: root.g-reopen-tabs;
                            toggled(on) => { root.general-changed(7, on ? 1 : 0); }
                        }
                        Rectangle {
                            height: language-card.height;
                            language-card := SettingsCard {
                                header: @tr("settings language" => "Language");
                                description: @tr("settings language" => "The language of menus and messages. System follows your Windows display language.");
                                trailing: 200px;
                            }
                            // Over the card's free end, as the choices above.
                            language-choice := ComboBox {
                                x: parent.width - Theme.s4 - self.width;
                                y: (parent.height - self.height) / 2;
                                width: 200px;
                                // Each language is named in its own language.
                                model: [@tr("settings language" => "System"), "English", "Português (Portugal)"];
                                current-index: root.g-language;
                                accessible-label: @tr("settings language" => "Language");
                                selected(v) => {
                                    root.general-changed(6, self.current-index);
                                    root.language-note = true;
                                }
                            }
                        }
                        // The window is redrawn in the new language at once;
                        // what a running part made before (a line already
                        // shown) follows at the next start.
                        if root.language-note: InfoBar {
                            severity: Severity.info;
                            message: @tr("Some text changes after Komorebi restarts.");
                            closed => { root.language-note = false; }
                        }
                        // New messages: formatted or plain text, and the
                        // font formatted ones start in (with a sample).
                        GroupHeader { text: @tr("Compose"); }
                        Rectangle {
                            height: format-card.height;
                            format-card := SettingsCard {
                                header: @tr("Message format");
                                description: @tr("How new messages start. Any message can be switched in its More menu.");
                                trailing: 200px;
                            }
                            format-choice := ComboBox {
                                x: parent.width - Theme.s4 - self.width;
                                y: (parent.height - self.height) / 2;
                                width: 200px;
                                model: [@tr("Formatted (HTML)"), @tr("Plain text")];
                                current-index: Rich.def-format;
                                accessible-label: @tr("Message format");
                                selected => { Rich.defaults-changed(self.current-index, Rich.def-font, Rich.def-size, Rich.def-color); }
                            }
                        }
                        SettingsSurface {
                            height: font-col.preferred-height;
                            accessible-role: groupbox;
                            accessible-label: @tr("Default font");
                            font-col := VerticalLayout {
                                padding: Theme.s4;
                                spacing: Theme.s2;
                                Text {
                                    text: @tr("Default font");
                                    font-size: Theme.body;
                                    color: Theme.text;
                                    accessible-role: none;
                                }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    alignment: start;
                                    Rectangle {
                                        width: 160px;
                                        height: 32px;
                                        ComboBox {
                                            width: 100%;
                                            height: 100%;
                                            model: Rich.fonts;
                                            current-index: Rich.def-font;
                                            accessible-label: @tr("Font");
                                            selected => { Rich.defaults-changed(Rich.def-format, self.current-index, Rich.def-size, Rich.def-color); }
                                        }
                                    }
                                    Rectangle {
                                        width: 72px;
                                        height: 32px;
                                        ComboBox {
                                            width: 100%;
                                            height: 100%;
                                            model: Rich.sizes;
                                            current-index: Rich.def-size;
                                            accessible-label: @tr("Font size");
                                            selected => { Rich.defaults-changed(Rich.def-format, Rich.def-font, self.current-index, Rich.def-color); }
                                        }
                                    }
                                    Rectangle {
                                        width: 160px;
                                        height: 32px;
                                        ComboBox {
                                            width: 100%;
                                            height: 100%;
                                            model: [Rich.color-name(-1), Rich.color-name(0), Rich.color-name(1), Rich.color-name(2), Rich.color-name(3), Rich.color-name(4), Rich.color-name(5), Rich.color-name(6), Rich.color-name(7), Rich.color-name(8), Rich.color-name(9)];
                                            current-index: Rich.def-color + 1;
                                            accessible-label: @tr("Font colour");
                                            selected => { Rich.defaults-changed(Rich.def-format, Rich.def-font, Rich.def-size, self.current-index - 1); }
                                        }
                                    }
                                }
                                // A sample line in the font, size and colour
                                // (author colours show as text under a
                                // contrast theme, as in the editor).
                                Text {
                                    text: @tr("The quick brown fox jumps over the lazy dog.");
                                    font-family: Rich.fonts[Rich.def-font];
                                    font-size: Rich.sizes[Rich.def-size].to-float() * 4 / 3 * Theme.body / 14;
                                    color: Rich.def-color >= 0 && !Theme.contrast ? Rich.swatches[Rich.def-color] : Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- Privacy: what loads, what is logged, and the
                    // one reset (Download again is on each account's page).
                    if !root.form-open && root.section == 4: VerticalLayout {
                        alignment: start;
                        spacing: Theme.s1;
                        GroupHeader { text: @tr("Remote images"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.picture;
                            header: @tr("Senders whose images always load");
                            description: root.remote-senders.length == 0 ? @tr("None yet. Everyone else's images stay blocked until you load them, and tracking pixels never load.") : @tr("Everyone else's images stay blocked until you load them, and tracking pixels never load.");
                            action: root.remote-senders.length > 0 ? @tr("Forget all") : "";
                            action-clicked => { root.forget-all-remote(); }
                        }
                        for a in root.remote-senders: SettingsCard {
                            header: a;
                            action: @tr("Remove");
                            action-description: @tr("Remove {0}", a);
                            action-clicked => { root.forget-remote(a); }
                        }

                        Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                        GroupHeader { text: @tr("Diagnostics"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.document;
                            header: @tr("Diagnostics log");
                            description: @tr("Records only server commands, response codes and timings on this PC, never mail, addresses or passwords; nothing is sent.");
                            toggle: true;
                            toggle-label: @tr("Keep a diagnostics log");
                            checked: root.g-diag;
                            toggled(on) => { root.general-changed(5, on ? 1 : 0); }
                        }
                        SettingsCard {
                            icon: Icons.folder;
                            header: @tr("Logs folder");
                            description: @tr("The log files, in the data folder.");
                            action: @tr("Open logs folder");
                            action-description: @tr("Open the logs folder in File Explorer");
                            action-clicked => { root.open-logs-folder(); }
                        }

                        Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                        GroupHeader { text: @tr("Mail cache"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.lock;
                            header: @tr("Encrypt the mail cache on this computer");
                            description: @tr("Downloaded mail, drafts and the Outbox are encrypted with a key only your Windows user can unlock. If that key is lost, drafts and the Outbox, which exist only in the cache, are lost too. Attachment copies are not encrypted.");
                            toggle: true;
                            toggle-label: @tr("Encrypt the mail cache on this computer");
                            checked: CacheLock.wanted;
                            toggled(on) => {
                                if on {
                                    CacheLock.ask = 1;
                                } else {
                                    CacheLock.set(false);
                                }
                            }
                        }
                        if CacheLock.pending: SettingsCard {
                            header: CacheLock.wanted ? @tr("The cache is encrypted when Komorebi next starts.") : @tr("The cache is decrypted when Komorebi next starts.");
                            description: @tr("This can take a minute for a large cache.");
                            action: @tr("Restart now");
                            action-clicked => { CacheLock.restart(); }
                        }

                        Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                        GroupHeader { text: @tr("settings group" => "Reset"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.delete;
                            header: @tr("Remove all data");
                            description: @tr("Deletes the saved passwords of all accounts from Windows Credential Manager, then everything Komorebi keeps in the data folder (downloaded mail, drafts, the Outbox, settings and logs), and closes Komorebi. Mail on the server is not affected.");
                            action: @tr("Remove all data");
                            action-danger: true;
                            action-enabled: !root.busy;
                            action-focus: root.target == "remove-all" ? root.reopen : 0;
                            action-clicked => {
                                root.opener = "remove-all";
                                root.remove-all-data();
                            }
                        }
                    }

                    // ---- About: the version, a Help group and an About
                    // group, every action at the cards' end.
                    if !root.form-open && root.section == 5: VerticalLayout {
                        alignment: start;
                        spacing: Theme.s1;
                        SettingsCard {
                            icon: Icons.mail;
                            header: "Komorebi";
                            description: @tr("Version {0} · GPL-3.0-or-later", root.about-version);
                        }
                        // Updates (src/app/updates.rs): the state on the
                        // card, Check for updates at its end; under it what
                        // can be done with a version found, and the switch.
                        Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                        GroupHeader { text: @tr("about group" => "Updates"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.refresh;
                            header: root.up-state == 1 ? @tr("Checking for updates…")
                                : root.up-state == 2 ? @tr("Komorebi is up to date.")
                                : root.up-state == 3 ? @tr("Version {0} is available.", root.up-version)
                                : root.up-state == 4 ? @tr("Downloading version {0}…", root.up-version)
                                : root.up-state == 5 ? @tr("The update didn't work.")
                                : root.up-state == 6 ? @tr("Starting the installer…")
                                : @tr("Check for updates");
                            description: root.up-state == 5 ? (
                                    root.up-error == 0 ? @tr("Komorebi is offline, so it can't look for updates.")
                                    : root.up-error == 1 ? @tr("GitHub couldn't be reached. Check the connection and try again.")
                                    : root.up-error == 2 ? @tr("The release on GitHub isn't complete yet. Try again later.")
                                    : root.up-error == 3 ? @tr("The download was larger than expected, so it was stopped.")
                                    : root.up-error == 4 ? @tr("The download didn't pass the signature check, so it wasn't installed.")
                                    : @tr("The installer couldn't be saved or started."))
                                : root.up-state == 4 && root.up-total != "" ? @tr("{0} of {1}", root.up-done, root.up-total)
                                : root.up-state == 4 ? @tr("The installer is checked against the project's signature before it runs.")
                                : root.up-state == 6 ? @tr("Komorebi closes now and opens again when the update is done.")
                                : root.up-state == 3 ? @tr("Nothing is downloaded until you press Download and install.")
                                : @tr("Komorebi asks GitHub for the latest release. Nothing about you or your mail is sent.");
                            action: root.up-state == 3 || root.up-state == 4 || root.up-state == 6 ? "" : @tr("Check for updates");
                            action-enabled: root.up-state != 1;
                            action-description: @tr("Check GitHub for a newer version of Komorebi");
                            action-clicked => { root.update-action(0); }
                        }
                        if root.up-state == 1 || root.up-state == 4: Rectangle {
                            height: Theme.s3;
                            ProgressBar {
                                y: Theme.s1;
                                indeterminate: root.up-state == 1 || root.up-progress < 0;
                                value: max(root.up-progress, 0);
                                accessible-label: root.up-state == 1 ? @tr("Checking for updates") : @tr("Downloading version {0}", root.up-version);
                            }
                        }
                        if root.up-state == 3 || (root.up-state == 5 && root.up-retry): SettingsSurface {
                            height: up-row.preferred-height;
                            up-row := VerticalLayout {
                                // Under the card's text, not its icon: 16 and
                                // the 42 px icon column of a SettingsCard.
                                padding: Theme.s4;
                                padding-left: Theme.s4 + 42px;
                                spacing: Theme.s2;
                                // The link's own 11 px inset is taken back, so
                                // its text starts where the card's does.
                                Rectangle {
                                    height: link.height;
                                    link := HyperlinkButton {
                                        x: -11px;
                                        width: self.min-width;
                                        text: @tr("Release notes");
                                        label: @tr("Open the release notes of version {0} in the browser", root.up-version);
                                        clicked => { root.update-action(3); }
                                    }
                                }
                                // Side by side, or one under the other when
                                // they don't fit (a long translation).
                                up-btns := Rectangle {
                                    property <bool> stacked: up-install.preferred-width + Theme.s2 + up-later.preferred-width > self.width;
                                    height: self.stacked && up-later.visible ? up-later.y + up-later.height : up-install.height;
                                    up-install := Button {
                                        x: 0;
                                        y: 0;
                                        width: self.preferred-width;
                                        accent: true;
                                        label: root.up-state == 5 ? @tr("Try again") : @tr("Download and install");
                                        description: @tr("Download version {0}, check its signature, then close Komorebi and install it", root.up-version);
                                        clicked => { root.update-action(1); }
                                    }
                                    up-later := Button {
                                        x: up-btns.stacked ? 0 : up-install.width + Theme.s2;
                                        y: up-btns.stacked ? up-install.height + Theme.s2 : 0;
                                        width: self.preferred-width;
                                        visible: root.up-state == 3;
                                        enabled: self.visible;
                                        label: @tr("update" => "Later");
                                        description: @tr("Hide the update bar until tomorrow");
                                        clicked => { root.update-action(2); }
                                    }
                                }
                            }
                        }
                        SettingsCard {
                            icon: Icons.calendar;
                            header: @tr("Check for updates automatically");
                            description: @tr("Once a day, a few seconds after Komorebi starts. Updates are never installed without your press.");
                            toggle: true;
                            toggle-label: @tr("Check for updates automatically");
                            checked: root.up-auto;
                            toggled(on) => { root.general-changed(12, on ? 1 : 0); }
                        }
                        // Help that is findable later:
                        // every page opens through the link prompt.
                        Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                        GroupHeader { text: @tr("about group" => "Help"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.lightbulb;
                            header: @tr("What's new in {0}", root.about-version);
                            description: @tr("The changes in this version, in the changelog.");
                            action: @tr("about" => "Open");
                            action-description: @tr("Open the changelog in the browser");
                            action-clicked => { root.about-link(2); }
                        }
                        SettingsCard {
                            icon: Icons.info;
                            header: @tr("Show tips again");
                            description: @tr("Shows the short tips about folders, search and help again.");
                            action: @tr("Show tips");
                            action-clicked => { root.show-tips-again(); }
                        }
                        SettingsCard {
                            icon: Icons.keyboard;
                            header: @tr("Keyboard shortcuts");
                            description: @tr("Every key, by group. Press F1 or Ctrl+/ anywhere.");
                            action: @tr("about" => "Show");
                            action-description: @tr("Show the keyboard shortcuts");
                            action-clicked => { root.show-shortcuts(); }
                        }
                        SettingsCard {
                            icon: Icons.help;
                            header: @tr("Get help");
                            description: @tr("The Komorebi guide: adding an account, the keys and the settings.");
                            action: @tr("about" => "Open");
                            action-description: @tr("Open the Komorebi guide in the browser");
                            action-clicked => { root.about-link(3); }
                        }
                        SettingsCard {
                            icon: Icons.feedback;
                            header: @tr("Report a problem");
                            description: @tr("Opens the issues page in the browser. No data is attached.");
                            action: @tr("Report");
                            action-description: @tr("Open the issues page in the browser");
                            action-clicked => { root.about-link(4); }
                        }

                        Rectangle { height: Theme.s6 - 2 * Theme.s1; }
                        GroupHeader { text: @tr("about group" => "About"); }
                        Rectangle { height: 0; }
                        SettingsCard {
                            icon: Icons.shield;
                            header: @tr("Privacy statement");
                            description: @tr("What Komorebi keeps on this PC, and what it sends where.");
                            action: @tr("about" => "Open");
                            action-description: @tr("Open the privacy statement in the browser");
                            action-clicked => { root.about-link(1); }
                        }
                        // The path on one line, cut from its start (its end
                        // names the folder), whole in the tooltip.
                        Rectangle {
                            height: data-card.height;
                            data-card := SettingsCard {
                                icon: Icons.folder;
                                header: @tr("Data folder");
                                description: " ";
                                trailing: data-copy.width + Theme.s2 + data-open.width;
                            }
                            data-path := Rectangle {
                                x: Theme.s4 + 42px;
                                y: data-card.height / 2;
                                width: data-copy.x - Theme.s4 - self.x;
                                height: path-text.preferred-height;
                                clip: true;
                                accessible-role: text;
                                accessible-label: @tr("Data folder");
                                accessible-value: root.about-data;
                                property <bool> cut: path-text.preferred-width > self.width;
                                path-text := Text {
                                    x: data-path.cut ? data-path.width - self.width : 0;
                                    width: self.preferred-width;
                                    text: root.about-data;
                                    font-size: Theme.caption;
                                    color: Theme.text-2;
                                    accessible-role: none;
                                }
                                if data-path.cut: Rectangle {
                                    x: 0;
                                    width: dots.preferred-width + 4px;
                                    // The card's fill over the layer, opaque.
                                    background: Theme.layer;
                                    Rectangle { background: Theme.card-fill; }
                                    dots := Text {
                                        x: 0;
                                        text: "…";
                                        font-size: Theme.caption;
                                        color: Theme.text-2;
                                        accessible-role: none;
                                    }
                                }
                                path-ta := TouchArea { }
                                TipTimer {
                                    text: data-path.cut ? root.about-data : "";
                                    hover: path-ta.has-hover;
                                    pressed: path-ta.pressed;
                                }
                            }
                            data-copy := Button {
                                x: data-open.x - Theme.s2 - self.width;
                                y: (parent.height - self.height) / 2;
                                width: self.preferred-width;
                                label: @tr("Copy");
                                description: @tr("Copy the data folder's path");
                                clicked => { root.copy-text(root.about-data); }
                            }
                            data-open := Button {
                                x: parent.width - Theme.s4 - self.width;
                                y: (parent.height - self.height) / 2;
                                width: self.preferred-width;
                                label: @tr("about" => "Open");
                                description: @tr("Open the data folder in File Explorer");
                                clicked => { root.open-data-folder(); }
                            }
                        }
                        Rectangle {
                            height: source-card.height;
                            source-card := SettingsCard {
                                icon: Icons.link;
                                header: @tr("Source code");
                                description: @tr("Free and open source, with no telemetry and no ads. Passwords are kept in Windows Credential Manager.");
                                trailing: repo-link.min-width;
                            }
                            repo-link := HyperlinkButton {
                                width: self.min-width;
                                x: parent.width - Theme.s4 - self.width;
                                y: (parent.height - self.height) / 2;
                                text: "github.com/RusticStack/komorebi";
                                label: @tr("Open the Komorebi repository in the browser");
                                clicked => { root.open-repository(); }
                            }
                        }
                        // Slint's notice, as its own card: its logo at the
                        // card's end, where the others have their action.
                        Rectangle {
                            height: max(slint-card.preferred-height, 112px);
                            slint-card := SettingsCard {
                                height: parent.height;
                                icon: Icons.code;
                                header: @tr("Made with Slint");
                                description: @tr("The toolkit Komorebi's window is built with.");
                                trailing: 150px;
                            }
                            AboutSlint {
                                x: parent.width - Theme.s4 - self.width;
                                y: (parent.height - self.height) / 2;
                                width: 150px;
                                height: 96px;
                            }
                        }
                    }
                }
            }

            // The form's buttons, pinned under the scroll view after a
            // divider, so Save (or Add account) never scrolls away. Add
            // account (Save) and Test connection stay enabled (a press says
            // what is missing) but while a check runs; Cancel always. Side
            // by side, or one under the other when they don't fit.
            if root.form-open: VerticalLayout {
                vertical-stretch: 0;
                Divider { }
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    padding-bottom: Theme.s4;
                    alignment: start;
                    VerticalLayout {
                        preferred-width: 560px;
                        max-width: 560px;
                        spacing: Theme.s2;
                        btn-row := Rectangle {
                            property <bool> stack: add-btn.natural-width + test-btn.natural-width + cancel-btn.natural-width + 2 * Theme.s2 > self.width;
                            height: cancel-btn.y + cancel-btn.height;
                            add-btn := Button {
                                x: 0;
                                y: Theme.s4;
                                width: self.natural-width;
                                accent: true;
                                label: @tr("Save");
                                enabled: root.can-save;
                                clicked => { root.submit(false); }
                            }
                            test-btn := Button {
                                x: btn-row.stack ? 0 : add-btn.width + Theme.s2;
                                y: btn-row.stack ? add-btn.y + add-btn.height + Theme.s2 : add-btn.y;
                                width: self.natural-width;
                                label: @tr("Test connection");
                                enabled: !root.busy && root.email != "";
                                description: @tr("Checks the servers and the sign-in without saving anything");
                                clicked => { root.submit(true); }
                            }
                            cancel-btn := Button {
                                x: btn-row.stack ? 0 : test-btn.x + test-btn.width + Theme.s2;
                                y: btn-row.stack ? test-btn.y + test-btn.height + Theme.s2 : add-btn.y;
                                width: self.natural-width;
                                label: @tr("Cancel");
                                description: root.busy ? @tr("Stops the check; the form stays as typed") : "";
                                clicked => {
                                    if root.busy {
                                        root.cancel-check();
                                    } else {
                                        root.back();
                                    }
                                }
                            }
                        }
                        // The wait: a ring with "Signing in…" after a
                        // second, and after 3 s what to check.
                        if root.busy: HorizontalLayout {
                            spacing: Theme.s2;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 2px;
                                ring := ProgressRing {
                                    active: true;
                                    accessible-label: root.cert-wait ? @tr("Reading the certificate") : @tr("Signing in");
                                }
                            }
                            Text {
                                text: root.cert-wait ? @tr("Reading the certificate\u{a0}…")
                                    : root.slow ? @tr("Still signing in\u{a0}… You can cancel and check the server name.")
                                    : @tr("Signing in\u{a0}…");
                                visible: ring.due;
                                accessible-live-region: polite;
                                font-size: Theme.body;
                                color: Theme.text;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ window

export component AppWindow inherits Window {
    // "Inbox (7) - Komorebi" while the inboxes hold unread mail.
    in property <string> window-title: "Komorebi";
    title: root.window-title;
    // The list keys work from the start, before any click.
    forward-focus: list-keys;
    // 500 px, so Snap Layouts' halves and thirds fit (a 1366 px screen's
    // half, a 1920 px screen's third); below 720 px one pane shows at a
    // time (docs/WINUI3.md "Layout breakpoints").
    min-width: 500px;
    min-height: 480px;
    // Explicit, so the window is never bounded by its content: on a first
    // run (no account) the layout reported a transient zero maximum height
    // as the window was created, and the window opened at its minimum height
    // instead of its preferred one.
    max-width: 100000px;
    max-height: 100000px;
    preferred-width: 1280px;
    preferred-height: 820px;
    background: Theme.layer;
    default-font-family: Theme.text-font;
    // Std widgets size their text from it, so they follow the text size too.
    default-font-size: Theme.body;
    // Navigation
    in property <[NavItem]> nav-items;
    in property <int> selected-folder: 0;     // folder id; 0 = all inboxes, -1 = local drafts, -2 = outbox
    in property <bool> has-accounts: true;
    // The mail view shows: an account, and no first-run flow over the
    // whole window (the onboarding page, ui/onboarding.slint).
    property <bool> mail-shown: root.has-accounts && !root.ob-full;
    // The row with the selection pill: the open folder's, or while it is
    // inside a folded line, that line's (-1: none).
    in property <int> nav-pill: 0;
    // The folder list's keyboard row (Rust keeps it on its line when rows
    // fold, and on the pill when the view changes).
    in-out property <int> nav-cursor: 0;
    callback nav-clicked(NavItem);
    // Fold or open an account line or a parent folder (never changes the
    // view).
    callback nav-toggle(NavItem);
    // The narrow window's rail: the unified items and one tile per
    // account (kind 2 with its initial, opening its Inbox); its pill is
    // on the open view's row or the open folder's account.
    in property <[NavItem]> rail-items;
    in property <int> rail-pill: 0;
    // The folder pane's row menu ("...", right-click, Shift+F10 or the
    // Menu key): Rust says whether the row has one and puts its entries in
    // two groups (`App::nav_menu`); `nav-command` runs one on the row
    // (0 Refresh, 1 Mark all as read, 3 Collapse all, 4 Account settings,
    // 6 open the folder `id`).
    callback nav-context(NavItem) -> bool;
    callback nav-command(NavItem, /* command */ int, /* id */ int);
    in property <[MenuCommand]> nav-menu-main;
    in property <[MenuCommand]> nav-menu-extra;
    // The words of the rail's fixed names (New mail, All inboxes, Drafts,
    // Outbox, Settings, Folders) in the language shown: the rail is as wide
    // as the longest needs (Theme.rail-width), so none is cut.
    in property <[string]> rail-words;

    // Message list
    in property <string> list-title: @tr("All inboxes");
    // A folder's account (its name, else its address), under the title.
    in property <string> list-subtitle;
    // A server Drafts folder: no filters (its rows are never unread).
    in property <bool> list-drafts;
    // The list's "..." menu, set as it opens; `list-command` runs one.
    in property <[MenuCommand]> list-menu;
    callback list-menu-opening();
    callback list-command(int);
    in property <[MailRow]> rows;
    in property <int> selected-id: -1;
    in property <int> selected-index: -1;
    in property <bool> syncing;
    in-out property <string> search-text;
    callback message-selected(int);
    callback select-offset(int);
    // Multi-select: Ctrl+click, Shift+click, Shift+Up/Down, Ctrl+A, Esc.
    // With more than one row selected (or one picked without opening it)
    // the reader pane shows the "N selected" panel instead of a message.
    in property <int> selected-count;
    callback message-toggled(int);
    callback message-extended(int);
    callback select-extend(int);
    callback select-all-rows();
    callback refresh();
    callback search-edited(string);
    // List keys: Home / End, Enter (true when a message shows; the page
    // then takes the focus), Esc (search, then selection and reader).
    callback select-edge(/* end */ bool);
    callback open-current() -> bool;
    callback list-escape();
    callback clear-search();
    in-out property <bool> focus-page;
    // 0 everything, 1 unread, 2 important (\Flagged); what an empty list says.
    in-out property <int> list-filter;
    in property <string> list-empty: @tr("Nothing here");
    // The account shown is in its first download: 1 while its size is not
    // known yet, 2 with `list-fresh-value` (0 to 1) done.
    in property <int> list-fresh;
    in property <float> list-fresh-value;
    callback set-filter(int);
    callback mark-all-read();
    // The search scope (the title bar's scope control): the view shown,
    // or every folder.
    in property <bool> search-all;
    callback set-search-all(bool);
    // The view the search applies to ("Search Newsletters"), and what the
    // last search found (the results line).
    in property <string> search-view: @tr("All inboxes");
    in property <int> result-count;
    // The scope's first word: never a view name (the placeholder has it).
    property <string> scope-first: root.selected-folder == 0 ? Tr.scope-these-inboxes() : Tr.scope-this-folder();
    // The scope menu's check marks (set as it opens).
    property <bool> scope-mark-this: true;
    property <bool> scope-mark-all;
    // The row menu's Show in folder (while searching): the message in its
    // folder, the search cleared.
    callback show-in-folder();

    // ---- The title bar (docs/WINUI3.md "Title bar"): app-drawn on
    // Windows 11 (`custom-title-bar`); else the system caption sits above
    // the same strip, which then holds only the search.
    in property <bool> custom-title-bar: true;
    // The app icon, from the .exe's own icon resource (no image decoder).
    in property <image> app-icon;
    in property <bool> window-active: true;
    in property <bool> window-maximized;
    // The caption button under the pointer and the one held down (1
    // minimize, 2 maximize, 3 close), as the window procedure reports them.
    in property <int> caption-hover;
    in property <int> caption-pressed;
    // A caption button's command (Narrator's default action).
    callback caption-command(int);
    // The 1 px top edge, for a Windows that draws none over the frame.
    in property <bool> top-border;
    // Its height grows with the search box at a large text size; the
    // caption buttons stay 46 x 48 at the top.
    out property <length> bar-height: root.detail-only ? 0 : max(48px, search.height + 2 * Theme.s2);
    // The bar's interactive parts and height, pushed to the hit test
    // whenever they change (the window procedure never reads Slint).
    callback title-bar-regions(/* height */ length, [BarRect], /* popup open */ bool);
    // An in-window popup (a Move list) is open: the bar is then all client
    // area but the caption buttons, so a click there closes it.
    in-out property <bool> popup-open;
    changed popup-open => { title-bar.push(); }
    changed has-message => { root.popup-open = false; }
    changed selected-count => { root.popup-open = false; }

    // ---- Tabs (docs/WINUI3.md "TabView"; src/app/tabs.rs): the Mail tab
    // first, then message and draft tabs; the strip shows from two tabs.
    in property <[TabItem]> tabs: [{ kind: 0 }];
    in property <int> active-tab;
    // The active tab's kind: 0 Mail, 1 a message, 2 a draft.
    in property <int> tab-kind;
    property <bool> mail-tab: root.tab-kind == 0;
    out property <bool> tabs-shown: root.mail-shown && !root.ob-open && root.tabs.length > 1;
    property <length> strip-height: root.tabs-shown ? strip.strip-height : 0;
    // Where the content (pane, list, reader, Settings) starts.
    out property <length> content-top: root.bar-height + root.strip-height;
    callback tab-activate(int);
    callback tab-close(int);
    callback tab-move(/* from */ int, /* to */ int);
    // A tab's menu command on tab `index` (0 close, 1 close the others, 2
    // close those to the right, 3 open in a new window, 4 reopen the last
    // closed one).
    callback tab-command(/* index */ int, /* command */ int);
    // Ctrl+Shift+T has a tab to open again.
    in property <bool> tabs-reopenable;
    // The tab keys (§3.4): 1 next, 2 previous, 3 move left, 4 move right,
    // 5 close, 6 reopen the last closed, 10 + n go to tab n (Ctrl+1..9).
    callback tab-key(int);
    // A message row opened in a tab (double-click; `background`: a
    // middle-click), the list's current row (Shift+Enter), or in a window
    // (Ctrl+O, the menus).
    callback open-tab(/* id */ int, /* background */ bool);
    callback open-current-tab();
    callback open-window();
    // A draft from the reading pane went to a composer window of its own:
    // the pane says so, with a way to bring that window forward.
    in property <bool> draft-popped;
    callback bring-popped();
    // The tab's message was moved or deleted on the server: readable, its
    // actions off.
    in property <bool> r-gone;
    // ---- A read-only message window ("Open in new window",
    // src/app/windows.rs): this window shows one message and its reader
    // only (no title bar of its own: the system caption; no folders, list,
    // tabs or Settings). Esc and Ctrl+W close it.
    in property <bool> detail-only;
    callback close-window();
    // The tab keys work over the mail (no dialog, Settings or first-run
    // flow in the way).
    property <bool> tab-keys-on: root.mail-shown && !root.ob-open && !root.show-settings && !root.show-calendar && !root.shortcuts-show && !root.src-show
        && !root.l-show && root.q-title == "" && !root.c-confirm-discard && !Rich.plain-ask && !root.why-show;
    // The tab menu's place and the tab it is for.
    property <int> menu-tab;
    property <bool> menu-tab-message;
    property <bool> menu-tab-right;

    // Reader
    in property <bool> has-message;
    in property <bool> loading;
    in property <string> r-subject;
    in property <string> r-from-name;
    in property <string> r-from-addr;
    in property <string> r-initials;
    in property <color> r-avatar: Theme.accent;
    in property <string> r-date;
    in property <string> r-to;
    in property <string> r-cc;
    in property <string> r-body;
    in property <bool> r-flagged;
    in property <bool> r-unread;
    // The importance its sender set (`Importance::code`: 0 normal, 1 high,
    // 2 low): a line under the To line, never the user's Important.
    in property <int> r-importance;
    // The open message is in a server Drafts folder (saved on another
    // device or in webmail): no Reply or Reply all, an InfoBar instead.
    in property <bool> r-server-draft;
    // The open message has a reply in progress: an Informational bar with
    // Resume (which reopens it, as Reply does).
    in property <bool> r-draft-reply;
    in property <[AttachmentRow]> r-attachments;
    // The bars above the body: why to look twice at the sender, and that
    // the message is encrypted (empty: none).
    in property <string> r-notice;
    in property <string> r-crypt;
    // The message has a usable List-Unsubscribe address.
    in property <bool> r-unsubscribe;
    callback unsubscribe();
    // The meeting invitation in the message (a card while `i-title` is
    // set): its when/organizer/where/repeat lines, a state line (cancelled,
    // updated, over, or the answer given), its description behind Details,
    // and the actions it offers in two rows (`i-answers`, `i-tools`), as
    // `invite` codes: 0 join, 1 accept, 2 tentative, 3 decline, 4 save
    // .ics, 5 change the answer; 6 (Details) stays in the card.
    in property <string> i-title;
    in property <string> i-lines;
    in property <string> i-state;
    in property <string> i-details;
    in property <bool> i-cancelled;
    in property <[int]> i-answers;
    // The answer already given (1 accept, 2 tentative, 3 decline; 0 none).
    in property <int> i-answer;
    in property <[int]> i-tools;
    callback invite(int);
    // HTML body: rendered off-thread into tiles on a paper card. While a
    // render is pending (`r-waiting`) neither the tiles nor the text show.
    in property <bool> r-html;
    in property <bool> r-waiting;
    in property <[Tile]> r-tiles;
    in property <length> r-page-width;
    in property <length> r-page-height;
    in property <color> r-paper: white;
    in property <bool> r-truncated;
    // Shown above a text body that stands in for a failed HTML render.
    in property <string> r-note;
    // Remote images the page leaves out; a banner offers to load them once,
    // or always for this sender (`true`).
    in property <int> r-remote-blocked;
    callback r-load-remote(bool);
    // "Always load from this sender" was just pressed for this address
    // (its bar with Undo); the open message's sender is allowed (the
    // caption); Undo; Settings > Privacy.
    in-out property <string> r-remote-always;
    in property <bool> r-remote-allowed;
    callback r-remote-undo();
    function open-privacy() {
        root.settings-section = 4;
        root.return-pane = root.pane-of-focus();
        root.pane-open = false;
        root.show-settings = true;
    }
    // The open message is in a Junk folder (the notice offers Not junk).
    in property <bool> r-in-junk;
    // The sender notice's "Why?" dialog.
    in-out property <bool> why-show;
    // After loading them: the images that couldn't be loaded.
    in property <int> r-remote-failed;
    // "View as plain text": the text view instead of the page, for this
    // message only.
    in-out property <bool> r-plain;
    // The page's colours are dimmed for the dark theme; "Show original
    // colours" turns that off for this message (`r-original`).
    in property <bool> r-dimmed;
    in-out property <bool> r-original;
    callback r-show-original(bool);
    // Text selection on the page: gestures in page coordinates go to the
    // controller, which answers with highlight rectangles.
    in property <[SelRect]> r-selection;
    callback r-press(length, length);
    callback r-extend(length, length);
    callback r-select-all();
    callback r-clear-selection();
    callback r-copy();
    // Links: the page under the pointer is a link (pointer cursor), the
    // href shown in the bottom strip (hovered, else focused), the focus
    // ring, and the links for screen readers.
    in property <bool> r-hover-link;
    in property <string> r-hover-href;
    in property <[SelRect]> r-focus;
    in property <[LinkItem]> r-links;
    callback r-hover(length, length);
    callback r-release(length, length);
    // Tab (or Shift+Tab with `true`): `false` once focus runs off the links.
    callback r-focus-link(bool) -> bool;
    callback r-activate-focused();
    callback r-activate(int);
    // The confirm prompt before a web link opens in the browser.
    in-out property <bool> l-show;
    in property <string> l-before;
    in property <string> l-host;
    in property <string> l-after;
    in property <[string]> l-warnings;
    callback l-open();
    callback l-cancel();
    in-out property <length> r-content-y;
    // The sideways scroll of a page wider than the column (0 or less).
    in-out property <length> r-page-x;
    // Reported to the controller: the body column's width, and the visible
    // band of the page in page coordinates.
    out property <length> r-body-width;
    out property <length> r-view-top;
    out property <length> r-view-height;
    // The lowest `r-content-y` (the body scrolled to its end).
    out property <length> r-scroll-min;
    // Device pixels per logical pixel; tiles are re-rendered when it changes.
    out property <float> r-scale: 1px / 1phx;
    callback r-body-resized();
    callback r-view-changed();
    in property <[FolderOption]> move-targets;
    // Move can run (some folder to go to, before the flyout's filter): off
    // for a selection across accounts.
    in property <bool> move-possible;
    // Which of the reader bar's labels show: a bit per button in drop order
    // (1 Forward, 2 Reply all, 4 Move, 8 Mark as important, 16 Mark as read, 32 Reply,
    // 64 Delete, 128 Archive), for the tests.
    out property <int> cmd-labels;
    callback reply();
    callback reply-all();
    callback forward();
    callback edit-server-draft();
    callback archive();
    callback delete();
    callback toggle-read();
    callback toggle-flag();
    // The selection's buttons: read or unread, flag or unflag.
    callback mark-read(bool);
    callback mark-flagged(bool);
    callback move-to(int);
    // The row menu (right-click a message) and the reader's More menu act
    // on what is selected; their labels are set as they open.
    callback message-context(int) -> bool;
    callback menu-opening();
    // The row menu and the reader's More menu, built by Rust as they open
    // (`menu-opening`; `menu:row` and `menu:more` print them): groups
    // between separators, the Move to submenu after the row menu's third
    // group and the More menu's first. Each runs `run-command`.
    in property <[MenuCommand]> row-menu-1;
    in property <[MenuCommand]> row-menu-2;
    in property <[MenuCommand]> row-menu-3;
    in property <[MenuCommand]> row-menu-4;
    in property <[MenuCommand]> row-menu-5;
    in property <[MenuCommand]> row-menu-6;
    in property <[MenuCommand]> more-menu-1;
    in property <[MenuCommand]> more-menu-2;
    in property <[MenuCommand]> more-menu-3;
    in property <[MenuCommand]> more-menu-4;
    in property <[MenuCommand]> more-menu-5;
    // A row's quick action (0 Archive, 1 Delete, 2 Important, 3 Read) on that
    // message only: it never opens it.
    callback message-quick(/* id */ int, /* action */ int);
    // "Select messages" (the list's "..." menu): check boxes on the rows.
    in property <bool> select-mode;
    // The rows' check boxes show with it on, or two or more rows selected.
    property <bool> list-checks: root.select-mode || root.selected-count >= 2;
    // Clear selection and Select all (the "N selected" panel).
    callback clear-selection();
    // The Move flyout's filter, which Rust applies to `move-targets`.
    in-out property <string> move-filter;
    callback move-filter-edited(string);
    // Ctrl+Shift+V: the Move flyout where it shows (the reader's Move
    // button, or the selection's).
    property <int> move-seq;
    public function open-move() {
        if (root.has-message || root.selected-count > 0) && root.move-possible {
            root.move-seq += 1;
        }
    }
    // Ctrl+Shift+I: the Inbox (All inboxes with two or more accounts).
    callback go-inbox();
    // The Undo offer at the bottom of the list (its own slot): a move's or
    // a send's; Undo (Ctrl+Z) takes it back, and its time stops while the
    // pointer is over it or it has the focus (`undo-hold`).
    in property <string> undo-text;
    callback undo-clicked();
    callback undo-hold(bool);
    // The open message isn't downloaded and its server can't be reached:
    // the reader says so (after 2 s) with Retry.
    in property <bool> r-unreachable;
    callback r-retry-body();
    // A More menu command from where the focus is (as a click on More
    // and then the item: Show original gives the focus back there).
    public function more-command(c: int) {
        root.menu-pane = root.pane-of-focus();
        root.run-command(c, true);
    }
    // A command of the row menu or the More menu (`more`), by number (the
    // `CMD_*` constants in app/triage.rs).
    function run-command(c: int, more: bool) {
        if c == 10 { if more { root.reply(); } else { root.menu-respond(0); } }
        else if c == 11 { if more { root.reply-all(); } else { root.menu-respond(1); } }
        else if c == 12 { if more { root.forward(); } else { root.menu-respond(2); } }
        else if c == 13 { root.forward-attached(); }
        else if c == 14 { root.mark-read(true); }
        else if c == 15 { root.mark-read(false); }
        else if c == 16 { root.mark-flagged(true); }
        else if c == 17 { root.mark-flagged(false); }
        else if c == 18 { root.archive(); }
        else if c == 19 { root.delete(); }
        else if c == 20 { root.junk(true); }
        else if c == 21 { root.junk(false); }
        else if c == 22 { root.save-eml(); }
        else if c == 23 { root.original-from(more ? root.menu-pane : 1); }
        else if c == 24 { root.copy-message-id(); }
        else if c == 25 { root.show-in-folder(); }
        else if c == 26 { root.r-plain = !root.r-plain; }
        else if c == 27 { root.r-original = !root.r-original; root.r-show-original(root.r-original); }
        else if c == 28 { root.r-load-remote(false); }
        else if c == 29 { root.forget-remote(root.r-from-addr); }
        else if c == 30 { root.open-current-tab(); }
        else if c == 31 { root.open-window(); }
    }
    // Reply (0), Reply all (1), Forward (2).
    callback menu-respond(int);
    // Report junk (true) or Not junk (false).
    callback junk(bool);
    callback save-attachment(int);
    // Opens a copy in the app for its type (programs and scripts refused).
    callback open-attachment(int);
    // The open message as the server sent it: saved as a .eml file (Ctrl+S),
    // its header fields and source shown (Show original), its Message-ID copied,
    // or attached whole to a new message.
    callback save-eml();
    callback show-original();
    callback copy-message-id();
    callback forward-attached();
    // Show original: shown while `src-show` is set.
    in-out property <bool> src-show;
    in property <string> src-headers;
    in property <string> src-body;
    // `<id@host>`, or empty when the message has none.
    in property <string> src-msgid;

    // Composer
    in-out property <bool> composing;
    in property <string> c-title: @tr("New message");
    in property <[string]> c-from-options;
    in-out property <int> c-from-index;
    in-out property <string> c-to;
    in-out property <string> c-cc;
    in-out property <string> c-bcc;
    in-out property <string> c-subject;
    in-out property <string> c-body;
    // The draft is formatted (the painted editor, `Rich.body`) rather than
    // plain text (`c-body`).
    in-out property <bool> c-rich;
    in-out property <bool> c-show-cc;
    // The importance it is sent with (`Importance::code`: 0 normal, 1 high,
    // 2 low), set with the formatting bar's two toggles.
    in property <int> c-importance;
    callback c-set-importance(int);
    in property <[AttachmentRow]> c-attachments;
    // "Attachments 18.4 MB of 25 MB" (sent size), and its level: 0 fine,
    // 1 from 80%, 2 over the limit (Send is off).
    in property <string> c-attach-total;
    in property <int> c-attach-level;
    // A file is dragged over the window.
    in-out property <bool> file-hover;
    // Ctrl+V: attaches the files copied in Explorer, if any (false: the
    // field pastes text).
    callback c-paste-files() -> bool;
    // The send guards' question (empty: none); Send anyway goes ahead.
    in-out property <string> c-guard;
    callback c-send-anyway();
    // Inline address errors, and why Send is off (empty: it is on).
    in property <string> c-to-error;
    in property <string> c-cc-error;
    in property <string> c-bcc-error;
    in property <string> c-send-reason;
    // The field to focus, each time `c-focus-seq` changes (and when the
    // composer or the Cc/Bcc rows appear).
    in property <ComposeField> c-focus;
    in property <int> c-focus-seq;
    // Recipient suggestions for the address field being typed in (empty:
    // none shown), the highlighted one, taking one and closing them. A
    // taken suggestion puts the caret at byte `c-caret` of the `c-focus`
    // field, each time `c-caret-seq` changes.
    in property <[Suggestion]> c-suggestions;
    in-out property <int> c-suggest-index;
    callback c-suggest-accept(int);
    callback c-suggest-close();
    in property <int> c-caret;
    in property <int> c-caret-seq;
    callback compose();
    callback send();
    // Discard asks first when the draft has something written.
    callback discard();
    in-out property <bool> c-confirm-discard;
    callback discard-confirmed();
    callback attach();
    callback remove-attachment(int);
    // The fields are a view of the draft held by the controller: typing,
    // leaving a field and picking an account are reported back.
    callback c-edited(ComposeField, string);
    callback c-left(ComposeField);
    callback c-from-changed(int);
    // Show the Cc and Bcc rows and focus Cc or Bcc.
    callback c-reveal(ComposeField);
    // Esc: hide the composer, keeping the draft.
    callback c-close();
    // The formatting toolbar, on the body's selection (anchor, cursor):
    // markers, a link to an address, and Ctrl+Z of the last such edit
    // (`done` is false when there is none).
    callback c-format(FormatAction, int, int) -> BodyEdit;
    callback c-link(string, int, int) -> BodyEdit;
    callback c-unformat() -> BodyEdit;
    // "Draft saved 14:05" under the composer's title (empty: not saved).
    in property <string> c-saved;
    // A reply's or forward's quote, folded behind "Show quoted text".
    in property <bool> c-quote-folded;
    callback c-unfold-quote();
    // Preview: the HTML part as the recipient gets it, rendered off the UI
    // thread at the body's width (`c-preview-render(width, dark)`).
    in-out property <bool> c-preview;
    in property <image> c-preview-image;
    in property <length> c-preview-height;
    in property <length> c-preview-width;
    in property <color> c-preview-paper: white;
    in property <bool> c-preview-cut;
    in property <bool> c-preview-failed;
    // (width, dark, first): `first` when Preview just turned on (drawn at
    // once); a new width or theme is drawn once the resize settles.
    callback c-preview-render(length, bool, bool);
    // The one-time caption about the formatting marks (after the first
    // formatting edit ever).
    in-out property <bool> c-format-hint;

    // Outbox: the selected message, where its send is, and what can be done.
    in property <bool> o-show;
    in property <string> o-subject;
    in property <string> o-to;
    in property <string> o-status;
    in property <bool> o-problem;
    in property <bool> o-can-edit;
    in property <bool> o-can-retry;
    in property <bool> o-can-discard;
    // The server's reply as it came (behind Details), whether the failure
    // is one sending again can't fix (Edit is the accent, Retry subtle;
    // the reverse otherwise), and the first lines of the text.
    in property <string> o-detail;
    in property <bool> o-permanent;
    in property <string> o-body;
    callback o-edit();
    callback o-retry();
    callback o-discard();

    // A yes/no prompt (shown while `q-title` is set).
    in-out property <string> q-title;
    in property <string> q-text;
    in property <string> q-ok;
    // A certificate question: its details, the SHA-256 fingerprint (all of
    // it) and how to check it.
    in property <string> q-detail;
    in property <string> q-code;
    in property <string> q-code-label;
    in property <string> q-old;
    in property <string> q-old-label;
    in property <string> q-caution;
    in property <string> q-note;
    // A certificate prompt's choice of what to trust (empty: none).
    in property <[RadioItem]> q-choices;
    in-out property <int> q-choice;
    // A destructive question (a removal, a discard, a second send): both
    // buttons standard, Cancel focused and no Enter default; otherwise the
    // answer is the accent default button, focused, and Enter gives it.
    in property <bool> q-destructive;
    callback q-answer(bool);
    // A third answer, when set (an invitation's "Don't send a reply").
    in property <string> q-alt;
    callback q-alt-answer();

    // Settings
    in-out property <bool> show-settings;
    // The Contacts view, over the Mail tab's content (`app::contacts`).
    in-out property <bool> show-contacts;
    callback contacts-toggled(bool);
    // The Calendar page (src/app/calendar.rs), over the content card as
    // Settings is; its agenda lines and range, filled once it opens.
    in-out property <bool> show-calendar;
    in property <[AgendaLine]> cal-lines;
    in property <string> cal-range;
    in property <bool> cal-loaded;
    callback cal-opened();
    callback cal-today();
    callback cal-move(int);
    changed show-calendar => {
        if root.show-calendar {
            // One page at a time: Calendar closes Contacts.
            if root.show-contacts {
                root.show-contacts = false;
                root.contacts-toggled(false);
            }
            root.cal-opened();
        }
    }
    // A composer or another tab coming forward closes the page.
    changed composing => {
        if root.composing {
            root.show-calendar = false;
        }
    }
    // ---- the onboarding flow (docs/WINUI3.md "Onboarding";
    // src/app/onboarding.rs): open past the welcome (Your email, Sign in,
    // Make it yours, the finish), in Settings' content area when opened
    // from Add account, and the step shown (0 the welcome).
    in-out property <bool> ob-open;
    in-out property <bool> ob-embedded;
    in-out property <int> ob-step;
    // The address typed on the email step.
    in-out property <string> ob-email;
    // The page is there: the welcome (no account yet) or the flow.
    property <bool> ob-shown: !root.has-accounts || root.ob-open;
    property <bool> ob-full: root.ob-shown && !root.ob-embedded;
    in property <int> ob-chip;
    in property <string> ob-chip-host;
    in property <string> ob-domain;
    in-out property <int> ob-provider: -1;
    in-out property <bool> ob-manual;
    in property <bool> ob-offline;
    in-out property <int> ob-email-problem;
    in-out property <string> ob-name;
    in property <string> ob-address;
    in property <int> ob-sync;
    in property <float> ob-sync-value;
    in property <string> ob-sync-text;
    in property <bool> ob-newest;
    in-out property <int> ob-slow;
    // A failure's kind (0 other, 1 rejected password, 2 out of reach, 3
    // untrusted certificate): the flow's short title and sentence.
    in property <int> a-error-kind;
    callback onboard-continue(string, ServerFields);
    callback onboard-personalise(bool, string, string);
    callback onboard-open-inbox();
    // The flow closed (Back or Esc from the email step, Settings closed
    // under it): a lookup or check still running answers into nothing.
    callback onboard-closed();
    // Each change focuses the welcome's Add your email account.
    property <int> ob-refocus;
    // Add account (Settings), or the welcome's button: the email step.
    public function open-onboarding() {
        root.ob-embedded = root.has-accounts && root.show-settings;
        root.ob-manual = false;
        root.ob-provider = -1;
        root.ob-email-problem = 0;
        root.ob-email = "";
        root.ob-open = true;
        root.ob-step = 1;
    }
    function close-onboarding() {
        root.ob-open = false;
        root.ob-step = 0;
        root.onboard-closed();
        if !root.has-accounts {
            root.ob-refocus += 1;
        }
    }
    changed ob-step => {
        if root.ob-step >= 1 && !root.ob-open {
            root.open-onboarding();
        }
    }
    in property <[AccountRow]> accounts;
    in property <bool> a-busy;
    in-out property <string> a-error;
    // "Test connection": the success note, and the steps' states.
    in-out property <string> a-ok;
    in-out property <[int]> a-test;
    // The certificate lines of the account form (see SettingsPage).
    in property <string> a-cert-imap;
    in property <string> a-cert-smtp;
    in property <bool> a-pinned-imap;
    in property <bool> a-pinned-smtp;
    in property <int> a-review;
    in property <bool> a-reading;
    // "Find settings" (see SettingsPage).
    in property <bool> a-finding;
    in property <string> a-find-note;
    in property <ServerFields> a-found-from;
    in property <string> a-found-email;
    in property <ServerFields> a-found-to;
    in property <int> a-found-seq;
    // The account page: the edited account's place in `accounts` (-1:
    // none), whether its servers are a preset's, and a request to scroll
