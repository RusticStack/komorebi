    property <[NavItem]> pane-chrome: root.rail || root.pane-open
        ? (root.mail-shown
            ? [{ kind: 6, label: @tr("Folders"), icon: Icons.menu }, { kind: 7, label: @tr("Contacts"), icon: Icons.people }, { kind: 8, label: @tr("Calendar"), icon: Icons.calendar }, { kind: 5, label: @tr("Settings"), icon: Icons.settings }]
            : [{ kind: 6, label: @tr("Folders"), icon: Icons.menu }, { kind: 7, label: @tr("Contacts"), icon: Icons.people }, { kind: 5, label: @tr("Settings"), icon: Icons.settings }])
        : (root.mail-shown
            ? [{ kind: 7, label: @tr("Contacts"), icon: Icons.people }, { kind: 8, label: @tr("Calendar"), icon: Icons.calendar }, { kind: 5, label: @tr("Settings"), icon: Icons.settings }]
            : [{ kind: 7, label: @tr("Contacts"), icon: Icons.people }, { kind: 5, label: @tr("Settings"), icon: Icons.settings }]);
    property <int> chrome-focus;
    // New mail, from the pane or the rail.
    function new-mail-chosen() {
