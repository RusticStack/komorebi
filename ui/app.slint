    property <length> fold-extra: root.nav-collapsed ? 0 : Theme.pane-width - Theme.rail-width;
    property <bool> nav-anim;
    animate fold-extra { duration: root.nav-anim ? Theme.fast : 0ms; easing: ease-out; }
    // The pane toggle: the full pane and the rail from 1040 px, the pane
    // over the content below it.
    public function toggle-pane() {
        if !root.mail-shown {
            return;
        }
        if root.compact {
            root.pane-open = !root.pane-open;
            if root.pane-open {
                nav.focus();
            }
        } else {
