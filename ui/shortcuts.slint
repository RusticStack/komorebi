// The Keyboard shortcuts dialog's rows (F1, Ctrl+/, Settings > About), by
// group. Each row's keys are a key cell of the README "Keyboard" table,
// word for word, and every key cell there is a row here: the test
// tests/shortcuts_table.rs keeps the two the same. The actions are short;
// the README says the rest.
export struct ShortcutRow {
    // A group's heading row: `action` is its name, `keys` empty.
    heading: bool,
    keys: string,
    action: string,
}

export global Shortcuts {
    out property <[ShortcutRow]> rows: [
        { heading: true, action: @tr("shortcut group" => "Anywhere") },
        { keys: @tr("shortcut key" => "Ctrl+N"), action: @tr("shortcut" => "New mail") },
        { keys: @tr("shortcut key" => "Ctrl+E, F3 or Ctrl+F"), action: @tr("shortcut" => "Search") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+I"), action: @tr("shortcut" => "Go to the Inbox") },
        { keys: @tr("shortcut key" => "F5"), action: @tr("shortcut" => "Refresh") },
        { keys: @tr("shortcut key" => "Ctrl+,"), action: @tr("shortcut" => "Open or close Settings") },
        { keys: @tr("shortcut key" => "F1 or Ctrl+/"), action: @tr("shortcut" => "Keyboard shortcuts") },
        { keys: @tr("shortcut key" => "F6 / Shift+F6"), action: @tr("shortcut" => "Next / previous pane") },
        { keys: @tr("shortcut key" => "Tab / Shift+Tab"), action: @tr("shortcut" => "Next / previous control") },
        { keys: @tr("shortcut key" => "Space or Enter"), action: @tr("shortcut" => "Press the focused button") },
        { keys: @tr("shortcut key" => "Left / Right"), action: @tr("shortcut" => "Move along a toolbar") },
        { keys: @tr("shortcut key" => "Esc"), action: @tr("shortcut" => "Close the folder pane, clear the search or the selection") },

        { heading: true, action: @tr("shortcut group" => "Tabs and windows") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+E"), action: @tr("shortcut" => "Show / hide the folders") },
        { keys: @tr("shortcut key" => "Double-click, Shift+Enter"), action: @tr("shortcut" => "Open in new tab") },
        { keys: @tr("shortcut key" => "Middle-click"), action: @tr("shortcut" => "Open in a background tab; on a tab, close it") },
        { keys: @tr("shortcut key" => "Ctrl+O"), action: @tr("shortcut" => "Open in new window") },
        { keys: @tr("shortcut key" => "Ctrl+W or Ctrl+F4"), action: @tr("shortcut" => "Close the tab or message window") },
        { keys: @tr("shortcut key" => "Ctrl+Tab / Ctrl+Shift+Tab, Ctrl+PageDown / Ctrl+PageUp"), action: @tr("shortcut" => "Next / previous tab") },
        { keys: @tr("shortcut key" => "Ctrl+1 to Ctrl+8, Ctrl+9"), action: @tr("shortcut" => "Go to tab 1-8 / last tab") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+PageUp / Ctrl+Shift+PageDown"), action: @tr("shortcut" => "Move tab left / right") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+T"), action: @tr("shortcut" => "Reopen closed tab") },
        { keys: @tr("shortcut key" => "Esc (in a message window)"), action: @tr("shortcut" => "Close the window") },

        { heading: true, action: @tr("shortcut group" => "Folders") },
        { keys: @tr("shortcut key" => "Up / Down, Home / End, Enter or Space"), action: @tr("shortcut" => "Move through the folders and open one") },
        { keys: @tr("shortcut key" => "Shift+F10 or Menu"), action: @tr("shortcut" => "Folder menu") },

        { heading: true, action: @tr("shortcut group" => "Messages") },
        { keys: @tr("shortcut key" => "Up / Down"), action: @tr("shortcut" => "Previous / next message") },
        { keys: @tr("shortcut key" => "Home / End"), action: @tr("shortcut" => "First / last message") },
        { keys: @tr("shortcut key" => "PageUp / PageDown"), action: @tr("shortcut" => "Up / down a page") },
        { keys: @tr("shortcut key" => "Enter"), action: @tr("shortcut" => "Open the message") },
        { keys: @tr("shortcut key" => "Ctrl+click / Shift+click"), action: @tr("shortcut" => "Add to the selection / select a range") },
        { keys: @tr("shortcut key" => "Shift+Up / Shift+Down"), action: @tr("shortcut" => "Extend the selection") },
        { keys: @tr("shortcut key" => "Ctrl+A"), action: @tr("shortcut" => "Select all messages") },
        { keys: @tr("shortcut key" => "Ctrl+R / Ctrl+Shift+R"), action: @tr("shortcut" => "Reply / Reply all") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+F"), action: @tr("shortcut" => "Forward") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+V"), action: @tr("shortcut" => "Move to a folder") },
        { keys: @tr("shortcut key" => "Ctrl+Q / Ctrl+U"), action: @tr("shortcut" => "Mark as read / Mark as unread") },
        { keys: @tr("shortcut key" => "Insert or Ctrl+Shift+G"), action: @tr("shortcut" => "Mark as important / Remove importance") },
        { keys: @tr("shortcut key" => "Backspace"), action: @tr("shortcut" => "Archive") },
        { keys: @tr("shortcut key" => "Delete"), action: @tr("shortcut" => "Delete") },
        { keys: @tr("shortcut key" => "Shift+F10 or Menu"), action: @tr("shortcut" => "Message menu") },
        { keys: @tr("shortcut key" => "Ctrl+S"), action: @tr("shortcut" => "Save as a .eml file") },
        { keys: @tr("shortcut key" => "Ctrl+Z"), action: @tr("shortcut" => "Undo the last archive, delete, move or send") },

        { heading: true, action: @tr("shortcut group" => "Writing") },
        { keys: @tr("shortcut key" => "Ctrl+Enter or Alt+S"), action: @tr("shortcut" => "Send") },
        { keys: @tr("shortcut key" => "Esc"), action: @tr("shortcut" => "Close, keeping the draft") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+C / Ctrl+Shift+B"), action: @tr("shortcut" => "Show Cc / Bcc") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+A"), action: @tr("shortcut" => "Attach files") },
        { keys: @tr("shortcut key" => "Ctrl+V"), action: @tr("shortcut" => "Attach the files copied in File Explorer") },
        { keys: @tr("shortcut key" => "Up / Down, Enter or Tab, Esc"), action: @tr("shortcut" => "Pick, take or close a suggested address") },
        { keys: @tr("shortcut key" => "Enter (in the contact editor's Name box)"), action: @tr("shortcut" => "Save the contact") },

        // In a formatted message's body these come before the keys above
        // (Ctrl+U, Ctrl+E, Ctrl+R and Ctrl+Shift+V act on the text there).
        { heading: true, action: @tr("shortcut group" => "Formatting (message body)") },
        { keys: @tr("shortcut key" => "Ctrl+B / Ctrl+I / Ctrl+U"), action: @tr("shortcut" => "Bold / italic / underline") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+X"), action: @tr("shortcut" => "Strikethrough") },
        { keys: @tr("shortcut key" => "Ctrl+K"), action: @tr("shortcut" => "Link to an address") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+8 / Ctrl+Shift+7"), action: @tr("shortcut" => "Bulleted / numbered list") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+Q"), action: @tr("shortcut" => "Quote") },
        { keys: @tr("shortcut key" => "Ctrl+L / Ctrl+E / Ctrl+R / Ctrl+J"), action: @tr("shortcut" => "Align left / center / right / justify") },
        { keys: @tr("shortcut key" => "Ctrl+] / Ctrl+["), action: @tr("shortcut" => "Larger / smaller text") },
        { keys: @tr("shortcut key" => "Ctrl+M / Ctrl+Shift+M"), action: @tr("shortcut" => "Increase / decrease indent") },
        { keys: @tr("shortcut key" => "Tab / Shift+Tab (in a list or table)"), action: @tr("shortcut" => "List level, or the next / previous cell") },
        { keys: @tr("shortcut key" => "Ctrl+Space"), action: @tr("shortcut" => "Clear formatting") },
        { keys: @tr("shortcut key" => "Ctrl+Z / Ctrl+Y"), action: @tr("shortcut" => "Undo / redo") },
        { keys: @tr("shortcut key" => "Ctrl+Shift+V"), action: @tr("shortcut" => "Paste as plain text") },
    ];
}
