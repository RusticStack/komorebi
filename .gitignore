# Dependencies
node_modules/
.pnpm-store/

# Frontend build and cache outputs
dist/
build/
.vite/
.turbo/
.cache/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Rust and Tauri build outputs
target/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/permissions/autogenerated/
src-tauri/.cargo/

# Tauri bundle artifacts
src-tauri/target/release/bundle/
src-tauri/target/debug/bundle/

# Local runtime/user data and disposable databases
app-data/
user-data/
runtime-data/
.local-data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Allow committed fixture databases when tests intentionally need them
!fixtures/**/*.db
!fixtures/**/*.sqlite
!fixtures/**/*.sqlite3
!tests/fixtures/**/*.db
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!src-tauri/fixtures/**/*.db
!src-tauri/fixtures/**/*.sqlite
!src-tauri/fixtures/**/*.sqlite3

# Secrets, local config, logs, and diagnostics
.env
.env.*
!.env.example
*.log
*.local
*.pem
*.key
*.p12
*.pfx
diagnostics/

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
