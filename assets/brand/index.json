{
  "note": "Komorebi 1.0 brand assets for the GPUI app. Sources: assets/brand-src; generator: scripts/brand-assets.js; guide: docs/BRANDING.md.",
  "colours": {
    "seal": "#6A6A66",
    "seal_k": "#FFFFFF",
    "ink": "#171717",
    "ink_dark": "#F2F2F0",
    "fall": "#F1F1EE",
    "fall_dark": "#202020"
  },
  "svg": {
    "mark": {
      "file": "mark.svg",
      "fill": "seal + seal_k",
      "use": "The neutral seal as a picture (ink-3, white K), as the app icon. No accent colour; never in text."
    },
    "mark_mono": {
      "file": "mark-mono.svg",
      "fill": "currentColor",
      "use": "The ink mark (recoloured with the text colour): the title bar, welcome and the Sent notice."
    },
    "fall": {
      "file": "fall.svg",
      "fill": "currentColor",
      "use": "The large light shape on the welcome screen only, in the fall tone; never ink."
    },
    "wordmark": {
      "file": "wordmark.svg",
      "fill": "ink",
      "use": "The drawn wordmark on light grounds."
    },
    "wordmark_dark": {
      "file": "wordmark-dark.svg",
      "fill": "ink_dark",
      "use": "The drawn wordmark on dark grounds."
    },
    "logo": {
      "file": "logo.svg",
      "fill": "seal + seal_k + ink",
      "use": "Neutral seal and wordmark lockup on light grounds."
    },
    "logo_dark": {
      "file": "logo-dark.svg",
      "fill": "seal + seal_k + ink_dark",
      "use": "Neutral seal and wordmark lockup on dark grounds."
    }
  },
  "png": {
    "mark-18": {
      "w": 18,
      "h": 18,
      "x1": "png/mark-18.png",
      "x2": "png/mark-18@2x.png"
    },
    "mark-40": {
      "w": 40,
      "h": 40,
      "x1": "png/mark-40.png",
      "x2": "png/mark-40@2x.png"
    },
    "mark-72": {
      "w": 72,
      "h": 72,
      "x1": "png/mark-72.png",
      "x2": "png/mark-72@2x.png"
    },
    "wordmark-24": {
      "w": 114,
      "h": 24,
      "x1": "png/wordmark-24.png",
      "x2": "png/wordmark-24@2x.png"
    },
    "wordmark-dark-24": {
      "w": 114,
      "h": 24,
      "x1": "png/wordmark-dark-24.png",
      "x2": "png/wordmark-dark-24@2x.png"
    },
    "logo-40": {
      "w": 189,
      "h": 40,
      "x1": "png/logo-40.png",
      "x2": "png/logo-40@2x.png"
    },
    "logo-dark-40": {
      "w": 189,
      "h": 40,
      "x1": "png/logo-dark-40.png",
      "x2": "png/logo-dark-40@2x.png"
    },
    "fall-light": {
      "w": 325,
