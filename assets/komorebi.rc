// Windows resources for komorebi.exe (Komorebi 1.0), compiled by
// crates/komorebi-gpui/build.rs (embed-resource); docs/BRANDING.md.
// No #include: rc.exe finds <windows.h> only in a Visual Studio prompt, so
// the resource types are numeric. build.rs defines VER_MAJOR, VER_MINOR,
// VER_PATCH and VER_STRING from the Cargo package version.

// The first icon: the .exe's icon in Explorer, the window's, the taskbar's
// and the large image of a notification (src/win_shell.rs).
1 ICON "komorebi.ico"

// The notification area icons (src/win_shell.rs, TRAY_ICON_*): the seal in
// ink for a light taskbar, white for a dark one, and the same with the unread
// spot while unread mail waits (neutral; docs/BRANDING.md). Their presence is
// what switches the tray to the brand icons.
101 ICON "tray/tray-light.ico"
102 ICON "tray/tray-dark.ico"
103 ICON "tray/tray-unread-light.ico"
104 ICON "tray/tray-unread-dark.ico"

// RT_MANIFEST (24), id 1: the process manifest.
1 24 "komorebi.manifest"

1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The Komorebi Authors"
            VALUE "FileDescription", "Komorebi"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "komorebi"
            VALUE "LegalCopyright", "GPL-3.0-or-later, see LICENSE and NOTICE"
            VALUE "OriginalFilename", "komorebi.exe"
            VALUE "ProductName", "Komorebi"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
