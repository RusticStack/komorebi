{
  "name": "komorebi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "dev": "vite",
    "lint": "pnpm lint:frontend && pnpm lint:rust",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pnpm test:frontend && pnpm test:rust",
    "test:frontend": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "perf:backend": "cargo test --manifest-path src-tauri/Cargo.toml --test performance_benchmarks -- --ignored --nocapture",
    "perf:bundle": "node scripts/analyze-bundle-size.mjs",
    "perf:compat": "node scripts/windows-compatibility-report.mjs",
    "perf:mail-shell": "playwright test --config playwright.perf.config.ts",
    "perf:release-memory": "node scripts/measure-release-memory.mjs",
    "perf:all": "pnpm perf:bundle && pnpm perf:backend && pnpm perf:mail-shell && pnpm perf:compat",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.25",
    "@tauri-apps/api": "^2",
    "@tiptap/core": "3.23.6",
    "@tiptap/extension-color": "3.23.6",
    "@tiptap/extension-font-family": "3.23.6",
    "@tiptap/extension-highlight": "3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-table": "3.23.6",
    "@tiptap/extension-table-cell": "3.23.6",
    "@tiptap/extension-table-header": "3.23.6",
    "@tiptap/extension-table-row": "3.23.6",
    "@tiptap/extension-text-align": "3.23.6",
    "@tiptap/extension-text-style": "3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "dompurify": "^3.4.5",
    "i18next": "^26.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
}
